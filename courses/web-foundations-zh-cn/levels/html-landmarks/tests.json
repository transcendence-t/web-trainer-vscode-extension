[
  {
    "label": "页眉保留页面标题",
    "expect": {
      "type": "text",
      "selector": ".sheet > header h1",
      "value": "河畔夜跑"
    }
  },
  {
    "label": "页眉内的导航链接指向集合点",
    "expect": {
      "type": "text",
      "selector": ".sheet > header nav a[href=\"#meeting\"]",
      "value": "查看集合点"
    }
  },
  {
    "label": "页面有一个 main",
    "expect": {
      "type": "count",
      "selector": "main",
      "value": 1
    }
  },
  {
    "label": "正文里的集合点保留锚点",
    "expect": {
      "type": "text",
      "selector": ".sheet > header + main h2#meeting",
      "value": "集合点"
    }
  },
  {
    "label": "页脚紧随正文并保留维护者信息",
    "expect": {
      "type": "text",
      "selector": ".sheet > main + footer p",
      "value": "河畔跑团维护"
    }
  }
]
