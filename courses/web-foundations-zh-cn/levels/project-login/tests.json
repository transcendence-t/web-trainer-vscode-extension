[
  {
    "label": "密码字段使用带标签的密码控件",
    "expect": {
      "type": "exists",
      "selector": "#login-form:has(label[for=\"login-password\"]) input#login-password[type=\"password\" i]"
    }
  },
  {
    "label": "初始页面等待用户输入",
    "expect": {
      "type": "text",
      "selector": "#login-status",
      "value": "请输入演示账号和密码。"
    }
  },
  {
    "label": "直接提交空表单时提示填写",
    "expect": {
      "type": "text",
      "selector": "#login-status",
      "value": "请填写账号和密码。"
    },
    "actions": [
      {
        "type": "click",
        "selector": "#login-submit"
      }
    ]
  },
  {
    "label": "只填账号时提示填写密码",
    "expect": {
      "type": "text",
      "selector": "#login-status",
      "value": "请填写账号和密码。"
    },
    "actions": [
      {
        "type": "input",
        "selector": "#login-name",
        "value": "learner"
      },
      {
        "type": "input",
        "selector": "#login-password",
        "value": ""
      },
      {
        "type": "click",
        "selector": "#login-submit"
      }
    ]
  },
  {
    "label": "全空格账号按未填写处理",
    "expect": {
      "type": "text",
      "selector": "#login-status",
      "value": "请填写账号和密码。"
    },
    "actions": [
      {
        "type": "input",
        "selector": "#login-name",
        "value": "   "
      },
      {
        "type": "input",
        "selector": "#login-password",
        "value": "study123"
      },
      {
        "type": "click",
        "selector": "#login-submit"
      }
    ]
  },
  {
    "label": "账号正确但密码错误时拒绝登录",
    "expect": {
      "type": "text",
      "selector": "#login-status",
      "value": "账号或密码有误。"
    },
    "actions": [
      {
        "type": "input",
        "selector": "#login-name",
        "value": "learner"
      },
      {
        "type": "input",
        "selector": "#login-password",
        "value": "wrong123"
      },
      {
        "type": "click",
        "selector": "#login-submit"
      }
    ]
  },
  {
    "label": "密码正确但账号错误时拒绝登录",
    "expect": {
      "type": "text",
      "selector": "#login-status",
      "value": "账号或密码有误。"
    },
    "actions": [
      {
        "type": "input",
        "selector": "#login-name",
        "value": "visitor"
      },
      {
        "type": "input",
        "selector": "#login-password",
        "value": "study123"
      },
      {
        "type": "click",
        "selector": "#login-submit"
      }
    ]
  },
  {
    "label": "账号和密码都正确时成功",
    "expect": {
      "type": "text",
      "selector": "#login-status",
      "value": "登录成功。"
    },
    "actions": [
      {
        "type": "input",
        "selector": "#login-name",
        "value": "learner"
      },
      {
        "type": "input",
        "selector": "#login-password",
        "value": "study123"
      },
      {
        "type": "click",
        "selector": "#login-submit"
      }
    ]
  },
  {
    "label": "账号两侧的空格不影响匹配",
    "expect": {
      "type": "text",
      "selector": "#login-status",
      "value": "登录成功。"
    },
    "actions": [
      {
        "type": "input",
        "selector": "#login-name",
        "value": " learner "
      },
      {
        "type": "input",
        "selector": "#login-password",
        "value": "study123"
      },
      {
        "type": "click",
        "selector": "#login-submit"
      }
    ]
  },
  {
    "label": "密码按原样比较",
    "expect": {
      "type": "text",
      "selector": "#login-status",
      "value": "账号或密码有误。"
    },
    "actions": [
      {
        "type": "input",
        "selector": "#login-name",
        "value": "learner"
      },
      {
        "type": "input",
        "selector": "#login-password",
        "value": " study123"
      },
      {
        "type": "click",
        "selector": "#login-submit"
      }
    ]
  }
]
