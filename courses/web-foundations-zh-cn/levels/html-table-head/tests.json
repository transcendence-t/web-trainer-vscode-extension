[
  {
    "label": "表格内最前面有完整标题",
    "expect": {
      "type": "text",
      "selector": "table > caption:first-child",
      "value": "场地开放时间"
    }
  },
  {
    "label": "thead 有一行列标题",
    "expect": {
      "type": "count",
      "selector": "table > thead > tr",
      "value": 1
    }
  },
  {
    "label": "第一列标题是场地",
    "expect": {
      "type": "text",
      "selector": "thead > tr > th[scope=\"col\"]:nth-child(1)",
      "value": "场地"
    }
  },
  {
    "label": "第二列标题是开放时间",
    "expect": {
      "type": "text",
      "selector": "thead > tr > th[scope=\"col\"]:nth-child(2)",
      "value": "开放时间"
    }
  },
  {
    "label": "tbody 保留两条场地记录",
    "expect": {
      "type": "count",
      "selector": "table > tbody > tr",
      "value": 2
    }
  },
  {
    "label": "第一行表头是乒乓球室",
    "expect": {
      "type": "text",
      "selector": "tbody > tr:first-child > th[scope=\"row\"]:first-child",
      "value": "乒乓球室"
    }
  },
  {
    "label": "乒乓球室时间保留在数据单元格",
    "expect": {
      "type": "text",
      "selector": "tbody > tr:first-child > td:nth-child(2)",
      "value": "09:00–12:00"
    }
  },
  {
    "label": "第二行表头是书画室",
    "expect": {
      "type": "text",
      "selector": "tbody > tr:last-child > th[scope=\"row\"]:first-child",
      "value": "书画室"
    }
  },
  {
    "label": "书画室时间保留在数据单元格",
    "expect": {
      "type": "text",
      "selector": "tbody > tr:last-child > td:nth-child(2)",
      "value": "13:30–17:00"
    }
  }
]
