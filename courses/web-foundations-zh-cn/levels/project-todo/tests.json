[
  {
    "label": "已有的展示准备项可以看到",
    "expect": {
      "type": "text",
      "selector": "#task-list > li:nth-child(1) .task-title",
      "value": "核对展示顺序"
    }
  },
  {
    "label": "添加后只保留标题本身",
    "expect": {
      "type": "text",
      "selector": "#task-list > li:nth-child(2) .task-title",
      "value": "准备示意图"
    },
    "actions": [
      {
        "type": "input",
        "selector": "#task-input",
        "value": "　 准备示意图  "
      },
      {
        "type": "click",
        "selector": "#add-task"
      }
    ]
  },
  {
    "label": "添加成功后输入框已清空",
    "expect": {
      "type": "exists",
      "selector": "#task-input:placeholder-shown"
    },
    "actions": [
      {
        "type": "input",
        "selector": "#task-input",
        "value": "准备示意图"
      },
      {
        "type": "click",
        "selector": "#add-task"
      }
    ]
  },
  {
    "label": "全是空白的条目无法加入",
    "expect": {
      "type": "count",
      "selector": "#task-list > li",
      "value": 1
    },
    "actions": [
      {
        "type": "input",
        "selector": "#task-input",
        "value": "　   "
      },
      {
        "type": "click",
        "selector": "#add-task"
      }
    ]
  },
  {
    "label": "输入中的标签符号按文字显示",
