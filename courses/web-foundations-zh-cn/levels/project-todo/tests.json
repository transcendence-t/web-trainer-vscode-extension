        "value": "<b>演示</b>"
      },
      {
        "type": "click",
        "selector": "#add-task"
      }
    ]
  },
  {
    "label": "三条中只标记中间一条的标题",
    "expect": {
      "type": "style",
      "selector": "#task-list > li:nth-child(2) .task-title",
