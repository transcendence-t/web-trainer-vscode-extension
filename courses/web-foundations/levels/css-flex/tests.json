[
  {
    "label": "toolbar uses Flexbox",
    "expect": {
      "type": "style",
      "selector": ".toolbar",
      "property": "display",
      "value": "flex"
    }
  },
  {
    "label": "items are arranged horizontally",
    "expect": {
      "type": "style",
      "selector": ".toolbar",
      "property": "flex-direction",
      "value": "row"
    }
  },
  {
    "label": "Item spacing is 12px",
    "expect": {
      "type": "style",
      "selector": ".toolbar",
      "property": "column-gap",
      "value": "12px"
    }
  },
  {
    "label": "Center alignment of items with different heights",
    "expect": {
      "type": "style",
      "selector": ".toolbar",
      "property": "align-items",
      "value": "center"
    }
  }
]
