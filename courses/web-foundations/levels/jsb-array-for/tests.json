[
  {
    "label": "Periods with records and zero records are accumulated together",
    "expect": {
      "type": "function",
      "name": "totalCheckouts",
      "args": [
        [
          4,
          0,
          7
        ]
      ],
      "value": 11
    }
  },
  {
    "label": "Returns the value of this period when only one period is recorded.",
    "expect": {
      "type": "function",
      "name": "totalCheckouts",
      "args": [
        [
          13
        ]
      ],
      "value": 13
    }
  },
  {
    "label": "The total amount of empty arrays is 0",
    "expect": {
      "type": "function",
      "name": "totalCheckouts",
      "args": [
        []
      ],
      "value": 0
    }
  },
  {
    "label": "The same loan amount is still included in the total separately",
    "expect": {
      "type": "function",
      "name": "totalCheckouts",
      "args": [
        [
          2,
          2,
          4
        ]
      ],
      "value": 8
    }
  }
]
