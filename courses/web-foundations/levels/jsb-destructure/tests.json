[
  {
    "label": "field name mapping",
    "expect": {
      "type": "function",
      "name": "tagFields",
      "args": [
        {
          "name": "network board",
          "count": 3
        }
      ],
      "value": {
        "title": "network board",
        "quantity": 3
      }
    }
  },
  {
    "label": "missing quantity use 1",
    "expect": {
      "type": "function",
      "name": "tagFields",
      "args": [
        {
          "name": "panel"
        }
      ],
      "value": {
        "title": "panel",
        "quantity": 1
      }
    }
  },
  {
    "label": "Explicit zero remains zero",
    "expect": {
      "type": "function",
      "name": "tagFields",
      "args": [
        {
          "name": "base plate",
          "count": 0
        }
      ],
      "value": {
        "title": "base plate",
        "quantity": 0
      }
    }
  },
  {
    "label": "Explicit null value does not trigger destructuring of default value",
    "expect": {
      "type": "function",
      "name": "tagFields",
      "args": [
        {
          "name": "base plate",
          "count": null
        }
      ],
      "value": {
        "title": "base plate",
        "quantity": null
      }
    }
  }
]
