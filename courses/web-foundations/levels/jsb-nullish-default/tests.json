[
  {
    "label": "Zero remaining digits must be reserved",
    "expect": {
      "type": "function",
      "name": "availableSeats",
      "args": [
        0,
        20
      ],
      "value": 0
    }
  },
  {
    "label": "Number of null value usage plans",
    "expect": {
      "type": "function",
      "name": "availableSeats",
      "args": [
        null,
        18
      ],
      "value": 18
    }
  },
  {
    "label": "The number of records has priority",
    "expect": {
      "type": "function",
      "name": "availableSeats",
      "args": [
        6,
        18
      ],
      "value": 6
    }
  },
  {
    "label": "can return null when neither item is recorded",
    "expect": {
      "type": "function",
      "name": "availableSeats",
      "args": [
        null,
        null
      ],
      "value": null
    }
  }
]
