[
  {
    "label": "end button absorbs 88px remaining space",
    "expect": {
      "type": "style",
      "selector": ".export",
      "property": "margin-left",
      "value": "88px"
    }
  },
  {
    "label": "The second one is still following the first one",
    "expect": {
      "type": "style",
      "selector": ".toolbar button:nth-child(2)",
      "property": "margin-left",
      "value": "0px"
    }
  },
  {
    "label": "Three buttons are still in one row",
    "expect": {
      "type": "layout",
      "selector": ".export",
      "relativeTo": ".toolbar button:first-child",
      "relation": "same-row"
    }
  },
  {
    "label": "The end button is still in the toolbar",
    "expect": {
      "type": "layout",
      "selector": ".export",
      "relativeTo": ".toolbar",
      "relation": "inside"
    }
  }
]
