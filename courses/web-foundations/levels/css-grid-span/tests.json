[
  {
    "label": "Announcement width is the same as the grid",
    "expect": {
      "type": "layout",
      "selector": ".route-notice",
      "relativeTo": ".route-board",
      "relation": "equal-width"
    }
  },
  {
    "label": "The banner announcement is still inside the grid",
    "expect": {
      "type": "layout",
      "selector": ".route-notice",
      "relativeTo": ".route-board",
      "relation": "inside"
    }
  },
  {
    "label": "route schedule is located below the announcement",
    "expect": {
      "type": "layout",
      "selector": ".route-map",
      "relativeTo": ".route-notice",
      "relation": "below"
    }
  },
  {
    "label": "Equipment list and route arrangement side by side and to the right",
    "expect": {
      "type": "layout",
      "selector": ".gear-list",
      "relativeTo": ".route-map",
      "relation": "right-of"
    }
  }
]
