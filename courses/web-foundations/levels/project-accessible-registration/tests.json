[
  {
    "label": "All three items have explicit accessible names",
    "expect": {
      "type": "count",
      "selector": "label[for=\"name\"], label[for=\"email\"], label[for=\"course\"]",
      "value": 3
    }
  },
  {
    "label": "feedback area is status message",
    "expect": {
      "type": "attribute",
      "selector": "#reply",
      "name": "role",
      "value": "status"
    }
  },
  {
    "label": "Not submitted when there are missing sessions",
    "expect": {
      "type": "text",
      "selector": "#reply",
      "value": "has not registered yet"
    },
    "actions": [
      {
        "type": "input",
        "selector": "#name",
        "value": "Xiao Liu"
      },
      {
        "type": "input",
        "selector": "#email",
        "value": "liu@example.org"
      },
      {
        "type": "input",
        "selector": "#course",
        "value": ""
      },
      {
        "type": "click",
        "selector": "#registration button"
      }
    ]
  },
  {
    "label": "Invalid email address rejects registration",
    "expect": {
      "type": "text",
      "selector": "#reply",
      "value": "has not registered yet"
    },
    "actions": [
      {
        "type": "input",
        "selector": "#name",
        "value": "Xiao Liu"
      },
      {
        "type": "input",
        "selector": "#email",
        "value": "bad"
      },
      {
        "type": "input",
        "selector": "#course",
        "value": "Morning session"
      },
      {
        "type": "click",
        "selector": "#registration button"
      }
    ]
  },
  {
    "label": "Register normally and get the show receipt",
    "expect": {
      "type": "text",
      "selector": "#reply",
      "value": "Xiao Liu, registered for: Afternoon session"
    },
    "actions": [
      {
        "type": "input",
        "selector": "#name",
        "value": " Xiao Liu "
      },
      {
        "type": "input",
        "selector": "#email",
        "value": "liu@example.org"
      },
      {
        "type": "input",
        "selector": "#course",
        "value": "Afternoon session"
      },
      {
        "type": "click",
        "selector": "#registration button"
      }
    ]
  },
  {
    "label": "Reject names containing only spaces",
    "expect": {
      "type": "text",
      "selector": "#reply",
      "value": "Please enter a valid name"
    },
    "actions": [
      {
        "type": "input",
        "selector": "#name",
        "value": "   "
      },
      {
        "type": "input",
        "selector": "#email",
        "value": "liu@example.org"
      },
      {
        "type": "input",
        "selector": "#course",
        "value": "Morning session"
      },
      {
        "type": "click",
        "selector": "#registration button"
      }
    ]
  }
]
