[
  {
    "label": "Direct preview uses twice the default points",
    "expect": {
      "type": "function",
      "name": "applyScore",
      "args": [
        4
      ],
      "value": 8
    }
  },
  {
    "label": "The result of the default rule also remains non-negative",
    "expect": {
      "type": "function",
      "name": "applyScore",
      "args": [
        -2
      ],
      "value": 0
    }
  },
  {
    "label": "supports integration rules double",
    "expect": {
      "type": "function",
      "name": "scoreFor",
      "args": [
        4,
        "double"
      ],
      "value": 8
    }
  },
  {
    "label": "supports points rule bonus",
    "expect": {
      "type": "function",
      "name": "scoreFor",
      "args": [
        4,
        "bonus"
      ],
      "value": 7
    }
  },
  {
    "label": "supports penalty rules",
    "expect": {
      "type": "function",
      "name": "scoreFor",
      "args": [
        2,
        "penalty"
      ],
      "value": 0
    }
  }
