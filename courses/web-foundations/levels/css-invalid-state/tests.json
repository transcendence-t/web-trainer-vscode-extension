[
  {
    "label": "Empty required email addresses display a warning color",
    "expect": {
      "type": "style",
      "selector": "#contact",
      "property": "border-top-color",
      "value": "rgb(124, 70, 14)"
    }
  },
  {
    "label": "Error format still displays warning color",
    "expect": {
      "type": "style",
      "selector": "#contact",
      "property": "border-top-color",
      "value": "rgb(124, 70, 14)"
    },
    "actions": [
      {
        "type": "input",
        "selector": "#contact",
        "value": "bad-address"
      }
    ]
  },
  {
    "label": "Restore the original frame after entering a valid email address",
    "expect": {
      "type": "style",
      "selector": "#contact",
      "property": "border-top-color",
      "value": "rgb(154, 169, 181)"
    },
    "actions": [
      {
        "type": "input",
        "selector": "#contact",
        "value": "service@example.org"
      }
    ]
  }
]
