[
  {
    "label": "reads valid JSON of 200",
    "expect": {
      "type": "function",
      "name": "makeResponseMessage",
      "args": [
        200,
        "{\"message\":\"record updated\"}"
      ],
      "value": "record updated"
    }
  },
  {
    "label": "Other 2xx success status is also read",
    "expect": {
      "type": "function",
      "name": "makeResponseMessage",
      "args": [
        201,
        "{\"message\":\"added\"}"
      ],
      "value": "added"
    }
  },
  {
    "label": "404 No need to read non-JSON text",
    "expect": {
      "type": "function",
      "name": "makeResponseMessage",
      "args": [
        404,
        "missing"
      ],
      "value": "Reading failed: 404"
    }
  },
  {
    "label": "503 status code is displayed even if the text is legal",
    "expect": {
      "type": "function",
      "name": "makeResponseMessage",
      "args": [
        503,
        "{\"message\":\"Try again later\"}"
      ],
      "value": "Reading failed: 503"
    }
  }
]
