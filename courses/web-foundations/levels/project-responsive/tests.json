[
  {
    "label": "The text has an independent page title",
    "expect": {
      "type": "text",
      "selector": ".sheet > main.reading-content > h1",
      "value": "Community Used Book Exchange Day"
    }
  },
  {
    "label": "In-page navigation with name in header",
    "expect": {
      "type": "exists",
      "selector": ".sheet > header.site-header > nav.site-nav[aria-label=\"In-page navigation\"]"
    }
  },
  {
    "label": "The two parts of the text use section in sequence.",
    "expect": {
      "type": "exists",
      "selector": ".sheet > main .details > section#schedule + section#visit"
    }
  },
  {
    "label": "Footer retains organizer information",
    "expect": {
      "type": "text",
      "selector": ".sheet > footer.site-footer",
      "value": "Riverside Community Book Corner Organization"
    }
  },
  {
    "label": "The event arrangement link indeed locates the corresponding content",
    "expect": {
      "type": "exists",
      "selector": "section#schedule:target"
    },
    "actions": [
      {
        "type": "click",
        "selector": "nav a[href=\"#schedule\"]"
      }
    ]
  },
  {
    "label": "The arrival method link indeed locates the corresponding content",
    "expect": {
      "type": "exists",
      "selector": "section#visit:target"
    },
    "actions": [
      {
        "type": "click",
        "selector": "nav a[href=\"#visit\"]"
      }
    ]
  },
  {
    "label": "Navigation below site name when 320px",
    "expect": {
      "type": "layout",
      "selector": ".site-nav",
      "relativeTo": ".site-name",
      "relation": "below"
    },
    "viewport": 320
  },
  {
    "label": "320px How to arrive is below the event schedule",
    "expect": {
      "type": "layout",
      "selector": "#visit",
      "relativeTo": "#schedule",
      "relation": "below"
    },
    "viewport": 320
  },
  {
    "label": "is 679px, the text is still arranged up and down.",
    "expect": {
      "type": "layout",
      "selector": "#visit",
      "relativeTo": "#schedule",
      "relation": "below"
    },
    "viewport": 679
  },
  {
    "label": "680px When the scene mode switches to the right column",
    "expect": {
      "type": "layout",
      "selector": "#visit",
      "relativeTo": "#schedule",
      "relation": "right-of"
    },
    "viewport": 680
  },
  {
    "label": "is 980px, the two cards are still side by side.",
    "expect": {
      "type": "layout",
      "selector": "#visit",
      "relativeTo": "#schedule",
      "relation": "right-of"
    },
    "viewport": 980
  },
  {
    "label": "is 980px, the two columns of the text are the same width.",
    "expect": {
      "type": "layout",
      "selector": "#visit",
      "relativeTo": "#schedule",
      "relation": "equal-width"
    },
    "viewport": 980
  },
  {
    "label": "is 980px, the navigation is located to the right of the site name.",
    "expect": {
      "type": "layout",
      "selector": ".site-nav",
      "relativeTo": ".site-name",
      "relation": "right-of"
    },
    "viewport": 980
  }
]
