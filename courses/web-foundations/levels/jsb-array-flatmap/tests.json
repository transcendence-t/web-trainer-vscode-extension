[
  {
    "label": "Classroom and internal order are retained",
    "expect": {
      "type": "function",
      "name": "participantNames",
      "args": [
        [
          {
            "names": [
              "Xiaofang",
              "Xiao Chen"
            ]
          },
          {
            "names": [
              "Xiao Zhou"
            ]
          }
        ]
      ],
      "value": [
        "Xiaofang",
        "Xiao Chen",
        "Xiao Zhou"
      ]
    }
  },
  {
    "label": "Empty classroom does not occupy a space",
    "expect": {
      "type": "function",
      "name": "participantNames",
      "args": [
        [
          {
            "names": []
          },
          {
            "names": [
              "Yang",
              "Yang"
            ]
          }
        ]
      ],
      "value": [
        "Yang",
        "Yang"
      ]
    }
  },
  {
    "label": "returns an empty list when there is no classroom",
    "expect": {
      "type": "function",
      "name": "participantNames",
      "args": [
        []
      ],
      "value": []
    }
  }
]
