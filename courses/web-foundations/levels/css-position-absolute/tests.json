[
  {
    "label": "card provides positioning reference",
    "expect": {
      "type": "style",
      "selector": ".branch-card",
      "property": "position",
      "value": "relative"
    }
  },
  {
    "label": "corner mark uses absolute positioning",
    "expect": {
      "type": "style",
      "selector": ".branch-badge",
      "property": "position",
      "value": "absolute"
    }
  },
  {
    "label": "corner gauge top 10px",
    "expect": {
      "type": "style",
      "selector": ".branch-badge",
      "property": "top",
      "value": "10px"
    }
  },
  {
    "label": "corner gauge right 12px",
    "expect": {
      "type": "style",
      "selector": ".branch-badge",
      "property": "right",
      "value": "12px"
    }
  },
  {
    "label": "The corner mark actually falls on the branch library card",
    "expect": {
      "type": "layout",
      "selector": ".branch-badge",
      "relativeTo": ".branch-card",
      "relation": "inside"
    }
  }
]
