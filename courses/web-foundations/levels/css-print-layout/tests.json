[
  {
    "label": "Hide navigation when printing",
    "expect": {
      "type": "style",
      "selector": ".site-nav",
      "property": "display",
      "value": "none",
      "media": {
        "query": "print",
        "matches": true
      }
    }
  },
  {
    "label": "Use white background for printing content",
    "expect": {
      "type": "style",
      "selector": ".paper",
      "property": "background-color",
      "value": "rgb(255, 255, 255)",
      "media": {
        "query": "print",
        "matches": true
      }
    }
  },
  {
    "label": "screen still displays navigation",
    "expect": {
      "type": "style",
      "selector": ".site-nav",
      "property": "display",
      "value": "block",
      "media": {
        "query": "print",
        "matches": false
      }
    }
  },
  {
    "label": "screen still has a light green background",
    "expect": {
      "type": "style",
      "selector": ".paper",
      "property": "background-color",
      "value": "rgb(230, 244, 238)",
      "media": {
        "query": "print",
        "matches": false
      }
    }
  }
]
