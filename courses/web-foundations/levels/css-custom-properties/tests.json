[
  {
    "label": "Registered card has local theme variable",
    "expect": {
      "type": "style",
      "selector": ".registered",
      "property": "--ticket-color",
      "value": "#125a46"
    }
  },
  {
    "label": "Text following variable of registered card",
    "expect": {
      "type": "style",
      "selector": ".registered",
      "property": "color",
      "value": "rgb(18, 90, 70)"
    }
  },
  {
    "label": "Registered card border following variable",
    "expect": {
      "type": "style",
      "selector": ".registered",
      "property": "border-top-color",
      "value": "rgb(18, 90, 70)"
    }
  },
  {
    "label": "The card to be verified uses the default color",
    "expect": {
      "type": "style",
      "selector": ".waiting",
      "property": "border-top-color",
      "value": "rgb(36, 52, 71)"
    }
  }
]
