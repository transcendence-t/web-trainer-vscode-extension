[
  {
    "label": "charges per page printing fee and one-time binding fee",
    "expect": {
      "type": "function",
      "name": "printCost",
      "args": [
        20,
        15,
        100
      ],
      "value": 400
    }
  },
  {
    "label": "Only printing fee is charged when binding fee is waived",
    "expect": {
      "type": "function",
      "name": "printCost",
      "args": [
        12,
        10,
        0
      ],
      "value": 120
    }
  },
  {
    "label": "Only fixed binding fee is charged when printing is free",
    "expect": {
      "type": "function",
      "name": "printCost",
      "args": [
        0,
        6,
        20
      ],
      "value": 20
    }
  },
  {
    "label": "When printing a page, the two charges are added directly.",
    "expect": {
      "type": "function",
      "name": "printCost",
      "args": [
        15,
        1,
        50
      ],
      "value": 65
    }
  }
]
