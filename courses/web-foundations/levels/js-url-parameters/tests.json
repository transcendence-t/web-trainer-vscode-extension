[
  {
    "label": "Decode spaces and read duplicate keys",
    "expect": {
      "type": "function",
      "name": "readFilters",
      "args": [
        "?q=wood+craft&tag=lab&tag=weekend"
      ],
      "value": {
        "q": "wood craft",
        "tags": [
          "lab",
          "weekend"
        ]
      }
    }
  },
  {
    "label": "Decodes escaped spaces while preserving the hyphen in a tag",
    "expect": {
      "type": "function",
      "name": "readFilters",
      "args": [
        "tag=A-1&q=Wood%20working"
      ],
      "value": {
        "q": "Wood working",
        "tags": [
          "A-1"
        ]
      }
    }
  },
  {
    "label": "Missing keywords",
    "expect": {
      "type": "function",
      "name": "readFilters",
      "args": [
        "tag=lab"
      ],
      "value": {
        "q": "",
        "tags": [
          "lab"
        ]
      }
    }
  },
  {
    "label": "empty string",
    "expect": {
      "type": "function",
      "name": "readFilters",
      "args": [
        ""
      ],
      "value": {
        "q": "",
        "tags": []
      }
    }
  }
]
