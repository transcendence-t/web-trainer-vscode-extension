[
  {
    "label": "初始状态提示先填写标题",
    "expect": {
      "type": "text",
      "selector": "#submission-feedback",
      "value": "填写标题后提交检查。"
    }
  },
  {
    "label": "空输入有专门的提示",
    "expect": {
      "type": "text",
      "selector": "#submission-feedback",
      "value": "请填写作品标题。"
    },
    "actions": [
      {
        "type": "click",
        "selector": "#submission-form button"
      }
    ]
  },
  {
    "label": "全是空白也视为空标题",
    "expect": {
      "type": "text",
      "selector": "#submission-feedback",
      "value": "请填写作品标题。"
    },
    "actions": [
      {
        "type": "input",
        "selector": "#work-title",
        "value": "　   "
      },
      {
        "type": "click",
        "selector": "#submission-form button"
      }
    ]
  },
  {
    "label": "两个字符的标题提示长度不足",
    "expect": {
      "type": "text",
      "selector": "#submission-feedback",
      "value": "标题至少需要 3 个字符。"
    },
    "actions": [
      {
        "type": "input",
        "selector": "#work-title",
        "value": "短片"
      },
      {
        "type": "click",
        "selector": "#submission-form button"
      }
    ]
  },
  {
    "label": "刚好三个字符的标题通过检查",
    "expect": {
      "type": "text",
      "selector": "#submission-feedback",
      "value": "作品标题《远山集》已通过检查。"
    },
    "actions": [
      {
        "type": "input",
        "selector": "#work-title",
        "value": "远山集"
      },
      {
        "type": "click",
        "selector": "#submission-form button"
      }
    ]
  },
  {
    "label": "修正标题后可重新提交并去掉首尾空白",
    "expect": {
      "type": "text",
      "selector": "#submission-feedback",
      "value": "作品标题《秋日短片》已通过检查。"
    },
    "actions": [
      {
        "type": "input",
        "selector": "#work-title",
        "value": "短片"
      },
      {
        "type": "click",
        "selector": "#submission-form button"
      },
      {
        "type": "input",
        "selector": "#work-title",
        "value": "  秋日短片  "
      },
      {
        "type": "click",
        "selector": "#submission-form button"
      }
    ]
  }
]
