[
  {
    "label": "The initial state prompts you to fill in the title first",
    "expect": {
      "type": "text",
      "selector": "#submission-feedback",
      "value": "Fill in the title and submit for inspection."
    }
  },
  {
    "label": "There is a special prompt for empty input",
    "expect": {
      "type": "text",
      "selector": "#submission-feedback",
      "value": "Please fill in the title of the work."
    },
    "actions": [
      {
        "type": "click",
        "selector": "#submission-form button"
      }
    ]
  },
  {
    "label": "is also regarded as an empty title if it is completely blank.",
    "expect": {
      "type": "text",
      "selector": "#submission-feedback",
      "value": "Please fill in the title of the work."
    },
    "actions": [
      {
        "type": "input",
        "selector": "#work-title",
        "value": "　   "
      },
      {
        "type": "click",
        "selector": "#submission-form button"
      }
    ]
  },
  {
    "label": "The two-character title prompt is not long enough",
    "expect": {
      "type": "text",
      "selector": "#submission-feedback",
      "value": "Title requires at least 3 characters."
    },
    "actions": [
      {
        "type": "input",
        "selector": "#work-title",
        "value": "Up"
      },
      {
        "type": "click",
        "selector": "#submission-form button"
      }
    ]
  },
  {
    "label": "The title with exactly three characters passed the check",
    "expect": {
      "type": "text",
      "selector": "#submission-feedback",
      "value": "The title of the work \"Sky\" has passed the inspection."
    },
    "actions": [
      {
        "type": "input",
        "selector": "#work-title",
        "value": "Sky"
      },
      {
        "type": "click",
        "selector": "#submission-form button"
      }
    ]
  },
  {
    "label": "You can resubmit after correcting the title and removing the leading and trailing blanks.",
    "expect": {
      "type": "text",
      "selector": "#submission-feedback",
      "value": "The title of the work \"Autumn Short Film\" has passed the inspection."
    },
    "actions": [
      {
        "type": "input",
        "selector": "#work-title",
        "value": "Up"
      },
      {
        "type": "click",
        "selector": "#submission-form button"
      },
      {
        "type": "input",
        "selector": "#work-title",
        "value": "  Autumn Short Film  "
      },
      {
        "type": "click",
        "selector": "#submission-form button"
      }
    ]
  }
]
