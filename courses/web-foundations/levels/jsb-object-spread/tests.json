[
  {
    "label": "Overrides with a value of zero also take effect",
    "expect": {
      "type": "function",
      "name": "mergeSettings",
      "args": [
        {
          "mode": "list",
          "count": 10
        },
        {
          "count": 0
        }
      ],
      "value": {
        "mode": "list",
        "count": 0
      }
    }
  },
  {
    "label": "Custom key adds new object",
    "expect": {
      "type": "function",
      "name": "mergeSettings",
      "args": [
        {
          "enabled": true
        },
        {
          "enabled": false,
          "accent": "jade"
        }
      ],
      "value": {
        "enabled": false,
        "accent": "jade"
      }
    }
  },
  {
    "label": "allows either side to be empty",
    "expect": {
      "type": "function",
      "name": "mergeSettings",
      "args": [
        {},
        {
          "count": 2
        }
      ],
      "value": {
        "count": 2
      }
    }
  },
  {
    "label": "The default configuration has not changed after the merger.",
    "expect": {
      "type": "function",
      "name": "checkSettings",
      "args": [
        {
          "mode": "list"
        },
        {
          "mode": "grid"
        }
      ],
      "value": {
        "defaults": {
          "mode": "list"
        },
        "merged": {
          "mode": "grid"
        }
      }
    }
  }
]
