[
  {
    "label": "still uses embedded decorative images",
    "expect": {
      "type": "style",
      "selector": ".map-card",
      "property": "background-image",
      "value": "url(\"data:image/png;base64,\")"
    }
  },
  {
    "label": "background image is only displayed once",
    "expect": {
      "type": "style",
      "selector": ".map-card",
      "property": "background-repeat",
      "value": "no-repeat"
    }
  },
  {
    "label": "picture is in the lower right corner",
    "expect": {
      "type": "style",
      "selector": ".map-card",
      "property": "background-position",
      "value": "100% 100%"
    }
  },
  {
    "label": "background image maintains proportion and limits width",
    "expect": {
      "type": "style",
      "selector": ".map-card",
      "property": "background-size",
      "value": "96px auto"
    }
  }
]
