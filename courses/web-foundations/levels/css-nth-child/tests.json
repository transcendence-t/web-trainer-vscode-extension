[
  {
    "label": "Use background color in the second row",
    "expect": {
      "type": "style",
      "selector": "tbody tr:nth-child(2)",
      "property": "background-color",
      "value": "rgb(230, 244, 238)"
    }
  },
  {
    "label": "The fourth row also uses the background color",
    "expect": {
      "type": "style",
      "selector": "tbody tr:nth-child(4)",
      "property": "background-color",
      "value": "rgb(230, 244, 238)"
    }
  },
  {
    "label": "The first line remains transparent",
    "expect": {
      "type": "style",
      "selector": "tbody tr:first-child",
      "property": "background-color",
      "value": "rgba(0, 0, 0, 0)"
    }
  },
  {
    "label": "The background color of the meter head is not affected",
    "expect": {
      "type": "style",
      "selector": "thead",
      "property": "background-color",
      "value": "rgb(225, 231, 237)"
    }
  }
]
