[
  {
    "label": "The unfocused subject frame retains its original outline",
    "expect": {
      "type": "style",
      "selector": "#topic-filter:not(:focus)",
      "property": "outline-style",
      "value": "none"
    }
  },
  {
    "label": "The theme box displays a solid outline after focusing",
    "expect": {
      "type": "style",
      "selector": "#topic-filter:focus",
      "property": "outline-style",
      "value": "solid"
    },
    "actions": [
      {
        "type": "focus",
        "selector": "#topic-filter"
      }
    ]
  },
  {
    "label": "The focus outline of the theme box is green",
    "expect": {
      "type": "style",
      "selector": "#topic-filter:focus",
      "property": "outline-color",
      "value": "rgb(18, 90, 70)"
    },
    "actions": [
      {
        "type": "focus",
        "selector": "#topic-filter"
      }
    ]
  },
  {
    "label": "The outline of the theme box is offset outward by 4px",
    "expect": {
      "type": "style",
      "selector": "#topic-filter:focus",
      "property": "outline-offset",
      "value": "4px"
    },
    "actions": [
      {
        "type": "focus",
        "selector": "#topic-filter"
      }
    ]
  },
  {
    "label": "focus can go to the author box",
    "expect": {
      "type": "style",
      "selector": "#author-filter:focus",
      "property": "outline-style",
      "value": "solid"
    },
    "actions": [
      {
        "type": "focus",
        "selector": "#topic-filter"
      },
      {
        "type": "focus",
        "selector": "#author-filter"
      }
    ]
  },
  {
    "label": "The focus outline of the author box is green",
    "expect": {
      "type": "style",
      "selector": "#author-filter:focus",
      "property": "outline-color",
      "value": "rgb(18, 90, 70)"
    },
    "actions": [
      {
        "type": "focus",
        "selector": "#author-filter"
      }
    ]
  },
  {
    "label": "Author box outline offset 4px outward",
    "expect": {
      "type": "style",
      "selector": "#author-filter:focus",
      "property": "outline-offset",
      "value": "4px"
    },
    "actions": [
      {
        "type": "focus",
        "selector": "#author-filter"
      }
    ]
  },
  {
    "label": "The theme frame returns to its original outline after losing focus",
    "expect": {
      "type": "style",
      "selector": "#topic-filter:not(:focus)",
      "property": "outline-style",
      "value": "none"
    },
    "actions": [
      {
        "type": "focus",
        "selector": "#topic-filter"
      },
      {
        "type": "focus",
        "selector": "#author-filter"
      }
    ]
  }
]
