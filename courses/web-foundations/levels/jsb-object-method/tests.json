[
  {
    "label": "spell out the label according to the current object",
    "expect": {
      "type": "function",
      "name": "rackLabel",
      "args": [
        "D",
        0
      ],
      "value": "D-0"
    }
  },
  {
    "label": "different object prefix",
    "expect": {
      "type": "function",
      "name": "rackLabel",
      "args": [
        "Warehouse",
        27
      ],
      "value": "Warehouse-27"
    }
  },
  {
    "label": "retains leading zeros in string encoding",
    "expect": {
      "type": "function",
      "name": "rackLabel",
      "args": [
        "M",
        "007"
      ],
      "value": "M-007"
    }
  }
]
