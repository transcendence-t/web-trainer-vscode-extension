[
  {
    "label": "picture covers the entire box",
    "expect": {
      "type": "style",
      "selector": ".thumbnail",
      "property": "object-fit",
      "value": "cover"
    }
  },
  {
    "label": "Align the top of the picture",
    "expect": {
      "type": "style",
      "selector": ".thumbnail",
      "property": "object-position",
      "value": "50% 0%"
    }
  },
  {
    "label": "box width reserved",
    "expect": {
      "type": "style",
      "selector": ".thumbnail",
      "property": "width",
      "value": "160px"
    }
  },
  {
    "label": "box height reservation",
    "expect": {
      "type": "style",
      "selector": ".thumbnail",
      "property": "height",
      "value": "100px"
    }
  }
]
