[
  {
    "label": "The initially unselected work light remains in normal text",
    "expect": {
      "type": "style",
      "selector": "#lamp + span",
      "property": "font-weight",
      "value": "400"
    }
  },
  {
    "label": "Bold text after clicking",
    "expect": {
      "type": "style",
      "selector": "#lamp + span",
      "property": "font-weight",
      "value": "700"
    },
    "actions": [
      {
        "type": "click",
        "selector": "#lamp"
      }
    ]
  },
  {
    "label": "Return to normal font weight after canceling default selection",
    "expect": {
      "type": "style",
      "selector": "#gloves + span",
      "property": "font-weight",
      "value": "400"
    },
    "actions": [
      {
        "type": "click",
        "selector": "#gloves"
      }
    ]
  }
]
