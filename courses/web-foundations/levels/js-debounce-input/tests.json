[
  {
    "label": "Typing does not search immediately",
    "expect": {
      "type": "text",
      "selector": "#hits",
      "value": "0"
    },
    "actions": [
      {
        "type": "input",
        "selector": "#filter",
        "value": "c"
      }
    ]
  },
  {
    "label": "Continuous input only checks once",
    "expect": {
      "type": "text",
      "selector": "#hits",
      "value": "1"
    },
    "actions": [
      {
        "type": "input",
        "selector": "#filter",
        "value": "c"
      },
      {
        "type": "input",
        "selector": "#filter",
        "value": "cs"
      },
      {
        "type": "input",
        "selector": "#filter",
        "value": "css"
      },
      {
        "type": "wait",
        "ms": 300
      }
    ]
  },
  {
    "label": "The search uses the latest input",
    "expect": {
      "type": "text",
      "selector": "#last-keyword",
      "value": "css"
    },
    "actions": [
      {
        "type": "input",
        "selector": "#filter",
        "value": "c"
      },
      {
        "type": "input",
        "selector": "#filter",
        "value": "css"
      },
      {
        "type": "wait",
        "ms": 300
      }
    ]
  },
  {
    "label": "pauses twice to generate two searches",
    "expect": {
      "type": "text",
      "selector": "#hits",
      "value": "2"
    },
    "actions": [
      {
        "type": "input",
        "selector": "#filter",
        "value": "c"
      },
      {
        "type": "wait",
        "ms": 300
      },
      {
        "type": "input",
        "selector": "#filter",
        "value": "css"
      },
      {
        "type": "wait",
        "ms": 300
      }
    ]
  }
]
