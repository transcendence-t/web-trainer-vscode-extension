[
  {
    "label": "container uses normal order to wrap lines",
    "expect": {
      "type": "style",
      "selector": ".session-list",
      "property": "flex-wrap",
      "value": "wrap"
    }
  },
  {
    "label": "The first two cards in the narrow window are still side by side",
    "expect": {
      "type": "layout",
      "selector": "#friday-pm",
      "relativeTo": "#friday-am",
      "relation": "right-of"
    },
    "viewport": 320
  },
  {
    "label": "The third card in the narrow window is moved to the second row",
    "expect": {
      "type": "layout",
      "selector": "#saturday-am",
      "relativeTo": "#friday-am",
      "relation": "below"
    },
    "viewport": 320
  },
  {
    "label": "Narrow window The third card remains in the container",
    "expect": {
      "type": "layout",
      "selector": "#saturday-am",
      "relativeTo": ".session-list",
      "relation": "inside"
    },
    "viewport": 320
  },
  {
    "label": "wide window The third card is connected to the right of the second one",
    "expect": {
      "type": "layout",
      "selector": "#saturday-am",
      "relativeTo": "#friday-pm",
      "relation": "right-of"
    },
    "viewport": 720
  }
]
