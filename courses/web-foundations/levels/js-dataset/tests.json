[
  {
    "label": "Clicking the button reads its area number",
    "expect": {
      "type": "text",
      "selector": "#selection",
      "value": "Current area: A-301"
    },
    "actions": [
      {
        "type": "click",
        "selector": ".room-button[data-room-code=\"A-301\"]"
      }
    ]
  },
  {
    "label": "You can also get the parent button data by clicking on the child element.",
    "expect": {
      "type": "text",
      "selector": "#selection",
      "value": "Current area: B-105"
    },
    "actions": [
      {
        "type": "click",
        "selector": ".room-button[data-room-code=\"B-105\"] span"
      }
    ]
  },
  {
    "label": "Switching areas updates the existing message",
    "expect": {
      "type": "text",
      "selector": "#selection",
      "value": "Current area: A-301"
    },
    "actions": [
      {
        "type": "click",
        "selector": ".room-button[data-room-code=\"B-105\"]"
      },
      {
        "type": "click",
        "selector": ".room-button[data-room-code=\"A-301\"] span"
      }
    ]
  }
]
