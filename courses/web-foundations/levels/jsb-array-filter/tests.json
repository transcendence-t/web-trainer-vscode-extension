[
  {
    "label": "retains the quantity above the threshold",
    "expect": {
      "type": "function",
      "name": "selectReadyBatches",
      "args": [
        [
          3,
          8,
          2
        ],
        5
      ],
      "value": [
        8
      ]
    }
  },
  {
    "label": "The values that exactly meet the standards are retained in the original order.",
    "expect": {
      "type": "function",
      "name": "selectReadyBatches",
      "args": [
        [
          8,
          5,
          1,
          5
        ],
        5
      ],
      "value": [
        8,
        5,
        5
      ]
    }
  },
  {
    "label": "When the threshold is 0, batches with quantity 0 are also retained.",
    "expect": {
      "type": "function",
      "name": "selectReadyBatches",
      "args": [
        [
          0,
          2
        ],
        0
      ],
      "value": [
        0,
        2
      ]
    }
  },
  {
    "label": "Returns an empty array when no batch reaches the standard",
    "expect": {
      "type": "function",
      "name": "selectReadyBatches",
      "args": [
        [
          1,
          2
        ],
        4
      ],
      "value": []
    }
  },
  {
    "label": "returns an empty array when an empty array is input",
    "expect": {
      "type": "function",
      "name": "selectReadyBatches",
      "args": [
        [],
        5
      ],
      "value": []
    }
  }
]
