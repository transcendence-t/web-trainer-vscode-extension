    "expect": {
      "type": "function",
      "name": "seatStatus",
      "args": [
        0
      ],
      "value": "is full"
    }
  },
  {
    "label": "Returns when there is still 1 place and it will be full.",
    "expect": {
      "type": "function",
      "name": "seatStatus",
      "args": [
        1
      ],
      "value": "is almost full"
    }
  },
  {
    "label": "3 places are still about to be filled.",
    "expect": {
      "type": "function",
      "name": "seatStatus",
      "args": [
        3
      ],
      "value": "is almost full"
    }
  },
  {
    "label": "You can register when you return and there are 4 places.",
    "expect": {
      "type": "function",
      "name": "seatStatus",
      "args": [
        4
      ],
      "value": "can be registered"
    }
  },
  {
    "label": "Return when there are enough seats to register.",
    "expect": {
      "type": "function",
      "name": "seatStatus",
      "args": [
        16
      ],
      "value": "can be registered"
    }
