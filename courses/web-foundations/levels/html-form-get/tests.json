[
  {
    "label": "Inquiry is sent to the specified path",
    "expect": {
      "type": "attribute",
      "selector": "form#catalog-search",
      "name": "action",
      "value": "/catalog"
    }
  },
  {
    "label": "explicitly uses GET",
    "expect": {
      "type": "attribute",
      "selector": "form#catalog-search",
      "name": "method",
      "value": "get"
    }
  },
  {
    "label": "Press q to submit search keywords",
    "expect": {
      "type": "exists",
      "selector": "#catalog-search input#query[type=\"search\"][name=\"q\"]"
    }
  },
  {
    "label": "can still submit inquiries",
    "expect": {
      "type": "exists",
      "selector": "#catalog-search button[type=\"submit\"]"
    }
  }
]
