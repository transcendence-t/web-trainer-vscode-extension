[
  {
    "label": "The first question has three optional answers",
    "expect": {
      "type": "count",
      "selector": "#quiz-options button",
      "value": 3
    }
  },
  {
    "label": "If you click the next question when you have not answered the question, you cannot skip the first question.",
    "expect": {
      "type": "text",
      "selector": "#quiz-question",
      "value": "Which link address can jump to the block with the id of gallery?"
    },
    "actions": [
      {
        "type": "click",
        "selector": "#quiz-next"
      }
    ]
  },
  {
    "label": "Give correct feedback for the first correct answer",
    "expect": {
      "type": "text",
      "selector": "#quiz-feedback",
      "value": "answered correctly."
    },
    "actions": [
      {
        "type": "click",
        "selector": "#quiz-options button[data-choice=\"1\"]"
      }
    ]
  },
  {
    "label": "Display the correct option when the first question is answered incorrectly",
    "expect": {
      "type": "text",
      "selector": "#quiz-feedback",
      "value": "The correct answer is \"#gallery\"."
    },
    "actions": [
      {
        "type": "click",
        "selector": "#quiz-options button[data-choice=\"0\"]"
      }
    ]
  },
  {
    "label": "After answering, all three options of this question are disabled.",
    "expect": {
      "type": "count",
      "selector": "#quiz-options button:disabled",
      "value": 3
    },
    "actions": [
      {
        "type": "click",
        "selector": "#quiz-options button[data-choice=\"1\"]"
      }
    ]
  },
  {
    "label": "No points will be compensated if you click on the correct answer after making an incorrect answer.",
    "expect": {
      "type": "text",
      "selector": "#quiz-score",
      "value": "0"
    },
    "actions": [
      {
        "type": "click",
        "selector": "#quiz-options button[data-choice=\"0\"]"
      },
      {
        "type": "click",
        "selector": "#quiz-options button[data-choice=\"1\"]"
      }
    ]
  },
  {
    "label": "Only one point will be awarded if you click the correct option repeatedly.",
    "expect": {
      "type": "text",
      "selector": "#quiz-score",
      "value": "1"
    },
    "actions": [
      {
        "type": "click",
        "selector": "#quiz-options button[data-choice=\"1\"]"
      },
      {
        "type": "click",
        "selector": "#quiz-options button[data-choice=\"1\"]"
      }
    ]
  },
  {
    "label": "The next question is replaced by pictures instead of text.",
    "expect": {
      "type": "text",
      "selector": "#quiz-question",
      "value": "Which attribute provides alt text for an image?"
    },
    "actions": [
      {
        "type": "click",
        "selector": "#quiz-options button[data-choice=\"1\"]"
      },
      {
        "type": "click",
        "selector": "#quiz-next"
      }
    ]
  },
  {
    "label": "After changing the question, you will be prompted to wait for the answer again.",
    "expect": {
      "type": "text",
      "selector": "#quiz-feedback",
      "value": "Please select an answer."
    },
    "actions": [
      {
        "type": "click",
        "selector": "#quiz-options button[data-choice=\"1\"]"
      },
      {
        "type": "click",
        "selector": "#quiz-next"
      }
    ]
  },
  {
    "label": "Keep the accumulated score after answering two questions correctly",
    "expect": {
      "type": "text",
      "selector": "#quiz-feedback",
      "value": "Score: 2 / 2"
    },
    "actions": [
      {
        "type": "click",
        "selector": "#quiz-options button[data-choice=\"1\"]"
      },
      {
        "type": "click",
        "selector": "#quiz-next"
      },
      {
        "type": "click",
        "selector": "#quiz-options button[data-choice=\"2\"]"
      },
      {
        "type": "click",
        "selector": "#quiz-next"
      }
    ]
  },
  {
    "label": "If the first question is wrong and the second question is correct, a total of one point will be awarded.",
    "expect": {
      "type": "text",
      "selector": "#quiz-feedback",
      "value": "Score: 1 / 2"
    },
    "actions": [
      {
        "type": "click",
        "selector": "#quiz-options button[data-choice=\"0\"]"
      },
      {
        "type": "click",
        "selector": "#quiz-next"
      },
      {
        "type": "click",
        "selector": "#quiz-options button[data-choice=\"2\"]"
      },
      {
        "type": "click",
        "selector": "#quiz-next"
      }
    ]
  },
  {
    "label": "Even if you answer both questions incorrectly, you can still view the zero score result.",
    "expect": {
      "type": "text",
      "selector": "#quiz-feedback",
      "value": "Score: 0 / 2"
    },
    "actions": [
      {
        "type": "click",
        "selector": "#quiz-options button[data-choice=\"0\"]"
      },
      {
        "type": "click",
        "selector": "#quiz-next"
      },
      {
        "type": "click",
        "selector": "#quiz-options button[data-choice=\"1\"]"
      },
      {
        "type": "click",
        "selector": "#quiz-next"
      }
    ]
  },
  {
    "label": "Clear options after viewing results",
    "expect": {
      "type": "count",
      "selector": "#quiz-options button",
      "value": 0
    },
    "actions": [
      {
        "type": "click",
        "selector": "#quiz-options button[data-choice=\"1\"]"
      },
      {
        "type": "click",
        "selector": "#quiz-next"
      },
      {
        "type": "click",
        "selector": "#quiz-options button[data-choice=\"2\"]"
      },
      {
        "type": "click",
        "selector": "#quiz-next"
      }
    ]
  }
]
