[
  {
    "label": "entry is before the header",
    "expect": {
      "type": "exists",
      "selector": "body > a#skip:first-child + header"
    }
  },
  {
    "label": "Skip link text is clear",
    "expect": {
      "type": "text",
      "selector": "a#skip",
      "value": "Skip to main content"
    }
  },
  {
    "label": "The text is marked as the focus target",
    "expect": {
      "type": "attribute",
      "selector": "main#main-content",
      "name": "tabindex",
      "value": "-1"
    }
  },
  {
    "label": "Click to navigate to the text",
    "expect": {
      "type": "exists",
      "selector": "main#main-content:target"
    },
    "actions": [
      {
        "type": "click",
        "selector": "#skip"
      }
    ]
  }
]
