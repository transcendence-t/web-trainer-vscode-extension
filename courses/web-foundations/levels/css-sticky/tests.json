[
  {
    "label": "toolbar uses sticky positioning",
    "expect": {
      "type": "style",
      "selector": ".log-toolbar",
      "property": "position",
      "value": "sticky"
    }
  },
  {
    "label": "toolbar is zero",
    "expect": {
      "type": "style",
      "selector": ".log-toolbar",
      "property": "top",
      "value": "0px"
    }
  },
  {
    "label": "toolbar still uses grid layout",
    "expect": {
      "type": "style",
      "selector": ".log-toolbar",
      "property": "display",
      "value": "grid"
    }
  },
  {
    "label": "The jump link is still on the right side of the toolbar title",
    "expect": {
      "type": "layout",
      "selector": ".log-toolbar a",
      "relativeTo": ".log-toolbar h2",
      "relation": "right-of"
    },
    "actions": [
      {
        "type": "click",
        "selector": ".log-toolbar a[href=\"#latest\"]"
      }
    ]
  },
  {
    "label": "The latest record after the jump enters the log window",
    "expect": {
      "type": "layout",
      "selector": "#latest",
      "relativeTo": ".log-panel",
      "relation": "inside"
    },
    "actions": [
      {
        "type": "click",
        "selector": ".log-toolbar a[href=\"#latest\"]"
      }
    ]
  },
  {
    "label": "The earliest record after the jump has been scrolled past the toolbar",
    "expect": {
      "type": "layout",
      "selector": ".log-toolbar",
      "relativeTo": "#first-log",
      "relation": "below"
    },
    "actions": [
      {
        "type": "click",
        "selector": ".log-toolbar a[href=\"#latest\"]"
      }
    ]
  },
  {
    "label": "The toolbar remains in the log window after the jump",
    "expect": {
      "type": "layout",
      "selector": ".log-toolbar",
      "relativeTo": ".log-panel",
      "relation": "inside"
    },
    "actions": [
      {
        "type": "click",
        "selector": ".log-toolbar a[href=\"#latest\"]"
      }
    ]
  }
]
