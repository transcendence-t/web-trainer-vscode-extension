[
  {
    "label": "Ignore intermediate spaces and capitalization",
    "expect": {
      "type": "function",
      "name": "isMirrorCode",
      "args": [
        "AB b a"
      ],
      "value": true
    }
  },
  {
    "label": "Reserve numbers to participate in comparison",
    "expect": {
      "type": "function",
      "name": "isMirrorCode",
      "args": [
        "R 2 r"
      ],
      "value": true
    }
  },
  {
    "label": "is false when not mirroring",
    "expect": {
      "type": "function",
      "name": "isMirrorCode",
      "args": [
        "A-1B"
      ],
      "value": false
    }
  },
  {
    "label": "Blank is not used as a password",
    "expect": {
      "type": "function",
      "name": "isMirrorCode",
      "args": [
        "   "
      ],
      "value": false
    }
  },
  {
    "label": "contains only one valid character",
    "expect": {
      "type": "function",
      "name": "isMirrorCode",
      "args": [
        "X"
      ],
      "value": true
    }
  }
]
