[
  {
    "label": "object saves three original parameters",
    "expect": {
      "type": "function",
      "name": "makeRepairOrder",
      "args": [
        "No signal in projection",
        20,
        true
      ],
      "value": {
        "issue": "No signal in projection",
        "minutes": 20,
        "urgent": true
      }
    }
  },
  {
    "label": "retains the number 0 and the Boolean value false",
    "expect": {
      "type": "function",
      "name": "makeRepairOrder",
      "args": [
        "Change house number",
        0,
        false
      ],
      "value": {
        "issue": "Change house number",
        "minutes": 0,
        "urgent": false
      }
    }
  },
  {
    "label": "Change a set of inputs and still match three fields",
    "expect": {
      "type": "function",
      "name": "makeRepairOrder",
      "args": [
        "faucet leaking",
        35,
        false
      ],
      "value": {
        "issue": "faucet leaking",
        "minutes": 35,
        "urgent": false
      }
    }
  }
]
