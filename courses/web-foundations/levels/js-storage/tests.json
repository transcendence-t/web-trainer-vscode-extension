[
  {
    "label": "Placeholder text is displayed when the nickname has not been saved.",
    "expect": {
      "type": "text",
      "selector": "#saved-name",
      "value": "No nickname yet"
    }
  },
  {
    "label": "The nickname has not been written to the local storage when entering it.",
    "expect": {
      "type": "storage",
      "key": "visitorNickname",
      "value": null
    },
    "actions": [
      {
        "type": "input",
        "selector": "#nickname",
        "value": "Bai Ling"
      }
    ]
  },
  {
    "label": "Click Save and write the trimmed nickname.",
    "expect": {
      "type": "storage",
      "key": "visitorNickname",
      "value": "Night heron"
    },
    "actions": [
      {
        "type": "input",
        "selector": "#nickname",
        "value": "  Night heron  "
      },
      {
        "type": "click",
        "selector": "#save-name"
      }
    ]
  },
  {
    "label": "The nickname will be displayed immediately on the saved page.",
    "expect": {
      "type": "text",
      "selector": "#saved-name",
      "value": "spring bird"
    },
    "actions": [
      {
        "type": "input",
        "selector": "#nickname",
        "value": "spring bird"
      },
      {
        "type": "click",
        "selector": "#save-name"
      }
    ]
  },
  {
    "label": "is opened, the last saved nickname will be displayed.",
    "expect": {
      "type": "text",
      "selector": "#saved-name",
      "value": "Night heron"
    },
    "storage": {
      "visitorNickname": "Night heron"
    }
  },
  {
    "label": "Keep the saved value when entering blank",
    "expect": {
      "type": "storage",
      "key": "visitorNickname",
      "value": "Bai Ling"
    },
    "storage": {
      "visitorNickname": "Bai Ling"
    },
    "actions": [
      {
        "type": "input",
        "selector": "#nickname",
        "value": "   "
      },
      {
        "type": "click",
        "selector": "#save-name"
      }
    ]
  }
]
