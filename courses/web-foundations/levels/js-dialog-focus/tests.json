[
  {
    "label": "Open native modal dialog box",
    "expect": {
      "type": "exists",
      "selector": "#rules-dialog:modal"
    },
    "actions": [
      {
        "type": "click",
        "selector": "#open"
      }
    ]
  },
  {
    "label": "Close button gets focus",
    "expect": {
      "type": "exists",
      "selector": "#dismiss:focus"
    },
    "actions": [
      {
        "type": "focus",
        "selector": "#open"
      },
      {
        "type": "click",
        "selector": "#open"
      }
    ]
  },
  {
    "label": "will not open again after closing",
    "expect": {
      "type": "count",
      "selector": "#rules-dialog[open]",
      "value": 0
    },
    "actions": [
      {
        "type": "click",
        "selector": "#open"
      },
      {
        "type": "click",
        "selector": "#dismiss"
      }
    ]
  },
  {
    "label": "Focus returns to the entrance when closed",
    "expect": {
      "type": "exists",
      "selector": "#open:focus"
    },
    "actions": [
      {
        "type": "focus",
        "selector": "#open"
      },
      {
        "type": "click",
        "selector": "#open"
      },
      {
        "type": "click",
        "selector": "#dismiss"
      }
    ]
  }
]
