[
  {
    "label": "numerical order is different from dictionary order",
    "expect": {
      "type": "function",
      "name": "sortReadings",
      "args": [
        [
          30,
          4,
          -2,
          12
        ]
      ],
      "value": [
        -2,
        4,
        12,
        30
      ]
    }
  },
  {
    "label": "sort to retain duplicate values",
    "expect": {
      "type": "function",
      "name": "sortReadings",
      "args": [
        [
          2,
          0,
          2
        ]
      ],
      "value": [
        0,
        2,
        2
      ]
    }
  },
  {
    "label": "An empty list still returns an array",
    "expect": {
      "type": "function",
      "name": "sortReadings",
      "args": [
        []
      ],
      "value": []
    }
  },
  {
    "label": "sorting will not change the original order",
    "expect": {
      "type": "function",
      "name": "compareOrder",
      "args": [
        [
          18,
          4
        ]
      ],
      "value": [
        [
          4,
          18
        ],
        [
          18,
          4
        ]
      ]
    }
  }
]
