[
  {
    "label": "Display browser playback controls",
    "expect": {
      "type": "property",
      "selector": "audio#arrival",
      "name": "controls",
      "value": true
    }
  },
  {
    "label": "does not play automatically",
    "expect": {
      "type": "property",
      "selector": "audio#arrival",
      "name": "autoplay",
      "value": false
    }
  },
  {
    "label": "associated sound description",
    "expect": {
      "type": "attribute",
      "selector": "audio#arrival",
      "name": "aria-describedby",
      "value": "transcript"
    }
  },
  {
    "label": "retains WAV audio source",
    "expect": {
      "type": "exists",
      "selector": "audio#arrival > source[type=\"audio/wav\"][src^=\"data:audio/wav\"]"
    }
  }
]
