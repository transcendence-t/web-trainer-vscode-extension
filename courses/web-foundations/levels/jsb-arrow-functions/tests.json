[
  {
    "label": "generates records with string numbers",
    "expect": {
      "type": "function",
      "name": "buildTicket",
      "args": [
        "R-28"
      ],
      "value": {
        "id": "R-28",
        "status": "pending"
      }
    }
  },
  {
    "label": "digital number reserved digital type",
    "expect": {
      "type": "function",
      "name": "buildTicket",
      "args": [
        24
      ],
      "value": {
        "id": 24,
        "status": "pending"
      }
    }
  },
  {
    "label": "zero is also a valid number",
    "expect": {
      "type": "function",
      "name": "buildTicket",
      "args": [
        0
      ],
      "value": {
        "id": 0,
        "status": "pending"
      }
    }
  }
]
