[
  {
    "label": "entry tag uses inline-block",
    "expect": {
      "type": "style",
      "selector": "#entry-ready",
      "property": "display",
      "value": "inline-block"
    }
  },
  {
    "label": "maintains the existing 108px label width",
    "expect": {
      "type": "style",
      "selector": "#entry-check",
      "property": "width",
      "value": "108px"
    }
  },
  {
    "label": "maintains the existing 34px label height",
    "expect": {
      "type": "style",
      "selector": "#entry-check",
      "property": "height",
      "value": "34px"
    }
  },
  {
    "label": "The second label is on the right side of the same line",
    "expect": {
      "type": "layout",
      "selector": "#entry-check",
      "relativeTo": "#entry-ready",
      "relation": "right-of"
    }
  },
  {
    "label": "The outer frames of the two labels are the same width",
    "expect": {
      "type": "layout",
      "selector": "#entry-check",
      "relativeTo": "#entry-ready",
      "relation": "equal-width"
    }
  }
]
