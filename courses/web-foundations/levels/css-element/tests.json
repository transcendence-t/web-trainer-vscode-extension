[
  {
    "label": "working day paragraphs are in green",
    "expect": {
      "type": "style",
      "selector": "main > p:first-of-type",
      "property": "color",
      "value": "rgb(18, 90, 70)"
    }
  },
  {
    "label": "Friday paragraph is in green",
    "expect": {
      "type": "style",
      "selector": "main > p:nth-of-type(2)",
      "property": "color",
      "value": "rgb(18, 90, 70)"
    }
  },
  {
    "label": "The first paragraph font size is 18px",
    "expect": {
      "type": "style",
      "selector": "main > p:first-of-type",
      "property": "font-size",
      "value": "18px"
    }
  },
  {
    "label": "The second paragraph font size is 18px",
    "expect": {
      "type": "style",
      "selector": "main > p:nth-of-type(2)",
      "property": "font-size",
      "value": "18px"
    }
  },
  {
    "label": "page title retains original color",
    "expect": {
      "type": "style",
      "selector": "main > h1",
      "property": "color",
      "value": "rgb(36, 52, 71)"
    },
    "hint": "Set the color on p to avoid affecting the title."
  }
]
