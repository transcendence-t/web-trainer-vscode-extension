[
  {
    "label": "Use four lines of required multi-line input box",
    "expect": {
      "type": "exists",
      "selector": "textarea#reason[name=\"reason\"][rows=\"4\"][required]"
    }
  },
  {
    "label": "Enter up to 120 characters",
    "expect": {
      "type": "property",
      "selector": "textarea#reason",
      "name": "maxLength",
      "value": 120
    }
  },
  {
    "label": "tags are still associated with fields",
    "expect": {
      "type": "text",
      "selector": "label[for=\"reason\"]",
      "value": "Application Instructions"
    }
  },
  {
    "label": "Fill in the prompt as a description",
    "expect": {
      "type": "attribute",
      "selector": "textarea#reason",
      "name": "aria-describedby",
      "value": "reason-guide"
    }
  },
  {
    "label": "can receive multiple lines of input",
    "expect": {
      "type": "property",
      "selector": "#reason",
      "name": "value",
      "value": "Purpose 1\nUse two"
    },
    "actions": [
      {
        "type": "input",
        "selector": "#reason",
        "value": "Purpose 1\nUse two"
      }
    ]
  }
]
