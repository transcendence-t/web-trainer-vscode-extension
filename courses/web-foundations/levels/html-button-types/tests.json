[
  {
    "label": "Preserve submit type of save button",
    "expect": {
      "type": "property",
      "selector": "button#send",
      "name": "type",
      "value": "submit"
    }
  },
  {
    "label": "The type of recovery button is reset",
    "expect": {
      "type": "property",
      "selector": "button#restore",
      "name": "type",
      "value": "reset"
    }
  },
  {
    "label": "After editing, click Restore to get the prefilled name.",
    "expect": {
      "type": "property",
      "selector": "#alias",
      "name": "value",
      "value": "Model A"
    },
    "actions": [
      {
        "type": "input",
        "selector": "#alias",
        "value": "Model B"
      },
      {
        "type": "click",
        "selector": "#restore"
      }
    ]
  }
]
