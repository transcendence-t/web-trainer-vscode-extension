[
  {
    "label": "Text input associated suggestion list with the same ID",
    "expect": {
      "type": "exists",
      "selector": "input#building-input[type=\"text\"][list=\"building-options\"] ~ datalist#building-options"
    }
  },
  {
    "label": "The list offers exactly three suggestions",
    "expect": {
      "type": "count",
      "selector": "#building-options option",
      "value": 3
    }
  },
  {
    "label": "candidates include Duxinglou",
    "expect": {
      "type": "exists",
      "selector": "datalist#building-options > option[value=\"Duxing Building\"]"
    }
  },
  {
    "label": "Candidates include Mingde House",
    "expect": {
      "type": "exists",
      "selector": "datalist#building-options > option[value=\"Mingde Building\"]"
    }
  },
  {
    "label": "candidates include Qiuzhilou",
    "expect": {
      "type": "exists",
      "selector": "datalist#building-options > option[value=\"Qiuzhi Building\"]"
    }
  }
]
