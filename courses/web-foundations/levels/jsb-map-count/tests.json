[
  {
    "label": "counts the number of times and retains the order of first occurrence",
    "expect": {
      "type": "function",
      "name": "countMaterials",
      "args": [
        [
          "rope",
          "fabric",
          "rope",
          "dye"
        ]
      ],
      "value": [
        [
          "rope",
          2
        ],
        [
          "fabric",
          1
        ],
        [
          "dye",
          1
        ]
      ]
    }
  },
  {
    "label": "special string is still a legal material name",
    "expect": {
      "type": "function",
      "name": "countMaterials",
      "args": [
        [
          "__proto__",
          "paper",
          "__proto__"
        ]
      ],
      "value": [
        [
          "__proto__",
          2
        ],
        [
          "paper",
          1
        ]
      ]
    }
  },
  {
    "label": "The registration order is retained when the material name is a numeric string.",
    "expect": {
      "type": "function",
      "name": "countMaterials",
      "args": [
        [
          "7",
          "2",
          "7"
        ]
      ],
      "value": [
        [
          "7",
          2
        ],
        [
          "2",
          1
        ]
      ]
    }
  },
  {
    "label": "empty input",
    "expect": {
      "type": "function",
      "name": "countMaterials",
      "args": [
        []
      ],
      "value": []
    }
  }
]
