[
  {
    "label": "Angle brackets are displayed according to the original text",
    "expect": {
      "type": "text",
      "selector": "#literal",
      "value": "<b>text</b>"
    },
    "actions": [
      {
        "type": "input",
        "selector": "#draft",
        "value": "<b>text</b>"
      }
    ]
  },
  {
    "label": "Do not create user-supplied nodes",
    "expect": {
      "type": "count",
      "selector": "#literal b",
      "value": 0
    },
    "actions": [
      {
        "type": "input",
        "selector": "#draft",
        "value": "<b>text</b>"
      }
    ]
  },
  {
    "label": "retains ampersands and quotation marks",
    "expect": {
      "type": "text",
      "selector": "#literal",
      "value": "Department A & \"B\""
    },
    "actions": [
      {
        "type": "input",
        "selector": "#draft",
        "value": "Department A & \"B\""
      }
    ]
  },
  {
    "label": "Recovery prompt when clearing",
    "expect": {
      "type": "text",
      "selector": "#literal",
      "value": "Waiting for input"
    },
    "actions": [
      {
        "type": "input",
        "selector": "#draft",
        "value": "hi"
      },
      {
        "type": "input",
        "selector": "#draft",
        "value": ""
      }
    ]
  }
]
