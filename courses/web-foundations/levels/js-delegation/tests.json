[
  {
    "label": "No track is selected at the beginning of the page",
    "expect": {
      "type": "text",
      "selector": "#selected-song",
      "value": "Not selected yet"
    }
  },
  {
    "label": "Click the button directly to select the track",
    "expect": {
      "type": "text",
      "selector": "#selected-song",
      "value": "Mountain tune"
    },
    "actions": [
      {
        "type": "click",
        "selector": "#song-list button[data-title=\"Mountain tune\"]"
      }
    ]
  },
  {
    "label": "Click the span in the button to select the track",
    "expect": {
      "type": "text",
      "selector": "#selected-song",
      "value": "Seaside Overture"
    },
    "actions": [
      {
        "type": "click",
        "selector": "#song-list button[data-title=\"Mountain tune\"]"
      },
      {
        "type": "click",
        "selector": "#song-list button[data-title=\"Seaside Overture\"] span"
      }
    ]
  },
  {
    "label": "Click on a blank space in the list to retain the selected track",
    "expect": {
      "type": "text",
      "selector": "#selected-song",
      "value": "Mountain tune"
    },
    "actions": [
      {
        "type": "click",
        "selector": "#song-list button[data-title=\"Mountain tune\"]"
      },
      {
        "type": "click",
        "selector": "#song-list"
      }
    ]
  },
  {
    "label": "After adding, click the inner text of the new track to select it.",
    "expect": {
      "type": "text",
      "selector": "#selected-song",
      "value": "Blue Bridge March"
    },
    "actions": [
      {
        "type": "click",
        "selector": "#add-song"
      },
      {
        "type": "click",
        "selector": "#song-list button[data-title=\"Blue Bridge March\"] span"
      }
    ]
  }
]
