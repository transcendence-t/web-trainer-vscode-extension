[
  {
    "label": "Several different numbers are converted in the original order",
    "expect": {
      "type": "function",
      "name": "labelTickets",
      "args": [
        [
          12,
          3,
          28
        ]
      ],
      "value": [
        "Q-12",
        "Q-3",
        "Q-28"
      ]
    }
  },
  {
    "label": "number 0 is also converted to a label",
    "expect": {
      "type": "function",
      "name": "labelTickets",
      "args": [
        [
          0
        ]
      ],
      "value": [
        "Q-0"
      ]
    }
  },
  {
    "label": "Duplicate numbers are converted into respective labels",
    "expect": {
      "type": "function",
      "name": "labelTickets",
      "args": [
        [
          4,
          4
        ]
      ],
      "value": [
        "Q-4",
        "Q-4"
      ]
    }
  },
  {
    "label": "Returns an empty array when there is no number",
    "expect": {
      "type": "function",
      "name": "labelTickets",
      "args": [
        []
      ],
      "value": []
    }
  }
]
