[
  {
    "label": "Filter zero inventory and retain quantity order",
    "expect": {
      "type": "function",
      "name": "inventoryRows",
      "args": [
        {
          "fabric": 6,
          "ballpoint pen": 0,
          "paper": 13
        }
      ],
      "value": [
        {
          "name": "fabric",
          "quantity": 6
        },
        {
          "name": "paper",
          "quantity": 13
        }
      ]
    }
  },
  {
    "label": "empty object returns empty list",
    "expect": {
      "type": "function",
      "name": "inventoryRows",
      "args": [
        {}
      ],
      "value": []
    }
  },
  {
    "label": "No entry when all zeros",
    "expect": {
      "type": "function",
      "name": "inventoryRows",
      "args": [
        {
          "spool": 0
        }
      ],
      "value": []
    }
  }
]
