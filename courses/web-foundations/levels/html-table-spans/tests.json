[
  {
    "label": "The venue heading spans two rows",
    "expect": {
      "type": "text",
      "selector": "thead tr:first-child th[scope=\"col\"][rowspan=\"2\"]",
      "value": "Venue"
    }
  },
  {
    "label": "The date group heading spans two columns",
    "expect": {
      "type": "text",
      "selector": "thead th[colspan=\"2\"]",
      "value": "Saturday and Sunday"
    }
  },
  {
    "label": "The second row has no duplicate placeholder",
    "expect": {
      "type": "count",
      "selector": "thead tr:nth-child(2) > th",
      "value": 2
    }
  },
  {
    "label": "The date column headings are in the correct order",
    "expect": {
      "type": "text",
      "selector": "thead tr:nth-child(2) th:first-child",
      "value": "Saturday"
    }
  }
]
