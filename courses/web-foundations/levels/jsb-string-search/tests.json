[
  {
    "label": "contains mixed case keywords",
    "expect": {
      "type": "function",
      "name": "matchesKeyword",
      "args": [
        "Portable Mixer",
        " MIX "
      ],
      "value": true
    }
  },
  {
    "label": "can be matched at any position",
    "expect": {
      "type": "function",
      "name": "matchesKeyword",
      "args": [
        "DX8-charging module",
        "charging"
      ],
      "value": true
    }
  },
  {
    "label": "is false when the keyword is missing",
    "expect": {
      "type": "function",
      "name": "matchesKeyword",
      "args": [
        "DX8-charging module",
        "button"
      ],
      "value": false
    }
  },
  {
    "label": "Blank query shows all",
    "expect": {
      "type": "function",
      "name": "matchesKeyword",
      "args": [
        "Lab Station",
        " \t"
      ],
      "value": true
    }
  }
]
