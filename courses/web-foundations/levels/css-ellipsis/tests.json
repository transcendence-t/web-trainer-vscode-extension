[
  {
    "label": "File name area limit",
    "expect": {
      "type": "style",
      "selector": ".filename",
      "property": "max-width",
      "value": "180px"
    }
  },
  {
    "label": "text occupies one line",
    "expect": {
      "type": "style",
      "selector": ".filename",
      "property": "white-space",
      "value": "nowrap"
    }
  },
  {
    "label": "Hide overflow text",
    "expect": {
      "type": "style",
      "selector": ".filename",
      "property": "overflow-x",
      "value": "hidden"
    }
  },
  {
    "label": "Draw overflow ellipsis",
    "expect": {
      "type": "style",
      "selector": ".filename",
      "property": "text-overflow",
      "value": "ellipsis"
    }
  },
  {
    "label": "shortening occurs only visually",
    "expect": {
      "type": "property",
      "selector": ".filename",
      "name": "textContent",
      "value": "Campus theme exhibition display list and latest material procurement record.pdf"
    }
  }
]
