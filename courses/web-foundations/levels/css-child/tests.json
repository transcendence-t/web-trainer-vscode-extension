[
  {
    "label": "Public lecture catalog items have a blue left border",
    "expect": {
      "type": "style",
      "selector": "#talks-entry",
      "property": "border-left",
      "value": "4px solid rgb(38, 74, 124)"
    }
  },
  {
    "label": "Works exhibition catalog items have a blue left border",
    "expect": {
      "type": "style",
      "selector": "#exhibitions-entry",
      "property": "border-left",
      "value": "4px solid rgb(38, 74, 124)"
    }
  },
  {
    "label": "Leave 12px padding for first-level directory items",
    "expect": {
      "type": "style",
      "selector": "#talks-entry",
      "property": "padding-left",
      "value": "12px"
    }
  },
  {
    "label": "Another item also leaves 12px padding",
    "expect": {
      "type": "style",
      "selector": "#exhibitions-entry",
      "property": "padding-left",
      "value": "12px"
    }
  },
  {
    "label": "The left border of nested items is still the default style",
    "expect": {
      "type": "style",
      "selector": "#talk-schedule",
      "property": "border-left-style",
      "value": "none"
    },
    "hint": "Use > to select the direct child elements of .agenda."
  },
  {
    "label": "Another nested item retains the original padding",
    "expect": {
      "type": "style",
      "selector": "#exhibition-schedule",
      "property": "padding-left",
      "value": "0px"
    }
  }
]
