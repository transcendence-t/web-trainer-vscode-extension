[
  {
    "label": "reading light is dark by default",
    "expect": {
      "type": "style",
      "selector": ".reading-lamp",
      "property": "opacity",
      "value": "0.25"
    }
  },
  {
    "label": "Normal state also configures transition for transparency",
    "expect": {
      "type": "style",
      "selector": ".reading-lamp",
      "property": "transition-property",
      "value": "opacity"
    }
  },
  {
    "label": "transition lasts 300ms",
    "expect": {
      "type": "style",
      "selector": ".reading-lamp",
      "property": "transition-duration",
      "value": "0.3s"
    }
  },
  {
    "label": "transition use ease",
    "expect": {
      "type": "style",
      "selector": ".reading-lamp",
      "property": "transition-timing-function",
      "value": "ease"
    }
  },
  {
    "label": "After clicking, the reading light gradually lights up to 1",
    "expect": {
      "type": "style",
      "selector": ".reading-lamp.is-on",
      "property": "opacity",
      "value": "1"
    },
    "actions": [
      {
        "type": "click",
        "selector": "#toggle-lamp"
      },
      {
        "type": "finish-motion",
        "selector": ".reading-lamp"
      }
    ]
  },
  {
    "label": "The reading light returns to dark state after clicking again.",
    "expect": {
      "type": "style",
      "selector": ".reading-lamp:not(.is-on)",
      "property": "opacity",
      "value": "0.25"
    },
    "actions": [
      {
        "type": "click",
        "selector": "#toggle-lamp"
      },
      {
        "type": "finish-motion",
        "selector": ".reading-lamp"
      },
      {
        "type": "click",
        "selector": "#toggle-lamp"
      },
      {
        "type": "finish-motion",
        "selector": ".reading-lamp"
      }
    ]
  }
]
