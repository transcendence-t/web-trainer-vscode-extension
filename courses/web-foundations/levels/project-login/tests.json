[
  {
    "label": "Password field uses labeled password control",
    "expect": {
      "type": "exists",
      "selector": "#login-form:has(label[for=\"login-password\"]) input#login-password[type=\"password\" i]"
    }
  },
  {
    "label": "initial page waiting for user input",
    "expect": {
      "type": "text",
      "selector": "#login-status",
      "value": "Please enter the demo account and password."
    }
  },
  {
    "label": "Prompt to fill in when submitting an empty form directly",
    "expect": {
      "type": "text",
      "selector": "#login-status",
      "value": "Please fill in your account number and password."
    },
    "actions": [
      {
        "type": "click",
        "selector": "#login-submit"
      }
    ]
  },
  {
    "label": "Prompt to fill in the password when only filling in the account number",
    "expect": {
      "type": "text",
      "selector": "#login-status",
      "value": "Please fill in your account number and password."
    },
    "actions": [
      {
        "type": "input",
        "selector": "#login-name",
        "value": "learner"
      },
      {
        "type": "input",
        "selector": "#login-password",
        "value": ""
      },
      {
        "type": "click",
        "selector": "#login-submit"
      }
    ]
  },
  {
    "label": "Accounts with all spaces will be treated as unfilled.",
    "expect": {
      "type": "text",
      "selector": "#login-status",
      "value": "Please fill in your account number and password."
    },
    "actions": [
      {
        "type": "input",
        "selector": "#login-name",
        "value": "   "
      },
      {
        "type": "input",
        "selector": "#login-password",
        "value": "study123"
      },
      {
        "type": "click",
        "selector": "#login-submit"
      }
    ]
  },
  {
    "label": "Denied login when the account number is correct but the password is wrong",
    "expect": {
      "type": "text",
      "selector": "#login-status",
      "value": "The account number or password is incorrect."
    },
    "actions": [
      {
        "type": "input",
        "selector": "#login-name",
        "value": "learner"
      },
      {
        "type": "input",
        "selector": "#login-password",
        "value": "wrong123"
      },
      {
        "type": "click",
        "selector": "#login-submit"
      }
    ]
  },
  {
    "label": "Refuse to log in when the password is correct but the account number is wrong",
    "expect": {
      "type": "text",
      "selector": "#login-status",
      "value": "The account number or password is incorrect."
    },
    "actions": [
      {
        "type": "input",
        "selector": "#login-name",
        "value": "visitor"
      },
      {
        "type": "input",
        "selector": "#login-password",
        "value": "study123"
      },
      {
        "type": "click",
        "selector": "#login-submit"
      }
    ]
  },
  {
    "label": "Successful when both the account number and password are correct",
    "expect": {
      "type": "text",
      "selector": "#login-status",
      "value": "Login successful."
    },
    "actions": [
      {
        "type": "input",
        "selector": "#login-name",
        "value": "learner"
      },
      {
        "type": "input",
        "selector": "#login-password",
        "value": "study123"
      },
      {
        "type": "click",
        "selector": "#login-submit"
      }
    ]
  },
  {
    "label": "The spaces on both sides of the account do not affect the matching.",
    "expect": {
      "type": "text",
      "selector": "#login-status",
      "value": "Login successful."
    },
    "actions": [
      {
        "type": "input",
        "selector": "#login-name",
        "value": " learner "
      },
      {
        "type": "input",
        "selector": "#login-password",
        "value": "study123"
      },
      {
        "type": "click",
        "selector": "#login-submit"
      }
    ]
  },
  {
    "label": "passwords are compared as is",
    "expect": {
      "type": "text",
      "selector": "#login-status",
      "value": "The account number or password is incorrect."
    },
    "actions": [
      {
        "type": "input",
        "selector": "#login-name",
        "value": "learner"
      },
      {
        "type": "input",
        "selector": "#login-password",
        "value": " study123"
      },
      {
        "type": "click",
        "selector": "#login-submit"
      }
    ]
  }
]
