[
  {
    "label": "Keyword input box participates in allocating remaining space",
    "expect": {
      "type": "style",
      "selector": "#book-query",
      "property": "flex-grow",
      "value": "1"
    }
  },
  {
    "label": "The narrow window input box fills the empty width",
    "expect": {
      "type": "style",
      "selector": "#book-query",
      "property": "width",
      "value": "160px"
    },
    "viewport": 320
  },
  {
    "label": "The input box of the wide window continues to expand",
    "expect": {
      "type": "style",
      "selector": "#book-query",
      "property": "width",
      "value": "560px"
    },
    "viewport": 720
  },
  {
    "label": "narrow window query button is still 80px wide",
    "expect": {
      "type": "style",
      "selector": "#query-button",
      "property": "width",
      "value": "80px"
    },
    "viewport": 320
  },
  {
    "label": "wide window query button is still 80px wide",
    "expect": {
      "type": "style",
      "selector": "#query-button",
      "property": "width",
      "value": "80px"
    },
    "viewport": 720
  },
  {
    "label": "Leave 12px spacing between the input box and the button",
    "expect": {
      "type": "style",
      "selector": ".query-bar",
      "property": "column-gap",
      "value": "12px"
    }
  },
  {
    "label": "The narrow window query button is arranged on the right side of the input box",
    "expect": {
      "type": "layout",
      "selector": "#query-button",
      "relativeTo": "#book-query",
      "relation": "right-of"
    },
    "viewport": 320
  }
]
