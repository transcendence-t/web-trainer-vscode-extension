[
  {
    "label": "Prepared package returns label string",
    "expect": {
      "type": "function",
      "name": "listReadyPickups",
      "args": [
        [
          {
            "label": "North cabinet-03",
            "ready": true
          },
          {
            "label": "North cabinet-04",
            "ready": false
          },
          {
            "label": "South cabinet-12",
            "ready": true
          }
        ]
      ],
      "value": [
        "North cabinet-03",
        "South cabinet-12"
      ]
    }
  },
  {
    "label": "preserves order and labels with the same name",
    "expect": {
      "type": "function",
      "name": "listReadyPickups",
      "args": [
        [
          {
            "label": "West Cabinet-08",
            "ready": true
          },
          {
            "label": "West Cabinet-01",
            "ready": true
          },
          {
            "label": "West Cabinet-08",
            "ready": true
          }
        ]
      ],
      "value": [
        "West Cabinet-08",
        "West Cabinet-01",
        "West Cabinet-08"
      ]
    }
  },
  {
    "label": "returns an empty list when stocking",
    "expect": {
      "type": "function",
      "name": "listReadyPickups",
      "args": [
        [
          {
            "label": "East cabinet-01",
            "ready": false
          }
        ]
      ],
      "value": []
    }
  },
  {
    "label": "Empty package list returns empty label list",
    "expect": {
      "type": "function",
      "name": "listReadyPickups",
      "args": [
        []
      ],
      "value": []
    }
  }
]
