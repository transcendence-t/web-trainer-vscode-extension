[
  {
    "label": "The table starts with a caption",
    "expect": {
      "type": "text",
      "selector": "table > caption:first-child",
      "value": "Venue opening hours"
    }
  },
  {
    "label": "The thead has one row of column headings",
    "expect": {
      "type": "count",
      "selector": "table > thead > tr",
      "value": 1
    }
  },
  {
    "label": "The first column heading identifies the venue",
    "expect": {
      "type": "text",
      "selector": "thead > tr > th[scope=\"col\"]:nth-child(1)",
      "value": "venue"
    }
  },
  {
    "label": "The second column title is opening hours",
    "expect": {
      "type": "text",
      "selector": "thead > tr > th[scope=\"col\"]:nth-child(2)",
      "value": "opening hours"
    }
  },
  {
    "label": "tbody keeps two venue records",
    "expect": {
      "type": "count",
      "selector": "table > tbody > tr",
      "value": 2
    }
  },
  {
    "label": "The first line header is the table tennis room",
    "expect": {
      "type": "text",
      "selector": "tbody > tr:first-child > th[scope=\"row\"]:first-child",
      "value": "table tennis room"
    }
  },
  {
    "label": "table tennis room time is retained in the data cell",
    "expect": {
      "type": "text",
      "selector": "tbody > tr:first-child > td:nth-child(2)",
      "value": "09:00–12:00"
    }
  },
  {
    "label": "The header of the second row is the painting and calligraphy room",
    "expect": {
      "type": "text",
      "selector": "tbody > tr:last-child > th[scope=\"row\"]:first-child",
      "value": "Painting and Calligraphy Studio"
    }
  },
  {
    "label": "The calligraphy and painting studio time is retained in the data cell",
    "expect": {
      "type": "text",
      "selector": "tbody > tr:last-child > td:nth-child(2)",
      "value": "13:30–17:00"
    }
  }
]
