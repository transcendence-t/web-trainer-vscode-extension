[
  {
    "label": "panel spindle remains vertical",
    "expect": {
      "type": "style",
      "selector": ".arrival-panel",
      "property": "flex-direction",
      "value": "column"
    }
  },
  {
    "label": "The two items as a whole are centered on the main axis",
    "expect": {
      "type": "style",
      "selector": ".arrival-panel",
      "property": "justify-content",
      "value": "center"
    }
  },
  {
    "label": "preserves 12px spacing between items",
    "expect": {
      "type": "style",
      "selector": ".arrival-panel",
      "property": "row-gap",
      "value": "12px"
    }
  },
  {
    "label": "status prompt is horizontally centered",
    "expect": {
      "type": "layout",
      "selector": "#arrival-status",
      "relativeTo": ".arrival-panel",
      "relation": "center-x"
    }
  },
  {
    "label": "record link horizontally centered",
    "expect": {
      "type": "layout",
      "selector": "#arrival-link",
      "relativeTo": ".arrival-panel",
      "relation": "center-x"
    }
  },
  {
    "label": "link is still listed below the status prompt",
    "expect": {
      "type": "layout",
      "selector": "#arrival-link",
      "relativeTo": "#arrival-status",
      "relation": "below"
    }
  }
]
