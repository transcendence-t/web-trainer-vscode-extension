[
  {
    "label": "Ordinary remarks can be cleared",
    "expect": {
      "type": "function",
      "name": "canClearNote",
      "args": [
        "placed at the front desk"
      ],
      "value": true
    }
  },
  {
    "label": "empty string returns false",
    "expect": {
      "type": "function",
      "name": "canClearNote",
      "args": [
        ""
      ],
      "value": false
    }
  },
  {
    "label": "string 0 is also the character that has been entered",
    "expect": {
      "type": "function",
      "name": "canClearNote",
      "args": [
        "0"
      ],
      "value": true
    }
  },
  {
    "label": "can still be cleared when there are only spaces",
    "expect": {
      "type": "function",
      "name": "canClearNote",
      "args": [
        " "
      ],
      "value": true
    }
  },
  {
    "label": "string false is also the text that has been entered",
    "expect": {
      "type": "function",
      "name": "canClearNote",
      "args": [
        "false"
      ],
      "value": true
    }
  }
]
