[
  {
    "label": "retains browser submission verification",
    "expect": {
      "type": "exists",
      "selector": "form:not([novalidate]) button[type=\"submit\"]:not([formnovalidate])"
    }
  },
  {
    "label": "Invalid when the pickup code is left blank",
    "expect": {
      "type": "exists",
      "selector": "form input#pickup-code:required:invalid"
    }
  },
  {
    "label": "lowercase letters do not conform to the format",
    "expect": {
      "type": "exists",
      "selector": "#pickup-code[pattern]:invalid"
    },
    "actions": [
      {
        "type": "input",
        "selector": "#pickup-code",
        "value": "ab0427"
      }
    ]
  },
  {
    "label": "is invalid when the number is one less",
    "expect": {
      "type": "exists",
      "selector": "#pickup-code[pattern]:invalid"
    },
    "actions": [
      {
        "type": "input",
        "selector": "#pickup-code",
        "value": "AB427"
      }
    ]
  },
  {
    "label": "is valid when uppercase letters plus four digits are used",
    "expect": {
      "type": "exists",
      "selector": "#pickup-code[pattern]:valid"
    },
    "actions": [
      {
        "type": "input",
        "selector": "#pickup-code",
        "value": "ZX2026"
      }
    ]
  }
]
