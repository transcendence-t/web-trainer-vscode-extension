[
  {
    "label": "Existing display preparation items can be seen",
    "expect": {
      "type": "text",
      "selector": "#task-list > li:nth-child(1) .task-title",
      "value": "Check display order"
    }
  },
  {
    "label": "only retains the title itself after adding it",
    "expect": {
      "type": "text",
      "selector": "#task-list > li:nth-child(2) .task-title",
      "value": "preparation diagram"
    },
    "actions": [
      {
        "type": "input",
        "selector": "#task-input",
        "value": "　 preparation diagram  "
      },
      {
        "type": "click",
        "selector": "#add-task"
      }
    ]
  },
  {
    "label": "The input box has been cleared after the addition is successful.",
    "expect": {
      "type": "exists",
      "selector": "#task-input:placeholder-shown"
    },
    "actions": [
      {
        "type": "input",
        "selector": "#task-input",
        "value": "preparation diagram"
      },
      {
        "type": "click",
        "selector": "#add-task"
      }
    ]
  },
