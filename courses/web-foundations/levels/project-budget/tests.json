[
  {
    "label": "error prompt area uses alert role",
    "expect": {
      "type": "exists",
      "selector": "#expense-error[role=\"alert\"]"
    }
  },
  {
    "label": "The balance column is actually arranged to the right of the expenditure column",
    "expect": {
      "type": "layout",
      "selector": ".remaining-summary",
      "relativeTo": ".spending-summary",
      "relation": "right-of"
    }
  },
  {
    "label": "The two amount columns are actually the same width",
    "expect": {
      "type": "layout",
      "selector": ".remaining-summary",
      "relativeTo": ".spending-summary",
      "relation": "equal-width"
    }
  },
  {
    "label": "Leave 12px between the two columns",
    "expect": {
      "type": "style",
      "selector": ".expense-summary",
      "property": "column-gap",
      "value": "12px"
    }
  },
  {
    "label": "There is no expenditure at the beginning",
    "expect": {
      "type": "text",
      "selector": "#expense-total",
      "value": "0.00 yuan"
    }
  },
  {
    "label": "Both decimal amounts are included in the total expenditure",
    "expect": {
      "type": "text",
      "selector": "#expense-total",
      "value": "20.00 yuan"
    },
    "actions": [
      {
        "type": "input",
        "selector": "#expense-amount",
        "value": "12.40"
      },
      {
        "type": "click",
        "selector": "#add-expense"
      },
      {
        "type": "input",
        "selector": "#expense-amount",
        "value": "7.60"
      },
      {
        "type": "click",
        "selector": "#add-expense"
      }
    ]
  },
  {
    "label": "The balance is deducted from the total budget and accumulated expenses.",
    "expect": {
      "type": "text",
      "selector": "#expense-remaining",
      "value": "280.00 yuan"
    },
    "actions": [
      {
        "type": "input",
        "selector": "#expense-amount",
        "value": "12.40"
      },
      {
        "type": "click",
        "selector": "#add-expense"
      },
      {
        "type": "input",
        "selector": "#expense-amount",
        "value": "7.60"
      },
      {
        "type": "click",
        "selector": "#add-expense"
      }
    ]
  },
  {
    "label": "Negative input will not change the previous amount",
    "expect": {
      "type": "text",
      "selector": "#expense-total",
      "value": "12.40 yuan"
    },
    "actions": [
      {
        "type": "input",
        "selector": "#expense-amount",
        "value": "12.40"
      },
      {
        "type": "click",
        "selector": "#add-expense"
      },
      {
        "type": "input",
        "selector": "#expense-amount",
        "value": "-3"
      },
      {
        "type": "click",
        "selector": "#add-expense"
      }
    ]
  },
  {
    "label": "prompts error when more than two decimal places",
    "expect": {
      "type": "text",
      "selector": "#expense-error",
      "value": "Please enter an amount greater than 0 and with up to two decimal places."
    },
    "actions": [
      {
        "type": "input",
        "selector": "#expense-amount",
        "value": "4.135"
      },
      {
        "type": "click",
        "selector": "#add-expense"
      }
    ]
  },
  {
    "label": "Prompt error when inputting empty space",
    "expect": {
      "type": "text",
      "selector": "#expense-error",
      "value": "Please enter an amount greater than 0 and with up to two decimal places."
    },
    "actions": [
      {
        "type": "input",
        "selector": "#expense-amount",
        "value": ""
      },
      {
        "type": "click",
        "selector": "#add-expense"
      }
    ]
  },
  {
    "label": "Clear the error message after correcting the input",
    "expect": {
      "type": "text",
      "selector": "#expense-error",
      "value": ""
    },
    "actions": [
      {
        "type": "input",
        "selector": "#expense-amount",
        "value": "-3"
      },
      {
        "type": "click",
        "selector": "#add-expense"
      },
      {
        "type": "input",
        "selector": "#expense-amount",
        "value": "6.50"
      },
      {
        "type": "click",
        "selector": "#add-expense"
      }
    ]
  },
  {
    "label": "Negative balance displayed when overspending",
    "expect": {
      "type": "text",
      "selector": "#expense-remaining",
      "value": "-20.00 yuan"
    },
    "actions": [
      {
        "type": "input",
        "selector": "#expense-amount",
        "value": "320"
      },
      {
        "type": "click",
        "selector": "#add-expense"
      }
    ]
  }
]
