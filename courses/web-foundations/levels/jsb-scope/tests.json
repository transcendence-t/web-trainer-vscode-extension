[
  {
    "label": "Normal mode uses two archive tags",
    "expect": {
      "type": "function",
      "name": "pageLabels",
      "args": [
        "Spring Poster",
        false
      ],
      "value": "Archive-Spring Poster / Archive-Spring Poster"
    }
  },
  {
    "label": "Preview mode returns preview and archive tags at the same time",
    "expect": {
      "type": "function",
      "name": "pageLabels",
      "args": [
        "Spring Poster",
        true
      ],
      "value": "Preview-Spring Poster / Archive-Spring Poster"
    }
  },
  {
    "label": "The preview tag of the second piece refers to the actual title",
    "expect": {
      "type": "function",
      "name": "pageLabels",
      "args": [
        "Opening Program",
        true
      ],
      "value": "Preview-Opening Program / Archive-Opening Program"
    }
  },
  {
    "label": "The second work's normal tag refers to the actual title",
    "expect": {
      "type": "function",
      "name": "pageLabels",
      "args": [
        "Opening Program",
        false
      ],
      "value": "Archive-Opening Program / Archive-Opening Program"
    }
  }
]
