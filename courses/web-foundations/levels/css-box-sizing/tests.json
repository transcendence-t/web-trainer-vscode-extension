[
  {
    "label": "width includes border and padding",
    "expect": {
      "type": "style",
      "selector": ".parcel-label",
      "property": "box-sizing",
      "value": "border-box"
    }
  },
  {
    "label": "Keep padding 10px",
    "expect": {
      "type": "style",
      "selector": ".parcel-label",
      "property": "padding",
      "value": "10px"
    }
  },
  {
    "label": "retains the original 2px solid border",
    "expect": {
      "type": "style",
      "selector": ".parcel-label",
      "property": "border",
      "value": "2px solid rgb(53, 87, 119)"
    }
  },
  {
    "label": "label completely falls in the pallet",
    "expect": {
      "type": "layout",
      "selector": ".parcel-label",
      "relativeTo": ".parcel-slot",
      "relation": "inside"
    }
  },
  {
    "label": "The label is the same width as the actual tray",
    "expect": {
      "type": "layout",
      "selector": ".parcel-label",
      "relativeTo": ".parcel-slot",
      "relation": "equal-width"
    }
  }
]
