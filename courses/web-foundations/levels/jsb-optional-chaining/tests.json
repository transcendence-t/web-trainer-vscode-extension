[
  {
    "label": "contact phone number exists",
    "expect": {
      "type": "function",
      "name": "contactPhone",
      "args": [
        {
          "contact": {
            "phone": "010-78430001"
          }
        }
      ],
      "value": "010-78430001"
    }
  },
  {
    "label": "activity record is empty",
    "expect": {
      "type": "function",
      "name": "contactPhone",
      "args": [
        null
      ],
      "value": "pending registration"
    }
  },
  {
    "label": "Missing contact",
    "expect": {
      "type": "function",
      "name": "contactPhone",
      "args": [
        {}
      ],
      "value": "pending registration"
    }
  },
  {
    "label": "explicit null call remains",
    "expect": {
      "type": "function",
      "name": "contactPhone",
      "args": [
        {
          "contact": {
            "phone": ""
          }
        }
      ],
      "value": ""
    }
  },
  {
    "label": "The contact exists but there is no number",
    "expect": {
      "type": "function",
      "name": "contactPhone",
      "args": [
        {
          "contact": {
            "name": "Xiao Zhou"
          }
        }
      ],
      "value": "pending registration"
    }
  }
]
