[
  {
    "label": "Read out the registered positive vacancies",
    "expect": {
      "type": "function",
      "name": "readFreeSeats",
      "args": [
        {
          "name": "silent zone",
          "freeSeats": 7
        }
      ],
      "value": 7
    }
  },
  {
    "label": "retains number 0 when full",
    "expect": {
      "type": "function",
      "name": "readFreeSeats",
      "args": [
        {
          "name": "Discussion Forum",
          "freeSeats": 0
        }
      ],
      "value": 0
    }
  },
  {
    "label": "The available seats are still unknown when only the total number of seats is available",
    "expect": {
      "type": "function",
      "name": "readFreeSeats",
      "args": [
        {
          "name": "South Study Room",
          "capacity": 12
        }
      ],
      "value": null
    }
  },
  {
    "label": "Empty object has no empty records",
    "expect": {
      "type": "function",
      "name": "readFreeSeats",
      "args": [
        {}
      ],
      "value": null
    }
  }
]
