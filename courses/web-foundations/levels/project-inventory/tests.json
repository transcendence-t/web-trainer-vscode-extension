[
  {
    "label": "Search box associated device name label",
    "expect": {
      "type": "text",
      "selector": "label[for=\"equipment-query\"]",
      "value": "device name"
    }
  },
  {
    "label": "device list uses grid layout",
    "expect": {
      "type": "style",
      "selector": "#equipment-results",
      "property": "display",
      "value": "grid"
    }
  },
  {
    "label": "device entries have 8px gap between them",
    "expect": {
      "type": "style",
      "selector": "#equipment-results",
      "property": "row-gap",
      "value": "8px"
    }
  },
  {
    "label": "displays all devices when opening for the first time",
    "expect": {
      "type": "count",
      "selector": "#equipment-results > li",
      "value": 4
    }
  },
  {
    "label": "found two USB devices after ignoring case and leading and trailing spaces.",
    "expect": {
      "type": "count",
      "selector": "#equipment-results > li",
      "value": 2
    },
    "actions": [
      {
        "type": "input",
        "selector": "#equipment-query",
        "value": " usb "
      }
    ]
  },
  {
    "label": "Display the filtered quantity",
    "expect": {
      "type": "text",
      "selector": "#equipment-count",
      "value": "2 devices found"
    },
    "actions": [
      {
        "type": "input",
        "selector": "#equipment-query",
        "value": " usb "
      }
    ]
  },
  {
    "label": "keywords can appear in the middle of the name",
    "expect": {
      "type": "text",
      "selector": "#equipment-results > li:only-child",
      "value": "digital voice recorder"
    },
    "actions": [
      {
        "type": "input",
        "selector": "#equipment-query",
        "value": "voice"
      }
    ]
  },
  {
    "label": "Remove all results from the previous round when there is no match",
    "expect": {
      "type": "count",
      "selector": "#equipment-results > li",
      "value": 0
    },
    "actions": [
      {
        "type": "input",
        "selector": "#equipment-query",
        "value": "USB"
      },
      {
        "type": "input",
        "selector": "#equipment-query",
        "value": "printer"
      }
    ]
  },
  {
    "label": "The quantity is updated to 0 when there is no match.",
    "expect": {
      "type": "text",
      "selector": "#equipment-count",
      "value": "0 devices found"
    },
    "actions": [
      {
        "type": "input",
        "selector": "#equipment-query",
        "value": "USB"
      },
      {
        "type": "input",
        "selector": "#equipment-query",
        "value": "printer"
      }
    ]
  },
  {
    "label": "Displays an empty result prompt when there is no match",
    "expect": {
      "type": "text",
      "selector": "#equipment-empty:not([hidden])",
      "value": "No matching device"
    },
    "actions": [
      {
        "type": "input",
        "selector": "#equipment-query",
        "value": "printer"
      }
    ]
  },
  {
    "label": "Restore four devices after clearing input",
    "expect": {
      "type": "count",
      "selector": "#equipment-results > li",
      "value": 4
    },
    "actions": [
      {
        "type": "input",
        "selector": "#equipment-query",
        "value": "projection"
      },
      {
        "type": "input",
        "selector": "#equipment-query",
        "value": ""
      }
    ]
  }
]
