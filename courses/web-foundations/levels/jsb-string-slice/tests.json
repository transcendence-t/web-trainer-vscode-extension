[
  {
    "label": "典型六字符票号",
    "expect": {
      "type": "function",
      "name": "lastDigits",
      "args": [
        "LN0018"
      ],
      "value": "0018"
    }
  },
  {
    "label": "长票号仍只显示四位",
    "expect": {
      "type": "function",
      "name": "lastDigits",
      "args": [
        "WORKSHOP10974"
      ],
      "value": "0974"
    }
  },
  {
    "label": "保留三位旧票号",
    "expect": {
      "type": "function",
      "name": "lastDigits",
      "args": [
        "B08"
      ],
      "value": "B08"
    }
  },
  {
    "label": "空字符串仍为空",
    "expect": {
      "type": "function",
      "name": "lastDigits",
      "args": [
        ""
      ],
      "value": ""
    }
  }
]
