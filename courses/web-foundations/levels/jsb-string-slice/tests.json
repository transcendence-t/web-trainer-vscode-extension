[
  {
    "label": "Typical six-character ticket number",
    "expect": {
      "type": "function",
      "name": "lastDigits",
      "args": [
        "LN0018"
      ],
      "value": "0018"
    }
  },
  {
    "label": "long ticket number still only shows four digits",
    "expect": {
      "type": "function",
      "name": "lastDigits",
      "args": [
        "WORKSHOP10974"
      ],
      "value": "0974"
    }
  },
  {
    "label": "retains the three-digit old ticket number",
    "expect": {
      "type": "function",
      "name": "lastDigits",
      "args": [
        "B08"
      ],
      "value": "B08"
    }
  },
  {
    "label": "empty string remains empty",
    "expect": {
      "type": "function",
      "name": "lastDigits",
      "args": [
        ""
      ],
      "value": ""
    }
  }
]
