  {
    "label": "rear inspection protective cover",
    "expect": {
      "type": "text",
      "selector": "#checklist li:first-child > ul > li:last-child",
      "value": "protective case"
    }
  },
  {
    "label": "The last step is to submit the record",
    "expect": {
      "type": "text",
      "selector": "#checklist > li:last-child",
      "value": "Submit record"
