[
  {
    "label": "Preserves the topic as entered",
    "expect": {
      "type": "function",
      "name": "labelTopic",
      "args": [
        "Web Layout"
      ],
      "value": "[Web Layout]"
    }
  },
  {
    "label": "text are still visible",
    "expect": {
      "type": "function",
      "name": "labelTopic",
      "args": [
        "007"
      ],
      "value": "[007]"
    }
  },
  {
    "label": "The empty topic also has a pair of brackets",
    "expect": {
      "type": "function",
      "name": "labelTopic",
      "args": [
        ""
      ],
      "value": "[]"
    }
  },
  {
    "label": "Keep spaces on both sides of the topic",
    "expect": {
      "type": "function",
      "name": "labelTopic",
      "args": [
        " display job "
      ],
      "value": "[ display job ]"
    }
  }
]
