[
  {
    "label": "Ignore empty items generated by input",
    "expect": {
      "type": "function",
      "name": "labelLine",
      "args": [
        " Handmade, , Painting, Light and Shadow "
      ],
      "value": "Handmade / Painting / Light and Shadow"
    }
  },
  {
    "label": "Remove all empty items",
    "expect": {
      "type": "function",
      "name": "labelLine",
      "args": [
        ", ,"
      ],
      "value": ""
    }
  },
  {
    "label": "No delimiter when retaining only one label",
    "expect": {
      "type": "function",
      "name": "labelLine",
      "args": [
        "books,"
      ],
      "value": "books"
    }
  },
  {
    "label": "retains duplicate labels and order",
    "expect": {
      "type": "function",
      "name": "labelLine",
      "args": [
        "A,B,A"
      ],
      "value": "A / B / A"
    }
  }
]
