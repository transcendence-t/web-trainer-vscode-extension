[
  {
    "label": "has only one main title",
    "expect": {
      "type": "count",
      "selector": "main h1",
      "value": 1
    }
  },
  {
    "label": "Two columns at the same level",
    "expect": {
      "type": "count",
      "selector": "main h2",
      "value": 2
    }
  },
  {
    "label": "Sign-in is the first column",
