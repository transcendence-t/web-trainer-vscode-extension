  {
    "label": "re-signing is located between the two columns",
    "expect": {
      "type": "text",
      "selector": "h2 + p + h3",
      "value": "re-signing"
    }
  },
  {
    "label": "Card collection is the next column of the same level",
    "expect": {
      "type": "text",
      "selector": "h3 + p + h2",
      "value": "Card collection arrangement"
    }
  }
