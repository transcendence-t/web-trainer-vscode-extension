[
  {
    "label": "uses light color base by default",
    "expect": {
      "type": "style",
      "selector": "#reader",
      "property": "background-color",
      "value": "rgb(255, 255, 255)"
    }
  },
  {
    "label": "Click to switch to dark background",
    "expect": {
      "type": "style",
      "selector": "#reader",
      "property": "background-color",
      "value": "rgb(21, 36, 58)"
    },
    "actions": [
      {
        "type": "click",
        "selector": "#theme-toggle"
      }
    ]
  },
  {
    "label": "Dark mode retains clear text",
    "expect": {
      "type": "style",
      "selector": "#reader",
      "property": "color",
      "value": "rgb(240, 244, 248)"
    },
    "actions": [
      {
        "type": "click",
        "selector": "#theme-toggle"
      }
    ]
  },
  {
    "label": "pressed state and dark color selection synchronization",
    "expect": {
      "type": "attribute",
      "selector": "#theme-toggle",
      "name": "aria-pressed",
      "value": "true"
    },
    "actions": [
      {
        "type": "click",
        "selector": "#theme-toggle"
      }
    ]
  },
  {
    "label": "Dark color selection is saved in this level",
    "expect": {
      "type": "storage",
      "key": "reader-theme",
      "value": "dark"
    },
    "actions": [
      {
        "type": "click",
        "selector": "#theme-toggle"
      }
    ]
  },
  {
    "label": "Saved dark theme restored on open",
    "expect": {
      "type": "attribute",
      "selector": "#theme-toggle",
      "name": "aria-pressed",
      "value": "true"
    },
    "storage": {
      "reader-theme": "dark"
    }
  },
  {
    "label": "Click again to save light color selection",
    "expect": {
      "type": "storage",
      "key": "reader-theme",
      "value": "light"
    },
    "storage": {
      "reader-theme": "dark"
    },
    "actions": [
      {
        "type": "click",
        "selector": "#theme-toggle"
      }
    ]
  }
]
