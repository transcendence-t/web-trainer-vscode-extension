[
  {
    "label": "Calculate the filling volume of four drinks",
    "expect": {
      "type": "function",
      "name": "drinkVolume",
      "args": [
        4,
        125
      ],
      "value": 500
    }
  },
  {
    "label": "The filling volume of zero cup is zero",
    "expect": {
      "type": "function",
      "name": "drinkVolume",
      "args": [
        0,
        125
      ],
      "value": 0
    }
  },
  {
    "label": "The filling volume of one cup is equal to the capacity of a single cup",
    "expect": {
      "type": "function",
      "name": "drinkVolume",
      "args": [
        1,
        220
      ],
      "value": 220
    }
  },
  {
    "label": "For eight cups, add 200 ml for later use",
    "expect": {
      "type": "function",
      "name": "prepareVolume",
      "args": [
        8,
        150,
        200
      ],
      "value": 1400
    }
  },
  {
    "label": "Zero cup is still included in the reserve amount",
    "expect": {
      "type": "function",
      "name": "prepareVolume",
      "args": [
        0,
        180,
        300
      ],
      "value": 300
    }
  },
  {
    "label": "When the reserve quantity is zero, only the filling quantity is calculated.",
    "expect": {
      "type": "function",
      "name": "prepareVolume",
      "args": [
        3,
        200,
        0
      ],
      "value": 600
    }
  },
  {
    "label": "The filling amount and spare amount of one cup are included separately.",
    "expect": {
      "type": "function",
      "name": "prepareVolume",
      "args": [
        1,
        80,
        30
      ],
      "value": 110
    }
  }
]
