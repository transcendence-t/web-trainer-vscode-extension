[
  {
    "label": "remains unchanged.",
    "expect": {
      "type": "function",
      "name": "uniqueCodes",
      "args": [
        [
          "B",
          "A",
          "B",
          "C",
          "A"
        ]
      ],
      "value": [
        "B",
        "A",
        "C"
      ]
    }
  },
  {
    "label": "Different types have different codes.",
    "expect": {
      "type": "function",
      "name": "uniqueCodes",
      "args": [
        [
          4,
          "4",
          4
        ]
      ],
      "value": [
        4,
        "4"
      ]
    }
  },
  {
    "label": "empty list returns empty array",
    "expect": {
      "type": "function",
      "name": "uniqueCodes",
      "args": [
        []
      ],
      "value": []
    }
  }
]
