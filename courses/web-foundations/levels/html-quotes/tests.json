[
  {
    "label": "The entire quotation is placed in blockquote",
    "expect": {
      "type": "text",
      "selector": "blockquote p",
      "value": "Document findings first, discuss explanations later."
    }
  },
  {
    "label": "retains the citation source URL",
    "expect": {
      "type": "attribute",
      "selector": "blockquote",
      "name": "cite",
      "value": "https://example.org/observation"
    }
  },
  {
    "label": "Mark the title of the work",
    "expect": {
      "type": "text",
      "selector": "p cite",
      "value": "\"Community Observation Manual\""
    }
  },
  {
    "label": "Mark short quotations within sentences",
    "expect": {
      "type": "text",
      "selector": "p q",
      "value": "Pay attention to the changes around you"
    }
  }
]
