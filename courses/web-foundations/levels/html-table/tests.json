[
  {
    "label": "uses only one table",
    "expect": {
      "type": "count",
      "selector": "table",
      "value": 1
    }
  },
  {
    "label": "table has two records",
    "expect": {
      "type": "count",
      "selector": "table > tbody > tr",
      "value": 2
    }
  },
  {
    "label": "There are four data cells in two rows",
    "expect": {
      "type": "count",
      "selector": "table > tbody > tr > td",
      "value": 4
    }
  },
  {
    "label": "The first row and first column are mint",
    "expect": {
      "type": "text",
      "selector": "table > tbody > tr:first-child > td:nth-child(1)",
      "value": "Mint"
    }
  },
  {
    "label": "The first row and second column are 6 pots",
    "expect": {
      "type": "text",
      "selector": "table > tbody > tr:first-child > td:nth-child(2)",
      "value": "6 basins"
    }
  },
  {
    "label": "The second row and the first column are basil",
    "expect": {
      "type": "text",
      "selector": "table > tbody > tr:last-child > td:nth-child(1)",
      "value": "Basil"
    }
  },
  {
    "label": "The second row and second column are 4 pots",
    "expect": {
      "type": "text",
      "selector": "table > tbody > tr:last-child > td:nth-child(2)",
      "value": "4 basins"
    }
  }
]
