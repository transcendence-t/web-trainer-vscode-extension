[
  {
    "label": "Adjacent borders merge",
    "expect": {
      "type": "style",
      "selector": "table",
      "property": "border-collapse",
      "value": "collapse"
    }
  },
  {
    "label": "There is a cell border in the header",
    "expect": {
      "type": "style",
      "selector": "th",
      "property": "border-top",
      "value": "1px solid rgb(154, 169, 181)"
    }
  },
  {
    "label": "data grid leaves inner margins",
    "expect": {
      "type": "style",
      "selector": "td",
      "property": "padding-left",
      "value": "8px"
    }
  },
  {
    "label": "number column right aligned",
    "expect": {
      "type": "style",
      "selector": "td.code",
      "property": "text-align",
      "value": "right"
    }
  }
]
