[
  {
    "label": "static display when reducing dynamic effects",
    "expect": {
      "type": "style",
      "selector": ".signal",
      "property": "animation-name",
      "value": "none",
      "media": {
        "query": "(prefers-reduced-motion: reduce)",
        "matches": true
      }
    }
  },
  {
    "label": "Normal state still has fade-in animation",
    "expect": {
      "type": "style",
      "selector": ".signal",
      "property": "animation-name",
      "value": "fade-in",
      "media": {
        "query": "(prefers-reduced-motion: reduce)",
        "matches": false
      }
    }
  },
  {
    "label": "Status remains readable when reducing animation effects",
    "expect": {
      "type": "style",
      "selector": ".signal",
      "property": "opacity",
      "value": "1",
      "media": {
        "query": "(prefers-reduced-motion: reduce)",
        "matches": true
      }
    }
  }
]
