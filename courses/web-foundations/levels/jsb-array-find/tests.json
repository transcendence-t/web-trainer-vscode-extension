[
  {
    "label": "For repeated numbers, take the first one",
    "expect": {
      "type": "function",
      "name": "findRecord",
      "args": [
        [
          {
            "id": "A7",
            "room": "Wood Workshop"
          },
          {
            "id": "A7",
            "room": "Service Desk"
          }
        ],
        "A7"
      ],
      "value": {
        "id": "A7",
        "room": "Wood Workshop"
      }
    }
  },
  {
    "label": "Skip other records by id",
    "expect": {
      "type": "function",
      "name": "findRecord",
      "args": [
        [
          {
            "id": "B1"
          },
          {
            "id": "B2",
            "room": "front desk"
          }
        ],
        "B2"
      ],
      "value": {
        "id": "B2",
        "room": "front desk"
      }
    }
  },
  {
    "label": "not found returns null",
    "expect": {
      "type": "function",
      "name": "findRecord",
      "args": [
        [
          {
            "id": 7
          }
        ],
        "7"
      ],
      "value": null
    }
  },
  {
    "label": "empty array returns null",
    "expect": {
      "type": "function",
      "name": "findRecord",
      "args": [
        [],
        "A7"
      ],
      "value": null
    }
  }
]
