[
  {
    "label": "The introduction area has the name as the main title",
    "expect": {
      "type": "text",
      "selector": "header.profile-intro h1",
      "value": "Linxi"
    }
  },
  {
    "label": "There is a section about me in the main body",
    "expect": {
      "type": "text",
      "selector": "main.profile-content > section#about h2",
      "value": "About me"
    }
  },
  {
    "label": "There are sections of works in the main body",
    "expect": {
      "type": "text",
      "selector": "main.profile-content > section#work h2",
      "value": "works"
    }
  },
  {
    "label": "works list has two entries",
    "expect": {
      "type": "count",
      "selector": "section#work ul > li",
      "value": 2
    }
  },
  {
    "label": "Click to view the works and locate the works area",
    "expect": {
      "type": "exists",
      "selector": "section#work:target"
    },
    "actions": [
      {
        "type": "click",
        "selector": "#work-link"
      }
    ]
  },
  {
    "label": "The top area of the page uses a light green background",
    "expect": {
      "type": "style",
      "selector": ".profile-intro",
      "property": "background-color",
      "value": "rgb(226, 241, 235)"
    }
  },
  {
    "label": "The header area has 20px top padding",
    "expect": {
      "type": "style",
      "selector": ".profile-intro",
      "property": "padding-top",
      "value": "20px"
    }
  },
  {
    "label": "The header area has 20px right padding",
    "expect": {
      "type": "style",
      "selector": ".profile-intro",
      "property": "padding-right",
      "value": "20px"
    }
  },
  {
    "label": "The header area has 20px lower padding",
    "expect": {
      "type": "style",
      "selector": ".profile-intro",
      "property": "padding-bottom",
      "value": "20px"
    }
  },
  {
    "label": "The header area has 20px left padding",
    "expect": {
      "type": "style",
      "selector": ".profile-intro",
      "property": "padding-left",
      "value": "20px"
    }
  }
]
