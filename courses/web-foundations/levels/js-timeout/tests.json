[
  {
    "label": "The page is still waiting to be generated when not clicked",
    "expect": {
      "type": "text",
      "selector": "#receipt-status",
      "value": "waiting to be generated"
    },
    "actions": [
      {
        "type": "wait",
        "ms": 700
      }
    ]
  },
  {
    "label": "The waiting process will appear within a short time after clicking.",
    "expect": {
      "type": "text",
      "selector": "#receipt-status",
      "value": "Generating receipt"
    },
    "actions": [
      {
        "type": "click",
        "selector": "#generate-receipt"
      },
      {
        "type": "wait",
        "ms": 60
      }
    ]
  },
  {
    "label": "Lock the generate button while waiting",
    "expect": {
      "type": "exists",
      "selector": "#generate-receipt[disabled]"
    },
    "actions": [
      {
        "type": "click",
        "selector": "#generate-receipt"
      },
      {
        "type": "wait",
        "ms": 60
      }
    ]
  },
  {
    "label": "Completion prompt appears after delay",
    "expect": {
      "type": "text",
      "selector": "#receipt-status",
      "value": "receipt has been generated"
    },
    "actions": [
      {
        "type": "click",
        "selector": "#generate-receipt"
      },
      {
        "type": "wait",
        "ms": 1100
      }
    ]
  },
  {
    "label": "button can be retried after the receipt is generated",
    "expect": {
      "type": "exists",
      "selector": "#generate-receipt:not([disabled])"
    },
    "actions": [
      {
        "type": "click",
        "selector": "#generate-receipt"
      },
      {
        "type": "wait",
        "ms": 1100
      }
    ]
  }
]
