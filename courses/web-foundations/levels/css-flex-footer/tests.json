[
  {
    "label": "page meets the lower height limit",
    "expect": {
      "type": "style",
      "selector": "body",
      "property": "min-height",
      "value": "360px"
    }
  },
  {
    "label": "Use vertical Flex to arrange page areas",
    "expect": {
      "type": "style",
      "selector": "body",
      "property": "flex-direction",
      "value": "column"
    }
  },
  {
    "label": "main body can grow",
    "expect": {
      "type": "style",
      "selector": "main",
      "property": "flex-grow",
      "value": "1"
    }
  },
  {
    "label": "The footer follows the content and does not cover it",
    "expect": {
      "type": "layout",
      "selector": "footer",
      "relativeTo": "main",
      "relation": "below"
    }
  },
  {
    "label": "footer still in normal document flow",
    "expect": {
      "type": "style",
      "selector": "footer",
      "property": "position",
      "value": "static"
    }
  }
]
