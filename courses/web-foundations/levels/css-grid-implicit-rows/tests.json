      "property": "height",
      "value": "64px"
    }
  },
  {
    "label": "Second line height 40px",
    "expect": {
      "type": "style",
      "selector": "#c",
      "property": "height",
      "value": "40px"
    }
  },
  {
    "label": "The third line automatically obeys the height",
    "expect": {
      "type": "style",
      "selector": "#e",
      "property": "height",
      "value": "40px"
    }
  },
  {
    "label": "The third line is still after the second line",
    "expect": {
      "type": "layout",
      "selector": "#e",
