[
  {
    "label": "Put into storage first and then out of storage",
    "expect": {
      "type": "function",
      "name": "updateStock",
      "args": [
        12,
        5,
        3
      ],
      "value": 14
    }
  },
  {
    "label": "starts warehousing from zero inventory",
    "expect": {
      "type": "function",
      "name": "updateStock",
      "args": [
        0,
        7,
        0
      ],
      "value": 7
    }
  },
  {
    "label": "Returns value 0 after all goods are shipped out of the warehouse",
    "expect": {
      "type": "function",
      "name": "updateStock",
      "args": [
        8,
        0,
        8
      ],
      "value": 0
    }
  },
  {
    "label": "The goods entering the warehouse can also be shipped out this time.",
    "expect": {
      "type": "function",
      "name": "updateStock",
      "args": [
        2,
        6,
        5
      ],
      "value": 3
    }
  }
]
