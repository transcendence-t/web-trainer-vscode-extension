[
  {
    "label": "Two columns of equal width",
    "expect": {
      "type": "layout",
      "selector": "#short",
      "relativeTo": "#long",
      "relation": "equal-width"
    }
  },
  {
    "label": "The second column is still inside the container",
    "expect": {
      "type": "layout",
      "selector": "#short",
      "relativeTo": ".documents",
      "relation": "inside"
    }
  },
  {
    "label": "File names can have lines broken in the middle",
    "expect": {
      "type": "style",
      "selector": "#long",
      "property": "overflow-wrap",
      "value": "anywhere"
    }
  },
  {
    "label": "long title card width 130px",
    "expect": {
      "type": "style",
      "selector": "#long",
      "property": "width",
      "value": "130px"
    }
  }
]
