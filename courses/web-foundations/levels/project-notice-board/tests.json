[
  {
    "label": "immediately enters the waiting state after clicking",
    "expect": {
      "type": "text",
      "selector": "#state",
      "value": "Loading"
    },
    "actions": [
      {
        "type": "click",
        "selector": "#refresh"
      }
    ]
  },
  {
    "label": "Prevent repeated requests while waiting",
    "expect": {
      "type": "property",
      "selector": "#refresh",
      "name": "disabled",
      "value": true
    },
    "actions": [
      {
        "type": "click",
        "selector": "#refresh"
      }
    ]
  },
  {
    "label": "successful feedback data amount",
    "expect": {
      "type": "text",
      "selector": "#state",
      "value": "Loaded 2 notices"
    },
    "actions": [
      {
        "type": "input",
        "selector": "#demo",
        "value": "main"
      },
      {
        "type": "click",
        "selector": "#refresh"
      },
      {
        "type": "wait",
        "ms": 350
      }
    ]
  },
  {
    "label": "Titles containing angle brackets are displayed as text",
    "expect": {
      "type": "text",
      "selector": "#notices li:last-child",
      "value": "<Review> Purchase List · Equipment Library"
    },
    "actions": [
      {
        "type": "input",
        "selector": "#demo",
        "value": "main"
      },
      {
        "type": "click",
        "selector": "#refresh"
      },
      {
        "type": "wait",
        "ms": 350
      }
    ]
  },
  {
    "label": "empty data has its own prompt",
    "expect": {
      "type": "text",
      "selector": "#state",
      "value": "No notification yet"
    },
    "actions": [
      {
        "type": "input",
        "selector": "#demo",
        "value": "empty"
      },
      {
        "type": "click",
        "selector": "#refresh"
      },
      {
        "type": "wait",
        "ms": 350
      }
    ]
  },
  {
    "label": "Prompt to try again when error occurs",
    "expect": {
      "type": "text",
      "selector": "#state",
      "value": "Unable to read notification, please try again"
    },
    "actions": [
      {
        "type": "input",
        "selector": "#demo",
        "value": "error"
      },
      {
        "type": "click",
        "selector": "#refresh"
      },
      {
        "type": "wait",
        "ms": 350
      }
    ]
  },
  {
    "label": "Button is available again in case of error",
    "expect": {
      "type": "property",
      "selector": "#refresh",
      "name": "disabled",
      "value": false
    },
    "actions": [
      {
        "type": "input",
        "selector": "#demo",
        "value": "error"
      },
      {
        "type": "click",
        "selector": "#refresh"
      },
      {
        "type": "wait",
        "ms": 350
      }
    ]
  },
  {
    "label": "can be loaded successfully after switching back from the error sample",
    "expect": {
      "type": "count",
      "selector": "#notices li",
      "value": 2
    },
    "actions": [
      {
        "type": "input",
        "selector": "#demo",
        "value": "error"
      },
      {
        "type": "click",
        "selector": "#refresh"
      },
      {
        "type": "wait",
        "ms": 350
      },
      {
        "type": "input",
        "selector": "#demo",
        "value": "main"
      },
      {
        "type": "click",
        "selector": "#refresh"
      },
      {
        "type": "wait",
        "ms": 350
      }
    ]
  },
  {
    "label": "Remove old notifications when switching to empty list",
    "expect": {
      "type": "count",
      "selector": "#notices li",
      "value": 0
    },
    "actions": [
      {
        "type": "click",
        "selector": "#refresh"
      },
      {
        "type": "wait",
        "ms": 350
      },
      {
        "type": "input",
        "selector": "#demo",
        "value": "empty"
      },
      {
        "type": "click",
        "selector": "#refresh"
      },
      {
        "type": "wait",
        "ms": 350
      }
    ]
  }
]
