[
  {
    "label": "same number",
    "expect": {
      "type": "function",
      "name": "sameSerial",
      "args": [
        7,
        7
      ],
      "value": true
    }
  },
  {
    "label": "different types of numbers",
    "expect": {
      "type": "function",
      "name": "sameSerial",
      "args": [
        7,
        "7"
      ],
      "value": false
    }
  },
  {
    "label": "different leading zeros",
    "expect": {
      "type": "function",
      "name": "sameSerial",
      "args": [
        "07",
        "7"
      ],
      "value": false
    }
  },
  {
    "label": "Same string number",
    "expect": {
      "type": "function",
      "name": "sameSerial",
      "args": [
        "A3",
        "A3"
      ],
      "value": true
    }
  }
]
