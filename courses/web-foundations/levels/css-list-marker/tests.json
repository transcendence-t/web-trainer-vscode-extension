[
  {
    "label": "The first item symbol turns green",
    "expect": {
      "type": "style",
      "selector": ".gear li:first-child",
      "property": "color",
      "value": "rgb(18, 90, 70)",
      "pseudo": "::marker"
    }
  },
  {
    "label": "The second symbol also turns green",
    "expect": {
      "type": "style",
      "selector": ".gear li:last-child",
      "property": "color",
      "value": "rgb(18, 90, 70)",
      "pseudo": "::marker"
    }
  },
  {
    "label": "The text still uses the original color",
    "expect": {
      "type": "style",
      "selector": ".gear li",
      "property": "color",
      "value": "rgb(36, 52, 71)"
    }
  },
  {
    "label": "retains the default dots",
    "expect": {
      "type": "style",
      "selector": ".gear li",
      "property": "list-style-type",
      "value": "disc"
    }
  }
]
