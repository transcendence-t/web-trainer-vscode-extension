      "args": [
        7,
        7
      ],
      "value": [
        7,
        7,
        8,
        8
      ]
    }
  },
  {
    "label": "可从零开始编号",
    "expect": {
      "type": "function",
      "name": "showTickets",
      "args": [
        0,
        100
