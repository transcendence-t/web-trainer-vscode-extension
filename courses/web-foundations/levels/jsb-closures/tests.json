[
  {
    "label": "Alternate number taking and independent increase",
    "expect": {
      "type": "function",
      "name": "showTickets",
      "args": [
        10,
        30
      ],
      "value": [
        10,
        30,
        11,
        31
      ]
    }
  },
  {
    "label": "The two initial numbers are the same and will grow separately.",
    "expect": {
      "type": "function",
      "name": "showTickets",
      "args": [
        7,
        7
      ],
      "value": [
        7,
        7,
        8,
        8
      ]
    }
  },
  {
    "label": "can be numbered from zero",
    "expect": {
      "type": "function",
      "name": "showTickets",
      "args": [
        0,
        100
      ],
      "value": [
        0,
        100,
        1,
        101
      ]
    }
  }
]
