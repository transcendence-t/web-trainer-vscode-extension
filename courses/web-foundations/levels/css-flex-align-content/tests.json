[
  {
    "label": "Allocate white space between lines",
    "expect": {
      "type": "style",
      "selector": ".cabinet",
      "property": "align-content",
      "value": "space-between"
    }
  },
  {
    "label": "The first two boxes are still in one row",
    "expect": {
      "type": "layout",
      "selector": "#mask",
      "relativeTo": "#gloves",
      "relation": "same-row"
    }
  },
  {
    "label": "Start a new line in the third box",
    "expect": {
      "type": "layout",
      "selector": "#cloth",
      "relativeTo": "#gloves",
      "relation": "below"
    }
  },
  {
    "label": "bottom row remains in the cabinet",
    "expect": {
      "type": "layout",
      "selector": "#goggles",
      "relativeTo": ".cabinet",
      "relation": "inside"
    }
  }
]
