[
  {
    "label": "Initial descriptionCollapse",
    "expect": {
      "type": "style",
      "selector": "#loan-guide[hidden]",
      "property": "display",
      "value": "none"
    }
  },
  {
    "label": "Initial button reportCollapse",
    "expect": {
      "type": "attribute",
      "selector": "#toggle-guide",
      "name": "aria-expanded",
      "value": "false"
    }
  },
  {
    "label": "The description is visible after clicking the button",
    "expect": {
      "type": "style",
      "selector": "#loan-guide:not([hidden])",
      "property": "display",
      "value": "block"
    },
    "actions": [
      {
        "type": "click",
        "selector": "#toggle-guide"
      }
    ]
  },
  {
    "label": "button report expands after opening",
    "expect": {
      "type": "attribute",
      "selector": "#toggle-guide",
      "name": "aria-expanded",
      "value": "true"
    },
    "actions": [
      {
        "type": "click",
        "selector": "#toggle-guide"
      }
    ]
  },
  {
    "label": "Click again to close the description.",
    "expect": {
      "type": "style",
      "selector": "#loan-guide[hidden]",
      "property": "display",
      "value": "none"
    },
    "actions": [
      {
        "type": "click",
        "selector": "#toggle-guide"
      },
      {
        "type": "click",
        "selector": "#toggle-guide"
      }
    ]
  },
  {
    "label": "synchronizes the recovery button state after collapsing",
    "expect": {
      "type": "attribute",
      "selector": "#toggle-guide",
      "name": "aria-expanded",
      "value": "false"
    },
    "actions": [
      {
        "type": "click",
        "selector": "#toggle-guide"
      },
      {
        "type": "click",
        "selector": "#toggle-guide"
      }
    ]
  }
]
