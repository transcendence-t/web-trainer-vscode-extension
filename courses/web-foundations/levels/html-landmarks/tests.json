[
  {
    "label": "Header retains page title",
    "expect": {
      "type": "text",
      "selector": ".sheet > header h1",
      "value": "Riverside night run"
    }
  },
  {
    "label": "Navigation link within header points to rendezvous point",
    "expect": {
      "type": "text",
      "selector": ".sheet > header nav a[href=\"#meeting\"]",
      "value": "View meeting point"
    }
  },
  {
    "label": "page has a main",
    "expect": {
      "type": "count",
      "selector": "main",
      "value": 1
    }
  },
  {
    "label": "The assembly point in the text retains the anchor point",
    "expect": {
      "type": "text",
      "selector": ".sheet > header + main h2#meeting",
      "value": "meeting point"
    }
  },
  {
    "label": "The footer follows the main text and retains the maintainer information.",
    "expect": {
      "type": "text",
      "selector": ".sheet > main + footer p",
      "value": "Riverside Running Group Maintenance"
    }
  }
]
