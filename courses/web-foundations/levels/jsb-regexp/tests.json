[
  {
    "label": "matches two uppercase letters and three numbers",
    "expect": {
      "type": "function",
      "name": "validLabel",
      "args": [
        "MP-026"
      ],
      "value": true
    }
  },
  {
    "label": "allows leading zeros",
    "expect": {
      "type": "function",
      "name": "validLabel",
      "args": [
        "AB-000"
      ],
      "value": true
    }
  },
  {
    "label": "rejects lowercase letters",
    "expect": {
      "type": "function",
      "name": "validLabel",
      "args": [
        "Ab-209"
      ],
      "value": false
    }
  },
  {
    "label": "Insufficient digits to reject",
    "expect": {
      "type": "function",
      "name": "validLabel",
      "args": [
        "AB-29"
      ],
      "value": false
    }
  },
  {
    "label": "rejects prefixes and extra spaces",
    "expect": {
      "type": "function",
      "name": "validLabel",
      "args": [
        "xAB-209 "
      ],
      "value": false
    }
  },
  {
    "label": "Reject extra digits",
    "expect": {
      "type": "function",
      "name": "validLabel",
      "args": [
        "AB-2001"
      ],
      "value": false
    }
  }
]
