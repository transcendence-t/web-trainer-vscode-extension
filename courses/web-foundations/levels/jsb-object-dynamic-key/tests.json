[
  {
    "label": "Read hyphenated fields",
    "expect": {
      "type": "function",
      "name": "readField",
      "args": [
        {
          "rack-id": "B7"
        },
        "rack-id"
      ],
      "value": "B7"
    }
  },
  {
    "label": "zero is an existing value",
    "expect": {
      "type": "function",
      "name": "readField",
      "args": [
        {
          "count": 0
        },
        "count"
      ],
      "value": 0
    }
  },
  {
    "label": "reserved false",
    "expect": {
      "type": "function",
      "name": "readField",
      "args": [
        {
          "done": false
        },
        "done"
      ],
      "value": false
    }
  },
  {
    "label": "empty string is also data",
    "expect": {
      "type": "function",
      "name": "readField",
      "args": [
        {
          "note": ""
        },
        "note"
      ],
      "value": ""
    }
  },
  {
    "label": "does not exist field",
    "expect": {
      "type": "function",
      "name": "readField",
      "args": [
        {
          "id": 3
        },
        "name"
      ],
      "value": null
    }
  },
  {
    "label": "Inherited members are not counted as data",
    "expect": {
      "type": "function",
      "name": "readField",
      "args": [
        {},
        "constructor"
      ],
      "value": null
    }
  }
]
