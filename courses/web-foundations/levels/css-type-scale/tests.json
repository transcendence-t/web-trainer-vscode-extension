[
  {
    "label": "encoding font weight is 600",
    "expect": {
      "type": "style",
      "selector": ".serial",
      "property": "font-weight",
      "value": "600"
    }
  },
  {
    "label": "character interval increased by 2px",
    "expect": {
      "type": "style",
      "selector": ".serial",
      "property": "letter-spacing",
      "value": "2px"
    }
  },
  {
    "label": "encoding is still 16px",
    "expect": {
      "type": "style",
      "selector": ".serial",
      "property": "font-size",
      "value": "16px"
    }
  },
  {
    "label": "indicates that no additional kerning is required.",
    "expect": {
      "type": "style",
      "selector": ".description",
      "property": "letter-spacing",
      "value": "normal"
    }
  }
]
