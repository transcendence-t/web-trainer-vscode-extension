[
  {
    "label": "arrays are classified separately",
    "expect": {
      "type": "function",
      "name": "kindOf",
      "args": [
        []
      ],
      "value": "array"
    }
  },
  {
    "label": "null separate classification",
    "expect": {
      "type": "function",
      "name": "kindOf",
      "args": [
        null
      ],
      "value": "null"
    }
  },
  {
    "label": "common object",
    "expect": {
      "type": "function",
      "name": "kindOf",
      "args": [
        {}
      ],
      "value": "object"
    }
  },
  {
    "label": "No parameters passed in",
    "expect": {
      "type": "function",
      "name": "kindOf",
      "args": [],
      "value": "undefined"
    }
  },
  {
    "label": "Boolean value",
    "expect": {
      "type": "function",
      "name": "kindOf",
      "args": [
        false
      ],
      "value": "boolean"
    }
  },
  {
    "label": "string numbers are still strings",
    "expect": {
      "type": "function",
      "name": "kindOf",
      "args": [
        "12"
      ],
      "value": "string"
    }
  }
]
