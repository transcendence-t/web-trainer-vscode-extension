[
  {
    "label": "翻面按钮关联答案区域",
    "expect": {
      "type": "attribute",
      "selector": "#flip-card",
      "name": "aria-controls",
      "value": "card-answer"
    }
  },
  {
    "label": "卡片的最小高度为 108px",
    "expect": {
      "type": "style",
      "selector": ".study-card",
      "property": "min-height",
      "value": "108px"
    }
  },
  {
    "label": "初次进入显示第一张卡的题目面",
    "expect": {
      "type": "text",
      "selector": "#card-question:not([hidden])",
      "value": "哪个 HTML 标签表示超链接？"
    }
  },
  {
    "label": "初始隐藏答案",
    "expect": {
      "type": "style",
      "selector": "#card-answer[hidden]",
      "property": "display",
      "value": "none"
    }
  },
  {
    "label": "第一次翻面显示对应答案",
    "expect": {
      "type": "text",
      "selector": "#card-answer:not([hidden])",
      "value": "<a>"
    },
    "actions": [
      {
        "type": "click",
        "selector": "#flip-card"
      }
    ]
  },
  {
    "label": "答案面不会同时显示题目",
    "expect": {
      "type": "style",
      "selector": "#card-question[hidden]",
      "property": "display",
      "value": "none"
    },
    "actions": [
      {
        "type": "click",
        "selector": "#flip-card"
      }
    ]
  },
  {
    "label": "同一张卡翻回时恢复题目",
    "expect": {
      "type": "text",
      "selector": "#card-question:not([hidden])",
      "value": "哪个 HTML 标签表示超链接？"
    },
    "actions": [
      {
        "type": "click",
        "selector": "#flip-card"
      },
      {
        "type": "click",
        "selector": "#flip-card"
      }
    ]
  },
  {
    "label": "从答案面换卡后显示第二张题目",
    "expect": {
      "type": "text",
      "selector": "#card-question:not([hidden])",
      "value": "哪个 CSS 属性设置文字颜色？"
    },
    "actions": [
      {
        "type": "click",
        "selector": "#flip-card"
      },
      {
        "type": "click",
        "selector": "#next-card"
      }
    ]
  },
  {
    "label": "换卡后答案重新隐藏",
    "expect": {
      "type": "style",
      "selector": "#card-answer[hidden]",
      "property": "display",
      "value": "none"
    },
    "actions": [
      {
        "type": "click",
        "selector": "#flip-card"
      },
      {
        "type": "click",
        "selector": "#next-card"
      }
    ]
  },
  {
    "label": "换卡后翻面显示的是第二张答案",
    "expect": {
      "type": "text",
      "selector": "#card-answer:not([hidden])",
      "value": "color"
    },
    "actions": [
      {
        "type": "click",
        "selector": "#flip-card"
      },
      {
        "type": "click",
        "selector": "#next-card"
      },
      {
        "type": "click",
        "selector": "#flip-card"
      }
    ]
  },
  {
    "label": "连续换过三张后回到第一张",
    "expect": {
      "type": "text",
      "selector": "#card-position",
      "value": "第 1 / 3 张"
    },
    "actions": [
      {
        "type": "click",
        "selector": "#next-card"
      },
      {
        "type": "click",
        "selector": "#next-card"
      },
      {
        "type": "click",
        "selector": "#next-card"
      }
    ]
  }
]
