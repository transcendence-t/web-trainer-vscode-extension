[
  {
    "label": "Flip button associated answer area",
    "expect": {
      "type": "attribute",
      "selector": "#flip-card",
      "name": "aria-controls",
      "value": "card-answer"
    }
  },
  {
    "label": "card is 108px",
    "expect": {
      "type": "style",
      "selector": ".study-card",
      "property": "min-height",
      "value": "108px"
    }
  },
  {
    "label": "When entering for the first time, the question screen of the first card is displayed.",
    "expect": {
      "type": "text",
      "selector": "#card-question:not([hidden])",
      "value": "Which HTML tag represents a hyperlink?"
    }
  },
  {
    "label": "initial hidden answer",
    "expect": {
      "type": "style",
      "selector": "#card-answer[hidden]",
      "property": "display",
      "value": "none"
    }
  },
  {
    "label": "Turn over for the first time to display the corresponding answer",
    "expect": {
      "type": "text",
      "selector": "#card-answer:not([hidden])",
      "value": "<a>"
    },
    "actions": [
      {
        "type": "click",
        "selector": "#flip-card"
      }
    ]
  },
  {
    "label": "The answer page will not display the questions at the same time.",
    "expect": {
      "type": "style",
      "selector": "#card-question[hidden]",
      "property": "display",
      "value": "none"
    },
    "actions": [
      {
        "type": "click",
        "selector": "#flip-card"
      }
    ]
  },
  {
    "label": "Restore the question when the same card is turned over",
    "expect": {
      "type": "text",
      "selector": "#card-question:not([hidden])",
      "value": "Which HTML tag represents a hyperlink?"
    },
    "actions": [
      {
        "type": "click",
        "selector": "#flip-card"
      },
      {
        "type": "click",
        "selector": "#flip-card"
      }
    ]
  },
  {
    "label": "After changing the card from the answer page, the second question is displayed",
    "expect": {
      "type": "text",
      "selector": "#card-question:not([hidden])",
      "value": "Which CSS property sets text color?"
    },
    "actions": [
      {
        "type": "click",
        "selector": "#flip-card"
      },
      {
        "type": "click",
        "selector": "#next-card"
      }
    ]
  },
  {
    "label": "The answer is hidden again after changing the card",
    "expect": {
      "type": "style",
      "selector": "#card-answer[hidden]",
      "property": "display",
      "value": "none"
    },
    "actions": [
      {
        "type": "click",
        "selector": "#flip-card"
      },
      {
        "type": "click",
        "selector": "#next-card"
      }
    ]
  },
  {
    "label": "After changing the card, the second answer is shown on the flip side.",
    "expect": {
      "type": "text",
      "selector": "#card-answer:not([hidden])",
      "value": "color"
    },
    "actions": [
      {
        "type": "click",
        "selector": "#flip-card"
      },
      {
        "type": "click",
        "selector": "#next-card"
      },
      {
        "type": "click",
        "selector": "#flip-card"
      }
    ]
  },
  {
    "label": "Return to the first picture after changing three pictures in a row",
    "expect": {
      "type": "text",
      "selector": "#card-position",
      "value": "1 / 3"
    },
    "actions": [
      {
        "type": "click",
        "selector": "#next-card"
      },
      {
        "type": "click",
        "selector": "#next-card"
      },
      {
        "type": "click",
        "selector": "#next-card"
      }
    ]
  }
]
