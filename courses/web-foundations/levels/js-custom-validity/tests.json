[
  {
    "label": "Different passwords invalidate the confirmation control",
    "expect": {
      "type": "exists",
      "selector": "#confirm:invalid"
    },
    "actions": [
      {
        "type": "input",
        "selector": "#password",
        "value": "demo-12"
      },
      {
        "type": "input",
        "selector": "#confirm",
        "value": "demo-13"
      }
    ]
  },
  {
    "label": "points out the reason for the inconsistency",
    "expect": {
      "type": "text",
      "selector": "#feedback",
      "value": "Two passwords are inconsistent"
    },
    "actions": [
      {
        "type": "input",
        "selector": "#password",
        "value": "demo-12"
      },
      {
        "type": "input",
        "selector": "#confirm",
        "value": "demo-13"
      }
    ]
  },
  {
    "label": "Recheck immediately after modifying the first item",
    "expect": {
      "type": "exists",
      "selector": "#confirm:valid"
    },
    "actions": [
      {
        "type": "input",
        "selector": "#password",
        "value": "old"
      },
      {
        "type": "input",
        "selector": "#confirm",
        "value": "new"
      },
      {
        "type": "input",
        "selector": "#password",
        "value": "new"
      }
    ]
  },
  {
    "label": "Keep the original required fields when clearing the confirmation box",
    "expect": {
      "type": "exists",
      "selector": "#confirm:invalid"
    },
    "actions": [
      {
        "type": "input",
        "selector": "#password",
        "value": "demo"
      },
      {
        "type": "input",
        "selector": "#confirm",
        "value": "other"
      },
      {
        "type": "input",
        "selector": "#confirm",
        "value": ""
      }
    ]
  },
  {
    "label": "No old matching errors after clearing",
    "expect": {
      "type": "text",
      "selector": "#feedback",
      "value": ""
    },
    "actions": [
      {
        "type": "input",
        "selector": "#password",
        "value": "demo"
      },
      {
        "type": "input",
        "selector": "#confirm",
        "value": "other"
      },
      {
        "type": "input",
        "selector": "#confirm",
        "value": ""
      }
    ]
  }
]
