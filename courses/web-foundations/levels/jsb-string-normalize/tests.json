[
  {
    "label": "Clean spaces and letters at the same time",
    "expect": {
      "type": "function",
      "name": "normalizeTag",
      "args": [
        "  p-13a "
      ],
      "value": "P-13A"
    }
  },
  {
    "label": "Keep the space in the middle of the number when reading the code",
    "expect": {
      "type": "function",
      "name": "normalizeTag",
      "args": [
        " x 2 "
      ],
      "value": "X 2"
    }
  },
  {
    "label": "Pure white space returns an empty string",
    "expect": {
      "type": "function",
      "name": "normalizeTag",
      "args": [
        "  \t"
      ],
      "value": ""
    }
  },
  {
    "label": "Preserves punctuation and digits",
    "expect": {
      "type": "function",
      "name": "normalizeTag",
      "args": [
        "-09#"
      ],
      "value": "-09#"
    }
  }
]
