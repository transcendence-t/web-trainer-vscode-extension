[
  {
    "label": "status card adopts new background color",
    "expect": {
      "type": "style",
      "selector": ".status",
      "property": "background-color",
      "value": "rgb(230, 244, 238)"
    }
  },
  {
    "label": "The padding of the old rules still takes effect",
    "expect": {
      "type": "style",
      "selector": ".status",
      "property": "padding-top",
      "value": "12px"
    }
  },
  {
    "label": "Other paragraphs have no status background color",
    "expect": {
      "type": "style",
      "selector": ".note",
      "property": "background-color",
      "value": "rgba(0, 0, 0, 0)"
    }
  }
]
