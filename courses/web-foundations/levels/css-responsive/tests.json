      "relativeTo": ".equipment-stage",
      "relation": "equal-width"
    },
    "viewport": 360
  },
  {
    "label": "平板宽度下卡片区随容器变宽",
    "expect": {
      "type": "layout",
      "selector": ".equipment-grid",
      "relativeTo": ".equipment-stage",
      "relation": "equal-width"
    },
    "viewport": 560
  },
  {
    "label": "断点处第二张卡与第一张并排",
    "expect": {
      "type": "layout",
      "selector": "#recorder",
      "relativeTo": "#projector",
      "relation": "right-of"
    },
    "viewport": 680
  },
  {
    "label": "宽窗口的两张设备卡等宽",
    "expect": {
      "type": "layout",
      "selector": "#recorder",
      "relativeTo": "#projector",
      "relation": "equal-width"
    },
    "viewport": 840
  },
  {
    "label": "宽窗口保留 12px 列间隔",
