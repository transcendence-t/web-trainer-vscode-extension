[
  {
    "label": "You can click on the internal text to delete the corresponding line.",
    "expect": {
      "type": "count",
      "selector": "#stand",
      "value": 0
    },
    "actions": [
      {
        "type": "click",
        "selector": "#stand .remove span"
      }
    ]
  },
  {
    "label": "Keep the two unclicked lines",
    "expect": {
      "type": "count",
      "selector": "#rows > li",
      "value": 2
    },
    "actions": [
      {
        "type": "click",
        "selector": "#stand .remove"
      }
    ]
  },
  {
    "label": "Clicking on a normal line of text will not delete it",
    "expect": {
      "type": "count",
      "selector": "#rows > li",
      "value": 3
    },
    "actions": [
      {
        "type": "click",
        "selector": "#stand"
      }
    ]
  },
  {
    "label": "Continuous deletion only affects the corresponding items",
    "expect": {
      "type": "count",
      "selector": "#rows > li#stand:only-child",
      "value": 1
    },
    "actions": [
      {
        "type": "click",
        "selector": "#camera .remove span"
      },
      {
        "type": "click",
        "selector": "#lamp .remove"
      }
    ]
  }
]
