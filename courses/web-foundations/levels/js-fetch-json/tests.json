[
  {
    "label": "generates two items based on the returned data",
    "expect": {
      "type": "count",
      "selector": "#events > li",
      "value": 2
    },
    "actions": [
      {
        "type": "click",
        "selector": "#load"
      },
      {
        "type": "wait",
        "ms": 100
      }
    ]
  },
  {
    "label": "The first text comes from JSON",
    "expect": {
      "type": "text",
      "selector": "#events > li:first-child",
      "value": "Open pottery studio"
    },
    "actions": [
      {
        "type": "click",
        "selector": "#load"
      },
      {
        "type": "wait",
        "ms": 100
      }
    ]
  },
  {
    "label": "empty list has clear feedback",
    "expect": {
      "type": "text",
      "selector": "#notice",
      "value": "No activities"
    },
    "actions": [
      {
        "type": "input",
        "selector": "#dataset",
        "value": "data:application/json;charset=utf-8,%7B%22activities%22%3A%5B%5D%7D"
      },
      {
        "type": "click",
        "selector": "#load"
      },
      {
        "type": "wait",
        "ms": 100
      }
    ]
  },
  {
    "label": "Switch sample to clear old results",
    "expect": {
      "type": "count",
      "selector": "#events > li",
      "value": 0
    },
    "actions": [
      {
        "type": "click",
        "selector": "#load"
      },
      {
        "type": "wait",
        "ms": 100
      },
      {
        "type": "input",
        "selector": "#dataset",
        "value": "data:application/json;charset=utf-8,%7B%22activities%22%3A%5B%5D%7D"
      },
      {
        "type": "click",
        "selector": "#load"
      },
      {
        "type": "wait",
        "ms": 100
      }
    ]
  },
  {
    "label": "Corrupted JSON has failure feedback",
    "expect": {
      "type": "text",
      "selector": "#notice",
      "value": "data cannot be read"
    },
    "actions": [
      {
        "type": "input",
        "selector": "#dataset",
        "value": "data:application/json,%7B"
      },
      {
        "type": "click",
        "selector": "#load"
      },
      {
        "type": "wait",
        "ms": 100
      }
    ]
  }
]
