[
  {
    "label": "No task started before clicking",
    "expect": {
      "type": "text",
      "selector": "#order",
      "value": "is not running yet"
    }
  },
  {
    "label": "synchronization, microtasks and timers run strictly in sequence",
    "expect": {
      "type": "text",
      "selector": "#order",
      "value": "synchronization → microtask → timer"
    },
    "actions": [
      {
        "type": "click",
        "selector": "#run"
      },
      {
        "type": "wait",
        "ms": 80
      }
    ]
  },
  {
    "label": "Clicking again will not repeat the previous accumulated steps.",
    "expect": {
      "type": "text",
      "selector": "#order",
      "value": "synchronization → microtask → timer"
    },
    "actions": [
      {
        "type": "click",
        "selector": "#run"
      },
      {
        "type": "wait",
        "ms": 70
      },
      {
        "type": "click",
        "selector": "#run"
      },
      {
        "type": "wait",
        "ms": 80
      }
    ]
  }
]
