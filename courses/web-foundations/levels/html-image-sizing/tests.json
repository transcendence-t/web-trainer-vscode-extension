[
  {
    "label": "decorative image explicitly uses empty alt",
    "expect": {
      "type": "attribute",
      "selector": "#decoration",
      "name": "alt",
      "value": ""
    }
  },
  {
    "label": "decorative pictures have reserved dimensions",
    "expect": {
      "type": "exists",
      "selector": "img#decoration[width=\"24\"][height=\"20\"]"
    }
  },
  {
    "label": "content picture retains two dimensions",
    "expect": {
      "type": "exists",
      "selector": "img#building[width=\"144\"][height=\"76\"]"
    }
  },
  {
    "label": "retain the original alternative text",
    "expect": {
      "type": "attribute",
      "selector": "#building",
      "name": "alt",
      "value": "Front view of the training building"
    }
  }
]
