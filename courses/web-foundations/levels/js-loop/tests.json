      "value": "Day 1"
    },
    "actions": [
      {
        "type": "click",
        "selector": "#make-list"
      }
    ]
  },
  {
    "label": "The second item is day 2",
    "expect": {
      "type": "text",
      "selector": "#days > li:nth-child(2)",
      "value": "Day 2"
    },
    "actions": [
      {
        "type": "click",
        "selector": "#make-list"
      }
    ]
  },
  {
    "label": "The third item is day 3",
    "expect": {
      "type": "text",
      "selector": "#days > li:nth-child(3)",
      "value": "Day 3"
    },
    "actions": [
      {
        "type": "click",
        "selector": "#make-list"
      }
    ]
  },
  {
    "label": "The fourth item is day 4",
    "expect": {
      "type": "text",
      "selector": "#days > li:nth-child(4)",
      "value": "Day 4"
    },
    "actions": [
      {
        "type": "click",
        "selector": "#make-list"
      }
    ]
  },
  {
    "label": "The fifth item is day 5",
    "expect": {
      "type": "text",
      "selector": "#days > li:nth-child(5)",
      "value": "Day 5"
    },
    "actions": [
      {
        "type": "click",
        "selector": "#make-list"
      }
    ]
  },
  {
    "label": "There are still only five items in the repeated generation",
    "expect": {
      "type": "count",
      "selector": "#days > li",
      "value": 5
