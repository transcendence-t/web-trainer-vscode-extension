[
  {
    "label": "The list is empty before generation",
    "expect": {
      "type": "count",
      "selector": "#days > li",
      "value": 0
    }
  },
  {
    "label": "There are five items after clicking",
    "expect": {
      "type": "count",
      "selector": "#days > li",
      "value": 5
    },
    "actions": [
      {
        "type": "click",
        "selector": "#make-list"
      }
    ]
  },
  {
    "label": "The first item starts from day 1",
    "expect": {
