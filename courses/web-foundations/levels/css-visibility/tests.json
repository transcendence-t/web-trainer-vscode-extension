[
  {
    "label": "The middle station has been hidden",
    "expect": {
      "type": "style",
      "selector": "#middle-stop",
      "property": "visibility",
      "value": "hidden"
    }
  },
  {
    "label": "terminal is still visible",
    "expect": {
      "type": "style",
      "selector": "#last-stop",
      "property": "visibility",
      "value": "visible"
    }
  },
  {
    "label": "The end point is still on the right side of the empty space in the middle station",
    "expect": {
      "type": "layout",
      "selector": "#last-stop",
      "relativeTo": "#middle-stop",
      "relation": "right-of"
    }
  },
  {
    "label": "The empty space at the intermediate station is still on the right side of the starting point",
    "expect": {
      "type": "layout",
      "selector": "#middle-stop",
      "relativeTo": "#first-stop",
      "relation": "right-of"
    }
  }
]
