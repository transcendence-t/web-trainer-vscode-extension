[
  {
    "label": "provides playback controls",
    "expect": {
      "type": "property",
      "selector": "video#demo",
      "name": "controls",
      "value": true
    }
  },
  {
    "label": "video material can be loaded",
    "expect": {
      "type": "property",
      "selector": "video#demo",
      "name": "videoWidth",
      "value": 96
    },
    "actions": [
      {
        "type": "wait",
        "ms": 350
      }
    ]
  },
  {
    "label": "declares default English captions",
    "expect": {
      "type": "exists",
      "selector": "video#demo > track[kind=\"captions\"][srclang=\"en\"][label=\"English\"][default]"
    }
  },
  {
    "label": "subtitle resources loaded successfully",
    "expect": {
      "type": "property",
      "selector": "video#demo > track",
      "name": "readyState",
      "value": 2
    },
    "actions": [
      {
        "type": "wait",
        "ms": 350
      }
    ]
  }
]
