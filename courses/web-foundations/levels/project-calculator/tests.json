[
  {
    "label": "Two number input boxes side by side in a narrow window",
    "expect": {
      "type": "layout",
      "selector": "#second-number",
      "relativeTo": "#first-number",
      "relation": "right-of"
    },
    "viewport": 320
  },
  {
    "label": "Two number input boxes in a narrow window are of equal width",
    "expect": {
      "type": "layout",
      "selector": "#second-number",
      "relativeTo": "#first-number",
      "relation": "equal-width"
    },
    "viewport": 320
  },
  {
    "label": "Two number input boxes are still side by side in a wide window",
    "expect": {
      "type": "layout",
      "selector": "#second-number",
      "relativeTo": "#first-number",
      "relation": "right-of"
    },
    "viewport": 720
  },
  {
    "label": "Two calculation buttons side by side",
    "expect": {
      "type": "layout",
      "selector": "#calc-subtract",
      "relativeTo": "#calc-add",
      "relation": "right-of"
    },
    "viewport": 320
  },
  {
    "label": "Two calculation buttons of equal width",
    "expect": {
      "type": "layout",
      "selector": "#calc-subtract",
      "relativeTo": "#calc-add",
      "relation": "equal-width"
    },
    "viewport": 320
  },
  {
    "label": "results below the button group",
    "expect": {
      "type": "layout",
      "selector": ".result",
      "relativeTo": ".operations",
      "relation": "below"
    },
    "viewport": 320
  },
  {
    "label": "input group has a column spacing of 12px",
    "expect": {
      "type": "style",
      "selector": ".number-fields",
      "property": "column-gap",
      "value": "12px"
    }
  },
  {
    "label": "button group has 12px column spacing",
    "expect": {
      "type": "style",
      "selector": ".operations",
      "property": "column-gap",
      "value": "12px"
    }
  },
  {
    "label": "displays waiting for calculation when it is first opened.",
    "expect": {
      "type": "text",
      "selector": "#calc-result",
      "value": "waiting for calculation"
    }
  },
  {
    "label": "8 plus 5 gets 13",
    "expect": {
      "type": "text",
      "selector": "#calc-result",
      "value": "13"
    },
    "actions": [
      {
        "type": "input",
        "selector": "#first-number",
        "value": "8"
      },
      {
        "type": "input",
        "selector": "#second-number",
        "value": "5"
      },
      {
        "type": "click",
        "selector": "#calc-add"
      }
    ]
  },
  {
    "label": "Negative numbers and decimals can be added",
    "expect": {
      "type": "text",
      "selector": "#calc-result",
      "value": "-0.5"
    },
    "actions": [
      {
        "type": "input",
        "selector": "#first-number",
        "value": " -2 "
      },
      {
        "type": "input",
        "selector": "#second-number",
        "value": "1.5"
      },
      {
        "type": "click",
        "selector": "#calc-add"
      }
    ]
  },
  {
    "label": "Subtract the second number from the first number",
    "expect": {
      "type": "text",
      "selector": "#calc-result",
      "value": "7"
    },
    "actions": [
      {
        "type": "input",
        "selector": "#first-number",
        "value": "9"
      },
      {
        "type": "input",
        "selector": "#second-number",
        "value": "2"
      },
      {
        "type": "click",
        "selector": "#calc-subtract"
      }
    ]
  },
  {
    "label": "Subtraction can get negative numbers",
    "expect": {
      "type": "text",
      "selector": "#calc-result",
      "value": "-5"
    },
    "actions": [
      {
        "type": "input",
        "selector": "#first-number",
        "value": "3"
      },
      {
        "type": "input",
        "selector": "#second-number",
        "value": "8"
      },
      {
        "type": "click",
        "selector": "#calc-subtract"
      }
    ]
  },
  {
    "label": "0 is a valid input",
    "expect": {
      "type": "text",
      "selector": "#calc-result",
      "value": "0"
    },
    "actions": [
      {
        "type": "input",
        "selector": "#first-number",
        "value": "0"
      },
      {
        "type": "input",
        "selector": "#second-number",
        "value": "0"
      },
      {
        "type": "click",
        "selector": "#calc-add"
      }
    ]
  },
  {
    "label": "prompts for valid digits when left blank",
    "expect": {
      "type": "text",
      "selector": "#calc-result",
      "value": "Please enter two valid digits."
    },
    "actions": [
      {
        "type": "input",
        "selector": "#first-number",
        "value": ""
      },
      {
        "type": "input",
        "selector": "#second-number",
        "value": "4"
      },
      {
        "type": "click",
        "selector": "#calc-add"
      }
    ]
  },
  {
    "label": "input with all spaces is also considered empty",
    "expect": {
      "type": "text",
      "selector": "#calc-result",
      "value": "Please enter two valid digits."
    },
    "actions": [
      {
        "type": "input",
        "selector": "#first-number",
        "value": "4"
      },
      {
        "type": "input",
        "selector": "#second-number",
        "value": "   "
      },
      {
        "type": "click",
        "selector": "#calc-subtract"
      }
    ]
  },
  {
    "label": "Numeric text with letters will be rejected",
    "expect": {
      "type": "text",
      "selector": "#calc-result",
      "value": "Please enter two valid digits."
    },
    "actions": [
      {
        "type": "input",
        "selector": "#first-number",
        "value": "15px"
      },
      {
        "type": "input",
        "selector": "#second-number",
        "value": "2"
      },
      {
        "type": "click",
        "selector": "#calc-add"
      }
    ]
  },
  {
    "label": "Infinitely large input will be rejected",
    "expect": {
      "type": "text",
      "selector": "#calc-result",
      "value": "Please enter two valid digits."
    },
    "actions": [
      {
        "type": "input",
        "selector": "#first-number",
        "value": "1"
      },
      {
        "type": "input",
        "selector": "#second-number",
        "value": "Infinity"
      },
      {
        "type": "click",
        "selector": "#calc-subtract"
      }
    ]
  },
  {
    "label": "The operation can continue after correcting the invalid input",
    "expect": {
      "type": "text",
      "selector": "#calc-result",
      "value": "5"
    },
    "actions": [
      {
        "type": "input",
        "selector": "#first-number",
        "value": "4px"
      },
      {
        "type": "input",
        "selector": "#second-number",
        "value": "1"
      },
      {
        "type": "click",
        "selector": "#calc-add"
      },
      {
        "type": "input",
        "selector": "#first-number",
        "value": "4"
      },
      {
        "type": "click",
        "selector": "#calc-add"
      }
    ]
  }
]
