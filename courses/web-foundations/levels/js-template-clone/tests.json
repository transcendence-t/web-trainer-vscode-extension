[
  {
    "label": "template does not display cards initially",
    "expect": {
      "type": "count",
      "selector": "#cards > li",
      "value": 0
    }
  },
  {
    "label": "generates two cards with titles",
    "expect": {
      "type": "count",
      "selector": "#cards > li .model",
      "value": 2
    },
    "actions": [
      {
        "type": "click",
        "selector": "#build"
      }
    ]
  },
  {
    "label": "The first card uses the first name",
    "expect": {
      "type": "text",
      "selector": "#cards > li:first-child .model",
      "value": "rangefinder"
    },
    "actions": [
      {
        "type": "click",
        "selector": "#build"
      }
    ]
  },
  {
    "label": "The second card is associated with the correct number",
    "expect": {
      "type": "text",
      "selector": "#cards > li:nth-child(2) .code",
      "value": "R16"
    },
    "actions": [
      {
        "type": "click",
        "selector": "#build"
      }
    ]
  },
  {
    "label": "still has two cards after repeated generation",
    "expect": {
      "type": "count",
      "selector": "#cards > li",
      "value": 2
    },
    "actions": [
      {
        "type": "click",
        "selector": "#build"
      },
      {
        "type": "click",
        "selector": "#build"
      }
    ]
  }
]
