[
  {
    "label": "点击前保留起始提示",
    "expect": {
      "type": "text",
      "selector": "#receipt",
      "value": "等待格式化"
    }
  },
  {
    "label": "通过模块得到三位编号",
    "expect": {
      "type": "text",
      "selector": "#receipt",
      "value": "LAB-003"
    },
    "actions": [
      {
        "type": "click",
        "selector": "#format"
      }
    ]
  },
  {
    "label": "重新输入用实际数值格式化",
    "expect": {
      "type": "text",
      "selector": "#receipt",
      "value": "LAB-027"
    },
    "actions": [
      {
        "type": "input",
        "selector": "#ticket",
        "value": "27"
      },
      {
        "type": "click",
        "selector": "#format"
      }
    ]
  },
  {
    "label": "编号超过三位时完整保留",
    "expect": {
      "type": "text",
      "selector": "#receipt",
      "value": "LAB-1848"
    },
    "actions": [
      {
        "type": "input",
        "selector": "#ticket",
        "value": "1848"
      },
      {
        "type": "click",
        "selector": "#format"
      }
    ]
  }
]
