[
  {
    "label": "Keep the starting prompt before clicking",
    "expect": {
      "type": "text",
      "selector": "#receipt",
      "value": "waiting for formatting"
    }
  },
  {
    "label": "gets the three-digit number through the module",
    "expect": {
      "type": "text",
      "selector": "#receipt",
      "value": "LAB-003"
    },
    "actions": [
      {
        "type": "click",
        "selector": "#format"
      }
    ]
  },
  {
    "label": "Re-enter formatted with actual values",
    "expect": {
      "type": "text",
      "selector": "#receipt",
      "value": "LAB-027"
    },
    "actions": [
      {
        "type": "input",
        "selector": "#ticket",
        "value": "27"
      },
      {
        "type": "click",
        "selector": "#format"
      }
    ]
  },
  {
    "label": "If the number exceeds three digits, keep it intact",
    "expect": {
      "type": "text",
      "selector": "#receipt",
      "value": "LAB-1848"
    },
    "actions": [
      {
        "type": "input",
        "selector": "#ticket",
        "value": "1848"
      },
      {
        "type": "click",
        "selector": "#format"
      }
    ]
  }
]
