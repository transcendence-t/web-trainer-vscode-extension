[
  {
    "label": "ordinary interval includes the end point",
    "expect": {
      "type": "function",
      "name": "labelRange",
      "args": [
        3,
        6
      ],
      "value": [
        3,
        4,
        5,
        6
      ]
    }
  },
  {
    "label": "The same endpoint returns one item",
    "expect": {
      "type": "function",
      "name": "labelRange",
      "args": [
        8,
        8
      ],
      "value": [
        8
      ]
    }
  },
  {
    "label": "reverse interval has no label",
    "expect": {
      "type": "function",
      "name": "labelRange",
      "args": [
        6,
        5
      ],
      "value": []
    }
  },
  {
    "label": "accepts starting from scratch",
    "expect": {
      "type": "function",
      "name": "labelRange",
      "args": [
        0,
        2
      ],
      "value": [
        0,
        1,
        2
      ]
    }
  }
]
