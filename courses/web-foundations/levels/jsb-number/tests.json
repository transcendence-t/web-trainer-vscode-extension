[
  {
    "label": "Calculate the sum of two decimals",
    "expect": {
      "type": "function",
      "name": "sumWeights",
      "args": [
        "2.5",
        "0.75"
      ],
      "value": 3.25
    }
  },
  {
    "label": "If the first transaction is left blank, it will be calculated as 0",
    "expect": {
      "type": "function",
      "name": "sumWeights",
      "args": [
        "",
        "6"
      ],
      "value": 6
    }
  },
  {
    "label": "numbers can contain spaces and leading zeros",
    "expect": {
      "type": "function",
      "name": "sumWeights",
      "args": [
        " 04 ",
        "2"
      ],
      "value": 6
    }
  },
  {
    "label": "The value 0 will still be returned when the second transaction is left blank.",
    "expect": {
      "type": "function",
      "name": "sumWeights",
      "args": [
        "0",
        ""
      ],
      "value": 0
    }
  }
]
