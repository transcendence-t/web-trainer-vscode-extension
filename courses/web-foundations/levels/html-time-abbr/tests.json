[
  {
    "label": "date uses time and the text is retained",
    "expect": {
      "type": "text",
      "selector": "time",
      "value": "May 18"
    }
  },
  {
    "label": "date in ISO format",
    "expect": {
      "type": "attribute",
      "selector": "time",
      "name": "datetime",
      "value": "2027-05-18"
    }
  },
  {
    "label": "CAD using abbr",
    "expect": {
      "type": "text",
      "selector": "abbr",
      "value": "CAD"
    }
  },
  {
    "label": "provides the full abbreviation",
    "expect": {
      "type": "attribute",
      "selector": "abbr",
      "name": "title",
      "value": "computer-aided design"
    }
  }
]
