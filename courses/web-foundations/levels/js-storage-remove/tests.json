[
  {
    "label": "Read existing preferences at startup",
    "expect": {
      "type": "text",
      "selector": "#density",
      "value": "Compact"
    },
    "storage": {
      "density": "Compact"
    }
  },
  {
    "label": "displays the default immediately after recovery",
    "expect": {
      "type": "text",
      "selector": "#density",
      "value": "standard"
    },
    "storage": {
      "density": "Compact"
    },
    "actions": [
      {
        "type": "click",
        "selector": "#reset-density"
      }
    ]
  },
  {
    "label": "The specified key does not exist after recovery",
    "expect": {
      "type": "storage",
      "key": "density",
      "value": null
    },
    "storage": {
      "density": "Compact"
    },
    "actions": [
      {
        "type": "click",
        "selector": "#reset-density"
      }
    ]
  },
  {
    "label": "Other preferences remain saved",
    "expect": {
      "type": "storage",
      "key": "language",
      "value": "zh-CN"
    },
    "storage": {
      "density": "Compact",
      "language": "zh-CN"
    },
    "actions": [
      {
        "type": "click",
        "selector": "#reset-density"
      }
    ]
  }
]
