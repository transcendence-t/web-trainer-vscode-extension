[
  {
    "label": "Place the new appointment after the existing two",
    "expect": {
      "type": "function",
      "name": "addBooking",
      "args": [
        [
          "Liang An",
          "Kong Jia"
        ],
        "Jiang Chuan"
      ],
      "value": [
        "Liang An",
        "Kong Jia",
        "Jiang Chuan"
      ]
    }
  },
  {
    "label": "The first visitor can be added to the empty list",
    "expect": {
      "type": "function",
      "name": "addBooking",
      "args": [
        [],
        "Lin Xin"
      ],
      "value": [
        "Lin Xin"
      ]
    }
  },
  {
    "label": "Visitor with the same name also added an item",
    "expect": {
      "type": "function",
      "name": "addBooking",
      "args": [
        [
          "Wu Shuang",
          "Song Lin"
        ],
        "Wu Shuang"
      ],
      "value": [
        "Wu Shuang",
        "Song Lin",
        "Wu Shuang"
      ]
    }
  }
]
