[
  {
    "label": "navigation bar uses Flexbox",
    "expect": {
      "type": "style",
      "selector": ".site-nav",
      "property": "display",
      "value": "flex"
    }
  },
  {
    "label": "link group also uses Flexbox",
    "expect": {
      "type": "style",
      "selector": ".nav-links",
      "property": "display",
      "value": "flex"
    }
  },
  {
    "label": "The navigation bar divides the site name and link components into two ends",
    "expect": {
      "type": "style",
      "selector": ".site-nav",
      "property": "justify-content",
      "value": "space-between"
    }
  },
  {
    "label": "Station name and link group are centered along the cross axis",
    "expect": {
      "type": "style",
      "selector": ".site-nav",
      "property": "align-items",
      "value": "center"
    }
  },
  {
    "label": "Maintain 16px spacing between links",
    "expect": {
      "type": "style",
      "selector": ".nav-links",
      "property": "column-gap",
      "value": "16px"
    }
  },
  {
    "label": "The link group is located to the right of the station name in the wide window",
    "expect": {
      "type": "layout",
      "selector": ".nav-links",
      "relativeTo": "#site-brand",
      "relation": "right-of"
    },
    "viewport": 720
  },
  {
    "label": "In the narrow window, the link group is still located to the right of the station name.",
    "expect": {
      "type": "layout",
      "selector": ".nav-links",
      "relativeTo": "#site-brand",
      "relation": "right-of"
    },
    "viewport": 320
  },
  {
    "label": "In the narrow window, the work links are arranged to the right of the active links.",
    "expect": {
      "type": "layout",
      "selector": "#gallery-link",
      "relativeTo": "#events-link",
      "relation": "right-of"
    },
    "viewport": 320
  },
  {
    "label": "The link group remains in the navigation bar in a narrow window",
    "expect": {
      "type": "layout",
      "selector": ".nav-links",
      "relativeTo": ".site-nav",
      "relation": "inside"
    },
    "viewport": 320
  }
]
