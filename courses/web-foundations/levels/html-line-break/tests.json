[
  {
    "label": "There is exactly one newline in the address",
    "expect": {
      "type": "count",
      "selector": "#club-address br",
      "value": 1
    },
    "hint": "Check whether br is missing or added repeatedly."
  },
  {
    "label": "is the room number after the line break",
    "expect": {
      "type": "text",
      "selector": "address#club-address > span:first-child + br + span:last-child",
      "value": "Training Building"
    },
    "hint": "Place br between two spans."
  },
  {
    "label": "street address is still on the first line",
    "expect": {
      "type": "text",
      "selector": "address#club-address > span:first-child",
      "value": "No. 16 Daxue Road"
    }
  }
]
