[
  {
    "label": "Display window after success",
    "expect": {
      "type": "text",
      "selector": "#desk",
      "value": "Please go to window 2"
    },
    "actions": [
      {
        "type": "click",
        "selector": "#ready"
      }
    ]
  },
  {
    "label": "Shows the reason when it fails",
    "expect": {
      "type": "text",
      "selector": "#desk",
      "value": "No service window is available right now"
    },
    "actions": [
      {
        "type": "click",
        "selector": "#busy"
      }
    ]
  },
  {
    "label": "can retry after displaying an error",
    "expect": {
      "type": "text",
      "selector": "#desk",
      "value": "Please go to window 2"
    },
    "actions": [
      {
        "type": "click",
        "selector": "#busy"
      },
      {
        "type": "click",
        "selector": "#ready"
      }
    ]
  }
]
