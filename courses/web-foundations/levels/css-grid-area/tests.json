[
  {
    "label": "overview card uses overview area",
    "expect": {
      "type": "style",
      "selector": ".show-overview",
      "property": "grid-area",
      "value": "overview"
    }
  },
  {
    "label": "stage card uses the stage area",
    "expect": {
      "type": "style",
      "selector": ".stage-crew",
      "property": "grid-area",
      "value": "stage"
    }
  },
  {
    "label": "Ticket card uses the tickets area",
    "expect": {
      "type": "style",
      "selector": ".front-desk",
      "property": "grid-area",
      "value": "tickets"
    }
  },
  {
    "label": "overview card occupies the first row",
    "expect": {
      "type": "layout",
      "selector": ".show-overview",
      "relativeTo": ".show-board",
      "relation": "equal-width"
    }
  },
  {
    "label": "stage card is located below the overview",
    "expect": {
      "type": "layout",
      "selector": ".stage-crew",
      "relativeTo": ".show-overview",
      "relation": "below"
    }
  },
  {
    "label": "The ticket check card is located on the right side of the stage card",
    "expect": {
      "type": "layout",
      "selector": ".front-desk",
      "relativeTo": ".stage-crew",
      "relation": "right-of"
    }
  }
]
