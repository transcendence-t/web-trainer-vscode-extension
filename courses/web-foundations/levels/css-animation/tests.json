[
  {
    "label": "An animation of emergency sign takes 400ms",
    "expect": {
      "type": "style",
      "selector": ".dispatch-stamp",
      "property": "animation-duration",
      "value": "0.4s"
    }
  },
  {
    "label": "Pause at start keyframe with opacity of 0.3",
    "expect": {
      "type": "style",
      "selector": ".dispatch-stamp",
      "property": "opacity",
      "value": "0.3"
    }
  },
  {
    "label": "When paused at the starting key frame, the emergency sign is 18px higher than the original position.",
    "expect": {
      "type": "style",
      "selector": ".dispatch-stamp",
      "property": "transform",
      "value": "matrix(1, 0, 0, 1, 0, -18)"
    }
  },
  {
    "label": "The emergency sign remains fully visible after the animation.",
    "expect": {
      "type": "style",
      "selector": ".dispatch-stamp",
      "property": "opacity",
      "value": "1"
    },
    "actions": [
      {
        "type": "click",
        "selector": "#play-stamp"
      },
      {
        "type": "finish-motion",
        "selector": ".dispatch-stamp"
      }
    ]
  },
  {
    "label": "The emergency sign remains in the dotted box after the animation is played.",
    "expect": {
      "type": "layout",
      "selector": ".dispatch-stamp",
      "relativeTo": ".stamp-slot",
      "relation": "inside"
    },
    "actions": [
      {
        "type": "click",
        "selector": "#play-stamp"
      },
      {
        "type": "finish-motion",
        "selector": ".dispatch-stamp"
      }
    ]
  }
]
