[
  {
    "label": "未启动时等过两个周期也没有记录",
    "expect": {
      "type": "count",
      "selector": "#sample-log > li",
      "value": 0
    },
    "actions": [
      {
        "type": "wait",
        "ms": 650
      }
    ]
  },
  {
    "label": "点击启动后至少产生两条记录",
    "expect": {
      "type": "exists",
      "selector": "#sample-log > li:nth-child(2)"
    },
    "actions": [
      {
        "type": "click",
        "selector": "#start-sampling"
      },
      {
        "type": "wait",
        "ms": 900
      }
    ]
  },
  {
    "label": "停止后保留先前的采样记录",
    "expect": {
      "type": "exists",
      "selector": "#sample-log > li:nth-child(2)"
    },
    "actions": [
      {
        "type": "click",
        "selector": "#start-sampling"
      },
      {
        "type": "wait",
        "ms": 900
      },
      {
        "type": "click",
        "selector": "#stop-sampling"
      },
      {
        "type": "wait",
        "ms": 850
      }
    ]
  },
  {
    "label": "等待几个采样周期后仍处于停止状态",
    "expect": {
      "type": "text",
      "selector": "#sampling-status",
      "value": "已停止采样"
    },
    "actions": [
      {
        "type": "click",
        "selector": "#start-sampling"
      },
      {
        "type": "wait",
        "ms": 900
      },
      {
        "type": "click",
        "selector": "#stop-sampling"
      },
      {
        "type": "wait",
        "ms": 850
      }
    ]
  },
  {
    "label": "停止后可以再开始下一轮",
    "expect": {
      "type": "exists",
      "selector": "#start-sampling:not([disabled])"
    },
    "actions": [
      {
        "type": "click",
        "selector": "#start-sampling"
      },
      {
        "type": "wait",
        "ms": 900
      },
      {
        "type": "click",
        "selector": "#stop-sampling"
      },
      {
        "type": "wait",
        "ms": 850
      }
    ]
  }
]
