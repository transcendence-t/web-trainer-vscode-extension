[
  {
    "label": "is not started, there is no record after waiting for two cycles.",
    "expect": {
      "type": "count",
      "selector": "#sample-log > li",
      "value": 0
    },
    "actions": [
      {
        "type": "wait",
        "ms": 650
      }
    ]
  },
  {
    "label": "At least two records will be generated after clicking start.",
    "expect": {
      "type": "exists",
      "selector": "#sample-log > li:nth-child(2)"
    },
    "actions": [
      {
        "type": "click",
        "selector": "#start-sampling"
      },
      {
        "type": "wait",
        "ms": 900
      }
    ]
  },
  {
    "label": "retains previous sampling records after stopping",
    "expect": {
      "type": "exists",
      "selector": "#sample-log > li:nth-child(2)"
    },
    "actions": [
      {
        "type": "click",
        "selector": "#start-sampling"
      },
      {
        "type": "wait",
        "ms": 900
      },
      {
        "type": "click",
        "selector": "#stop-sampling"
      },
      {
        "type": "wait",
        "ms": 850
      }
    ]
  },
  {
    "label": "is still in the stopped state after waiting for several sampling cycles.",
    "expect": {
      "type": "text",
      "selector": "#sampling-status",
      "value": "Sampling has stopped"
    },
    "actions": [
      {
        "type": "click",
        "selector": "#start-sampling"
      },
      {
        "type": "wait",
        "ms": 900
      },
      {
        "type": "click",
        "selector": "#stop-sampling"
      },
      {
        "type": "wait",
        "ms": 850
      }
    ]
  },
  {
    "label": "After stopping, you can start the next round",
    "expect": {
      "type": "exists",
      "selector": "#start-sampling:not([disabled])"
    },
    "actions": [
      {
        "type": "click",
        "selector": "#start-sampling"
      },
      {
        "type": "wait",
        "ms": 900
      },
      {
        "type": "click",
        "selector": "#stop-sampling"
      },
      {
        "type": "wait",
        "ms": 850
      }
    ]
  }
]
