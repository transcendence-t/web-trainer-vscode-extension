[
  {
    "label": "Returns an empty string when the width is zero",
    "expect": {
      "type": "function",
      "name": "receiptDivider",
      "args": [
        0
      ],
      "value": ""
    }
  },
  {
    "label": "only splices once when the width is one",
    "expect": {
      "type": "function",
      "name": "receiptDivider",
      "args": [
        1
      ],
      "value": "-"
    }
  },
  {
    "label": "returns five dashes when the width is five",
    "expect": {
      "type": "function",
      "name": "receiptDivider",
      "args": [
        5
      ],
      "value": "-----"
    }
  },
  {
    "label": "retains complete dividing lines when the width is twelve",
    "expect": {
      "type": "function",
      "name": "receiptDivider",
      "args": [
        12
      ],
      "value": "------------"
    }
  }
]
