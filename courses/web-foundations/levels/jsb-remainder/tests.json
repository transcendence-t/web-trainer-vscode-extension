[
  {
    "label": "分出整组后剩下四人",
    "expect": {
      "type": "function",
      "name": "ungroupedCount",
      "args": [
        22,
        6
      ],
      "value": 4
    }
  },
  {
    "label": "人数恰好能分完时返回 0",
    "expect": {
      "type": "function",
      "name": "ungroupedCount",
      "args": [
        18,
        6
      ],
      "value": 0
    }
  },
  {
    "label": "不足一组时保留总人数",
    "expect": {
      "type": "function",
      "name": "ungroupedCount",
      "args": [
        3,
        8
      ],
      "value": 3
    }
  },
  {
    "label": "没有志愿者时返回 0",
    "expect": {
      "type": "function",
      "name": "ungroupedCount",
      "args": [
        0,
        5
      ],
      "value": 0
    }
  },
  {
    "label": "每组一人时总能分完",
    "expect": {
      "type": "function",
      "name": "ungroupedCount",
      "args": [
        10,
        1
      ],
      "value": 0
    }
  }
]
