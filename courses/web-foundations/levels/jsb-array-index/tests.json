[
  {
    "label": "下标 0 对应第一个站名",
    "expect": {
      "type": "function",
      "name": "readStop",
      "args": [
        [
          "北桥",
          "西村",
          "河湾"
        ],
        0
      ],
      "value": "北桥"
    }
  },
  {
    "label": "长度减一对应最后一个站名",
    "expect": {
      "type": "function",
      "name": "readStop",
      "args": [
        [
          "北桥",
          "西村",
          "河湾"
        ],
        2
      ],
      "value": "河湾"
    }
  },
  {
    "label": "下标等于长度时返回 null",
    "expect": {
      "type": "function",
      "name": "readStop",
      "args": [
        [
          "北桥",
          "西村"
        ],
        2
      ],
      "value": null
    }
  },
  {
    "label": "空数组返回 null",
    "expect": {
      "type": "function",
      "name": "readStop",
      "args": [
        [],
        0
      ],
      "value": null
    }
  },
  {
    "label": "负数下标返回 null",
    "expect": {
      "type": "function",
      "name": "readStop",
      "args": [
        [
          "北桥"
        ],
        -1
      ],
      "value": null
    }
  }
]
