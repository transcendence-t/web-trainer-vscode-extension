[
  {
    "label": "subscript 0 corresponds to the first station name",
    "expect": {
      "type": "function",
      "name": "readStop",
      "args": [
        [
          "North Bridge",
          "West Village",
          "Hewan"
        ],
        0
      ],
      "value": "North Bridge"
    }
  },
  {
    "label": "length minus one corresponds to the last station name",
    "expect": {
      "type": "function",
      "name": "readStop",
      "args": [
        [
          "North Bridge",
          "West Village",
          "Hewan"
        ],
        2
      ],
      "value": "Hewan"
    }
  },
  {
    "label": "Returns null when the subscript is equal to the length",
    "expect": {
      "type": "function",
      "name": "readStop",
      "args": [
        [
          "North Bridge",
          "West Village"
        ],
        2
      ],
      "value": null
    }
  },
  {
    "label": "empty array returns null",
    "expect": {
      "type": "function",
      "name": "readStop",
      "args": [
        [],
        0
      ],
      "value": null
    }
  },
  {
    "label": "Negative subscript returns null",
    "expect": {
      "type": "function",
      "name": "readStop",
      "args": [
        [
          "North Bridge"
        ],
        -1
      ],
      "value": null
    }
  }
]
