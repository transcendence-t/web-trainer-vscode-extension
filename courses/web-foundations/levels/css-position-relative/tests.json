[
  {
    "label": "exhibition label uses relative positioning",
    "expect": {
      "type": "style",
      "selector": ".featured-tag",
      "property": "position",
      "value": "relative"
    }
  },
  {
    "label": "Exhibition scroll 8px",
    "expect": {
      "type": "style",
      "selector": ".featured-tag",
      "property": "top",
      "value": "8px"
    }
  },
  {
    "label": "Exhibition label moved right 16px",
    "expect": {
      "type": "style",
      "selector": ".featured-tag",
      "property": "left",
      "value": "16px"
    }
  },
  {
    "label": "The first exhibition label is still within the dotted box",
    "expect": {
      "type": "layout",
      "selector": ".featured-tag",
      "relativeTo": ".tag-stack",
      "relation": "inside"
    }
  },
  {
    "label": "numbered exhibition label is still below",
    "expect": {
      "type": "layout",
      "selector": ".shelf-note",
      "relativeTo": ".featured-tag",
      "relation": "below"
    }
  }
]
