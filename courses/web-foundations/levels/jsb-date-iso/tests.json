[
  {
    "label": "The correct time zone may fall into the previous day",
    "expect": {
      "type": "function",
      "name": "archiveDay",
      "args": [
        "2027-03-10T01:00:00+08:00"
      ],
      "value": "2027-03-09"
    }
  },
  {
    "label": "Negative time zones may fall into the next day",
    "expect": {
      "type": "function",
      "name": "archiveDay",
      "args": [
        "2027-03-10T23:20:00-05:00"
      ],
      "value": "2027-03-11"
    }
  },
  {
    "label": "retains the date when it is already UTC",
    "expect": {
      "type": "function",
      "name": "archiveDay",
      "args": [
        "2028-02-29T04:00:00Z"
      ],
      "value": "2028-02-29"
    }
  }
]
