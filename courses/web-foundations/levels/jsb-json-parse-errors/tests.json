[
  {
    "label": "The legal array is read according to the original content.",
    "expect": {
      "type": "function",
      "name": "readChecklist",
      "args": [
        "[\"paper\",\"pen\"]"
      ],
      "value": [
        "paper",
        "pen"
      ]
    }
  },
  {
    "label": "elements of different types remain",
    "expect": {
      "type": "function",
      "name": "readChecklist",
      "args": [
        "[0,false,null]"
      ],
      "value": [
        0,
        false,
        null
      ]
    }
  },
  {
    "label": "Unclosed text gets empty array",
    "expect": {
      "type": "function",
      "name": "readChecklist",
      "args": [
        "[\"paper\""
      ],
      "value": []
    }
  },
  {
    "label": "Ordinary objects also do not conform to the import format",
    "expect": {
      "type": "function",
      "name": "readChecklist",
      "args": [
        "{\"name\":\"pen\"}"
      ],
      "value": []
    }
  },
  {
    "label": "A single null is not an array",
    "expect": {
      "type": "function",
      "name": "readChecklist",
      "args": [
        "null"
      ],
      "value": []
    }
  }
]
