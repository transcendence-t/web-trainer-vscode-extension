[
  {
    "label": "list contains three items",
    "expect": {
      "type": "count",
      "selector": "#equipment > li",
      "value": 3
    }
  },
  {
    "label": "The first item is the keyboard",
    "expect": {
      "type": "text",
      "selector": "#equipment > li:nth-child(1)",
      "value": "keyboard"
    }
  },
  {
    "label": "The second item is the mouse",
    "expect": {
      "type": "text",
      "selector": "#equipment > li:nth-child(2)",
      "value": "mouse"
    }
  },
  {
    "label": "The third item is the monitor",
    "expect": {
      "type": "text",
      "selector": "#equipment > li:nth-child(3)",
      "value": "monitor"
    }
  }
]
