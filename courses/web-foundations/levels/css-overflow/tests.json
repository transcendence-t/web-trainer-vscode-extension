[
  {
    "label": "recording area maintains the specified height",
    "expect": {
      "type": "style",
      "selector": ".history",
      "property": "height",
      "value": "124px"
    }
  },
  {
    "label": "Allow vertical scrolling when content exceeds",
    "expect": {
      "type": "style",
      "selector": ".history",
      "property": "overflow-y",
      "value": "auto"
    }
  },
  {
    "label": "The last record enters the box after clicking the link",
    "expect": {
      "type": "layout",
      "selector": "#last-record",
      "relativeTo": ".history",
      "relation": "inside"
    },
    "actions": [
      {
        "type": "click",
        "selector": "#jump-last-record"
      }
    ]
  }
]
