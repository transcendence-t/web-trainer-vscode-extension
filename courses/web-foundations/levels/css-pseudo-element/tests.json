[
  {
    "label": "generates pseudo elements with empty content",
    "expect": {
      "type": "style",
      "selector": ".notice-title",
      "property": "content",
      "value": "\"\"",
      "pseudo": "::before"
    }
  },
  {
    "label": "Inline box size can be specified",
    "expect": {
      "type": "style",
      "selector": ".notice-title",
      "property": "display",
      "value": "inline-block",
      "pseudo": "::before"
    }
  },
  {
    "label": "short bar width 6px",
    "expect": {
      "type": "style",
      "selector": ".notice-title",
      "property": "width",
      "value": "6px",
      "pseudo": "::before"
    }
  },
  {
    "label": "short bar height 16px",
    "expect": {
      "type": "style",
      "selector": ".notice-title",
      "property": "height",
      "value": "16px",
      "pseudo": "::before"
    }
  },
  {
    "label": "short bar has specified background color",
    "expect": {
      "type": "style",
      "selector": ".notice-title",
      "property": "background-color",
      "value": "rgb(18, 90, 70)",
      "pseudo": "::before"
    }
  },
  {
    "label": "Leave 8px gap between the title and the title",
    "expect": {
      "type": "style",
      "selector": ".notice-title",
      "property": "margin-right",
      "value": "8px",
      "pseudo": "::before"
    }
  }
]
