[
  {
    "label": "label points to the workstation drop-down box",
    "expect": {
      "type": "text",
      "selector": "form label[for=\"bench\"]",
      "value": "maintenance station"
    }
  },
  {
    "label": "The drop-down box contains three items for single selection",
    "expect": {
      "type": "count",
      "selector": "form select#bench[name=\"bench\"]:not([multiple]) option",
      "value": 3
    }
  },
  {
    "label": "woodworking bench has corresponding values",
    "expect": {
      "type": "text",
      "selector": "#bench option[value=\"wood\"]",
      "value": "woodworking bench"
    }
  },
  {
    "label": "electronic station has corresponding value and is selected when opening",
    "expect": {
      "type": "text",
      "selector": "#bench option[value=\"electronics\"][selected]:checked",
      "value": "electronic station"
    }
  },
  {
    "label": "bicycle platform has corresponding values",
    "expect": {
      "type": "text",
      "selector": "#bench option[value=\"bike\"]",
      "value": "bicycle platform"
    }
  }
]
