[
  {
    "label": "displays an empty list when opening it for the first time",
    "expect": {
      "type": "text",
      "selector": "#gear-empty:not([hidden])",
      "value": "list is empty"
    }
  },
  {
    "label": "When there are already two items, reopening will restore the two items.",
    "expect": {
      "type": "count",
      "selector": "#gear-list > li",
      "value": 2
    },
    "storage": {
      "fieldGear": "[\"kettle\",\"map, tide record\"]"
    }
  },
  {
    "label": "Preserve commas in names when restoring",
    "expect": {
      "type": "text",
      "selector": "#gear-list > li:nth-child(2)",
      "value": "map, tide record"
    },
    "storage": {
      "fieldGear": "[\"kettle\",\"map, tide record\"]"
    }
  },
  {
    "label": "Add and save the complete JSON at the end of the existing list",
    "expect": {
      "type": "storage",
      "key": "fieldGear",
      "value": "[\"kettle\",\"map, tide record\",\"flashlight\"]"
    },
    "storage": {
      "fieldGear": "[\"kettle\",\"map, tide record\"]"
    },
    "actions": [
      {
        "type": "input",
        "selector": "#gear-item",
        "value": "flashlight"
      },
      {
        "type": "click",
        "selector": "#add-gear"
      }
    ]
  },
  {
    "label": "Add items and update the interface at the same time",
    "expect": {
      "type": "text",
      "selector": "#gear-list > li:nth-child(3)",
      "value": "flashlight"
    },
    "storage": {
      "fieldGear": "[\"kettle\",\"map, tide record\"]"
    },
    "actions": [
      {
        "type": "input",
        "selector": "#gear-item",
        "value": "flashlight"
      },
      {
        "type": "click",
        "selector": "#add-gear"
      }
    ]
  },
  {
    "label": "Two items added continuously are saved in order.",
    "expect": {
      "type": "storage",
      "key": "fieldGear",
      "value": "[\"compass\",\"moisture-proof bag\"]"
    },
    "actions": [
      {
        "type": "input",
        "selector": "#gear-item",
        "value": "compass"
      },
      {
        "type": "click",
        "selector": "#add-gear"
      },
      {
        "type": "input",
        "selector": "#gear-item",
        "value": "moisture-proof bag"
      },
      {
        "type": "click",
        "selector": "#add-gear"
      }
    ]
  },
  {
    "label": "Blank projects do not create storage records",
    "expect": {
      "type": "storage",
      "key": "fieldGear",
      "value": null
    },
    "actions": [
      {
        "type": "input",
        "selector": "#gear-item",
        "value": "   "
      },
      {
        "type": "click",
        "selector": "#add-gear"
      }
    ]
  }
]
