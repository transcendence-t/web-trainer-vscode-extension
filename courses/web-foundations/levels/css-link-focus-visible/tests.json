[
  {
    "label": "No custom outline when not focused",
    "expect": {
      "type": "style",
      "selector": ".guide",
      "property": "outline-style",
      "value": "none"
    }
  },
  {
    "label": "The focused outline is a solid line",
    "expect": {
      "type": "style",
      "selector": ".guide",
      "property": "outline-style",
      "value": "solid"
    },
    "actions": [
      {
        "type": "focus",
        "selector": ".guide"
      }
    ]
  },
  {
    "label": "The outline color is correct after focusing",
    "expect": {
      "type": "style",
      "selector": ".guide",
      "property": "outline-color",
      "value": "rgb(18, 90, 70)"
    },
    "actions": [
      {
        "type": "focus",
        "selector": ".guide"
      }
    ]
  },
  {
    "label": "The focused outline is 3px wide",
    "expect": {
      "type": "style",
      "selector": ".guide",
      "property": "outline-width",
      "value": "3px"
    },
    "actions": [
      {
        "type": "focus",
        "selector": ".guide"
      }
    ]
  },
  {
    "label": "The distance between the outline and the element is 3px",
    "expect": {
      "type": "style",
      "selector": ".guide",
      "property": "outline-offset",
      "value": "3px"
    },
    "actions": [
      {
        "type": "focus",
        "selector": ".guide"
      }
    ]
  }
]
