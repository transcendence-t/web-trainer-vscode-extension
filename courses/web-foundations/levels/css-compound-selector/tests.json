[
  {
    "label": "uses warning colors when it meets two categories",
    "expect": {
      "type": "style",
      "selector": "#urgent-notice",
      "property": "color",
      "value": "rgb(124, 70, 14)"
    }
  },
  {
    "label": "Ordinary announcements still use the default color",
    "expect": {
      "type": "style",
      "selector": "#plain-notice",
      "property": "color",
      "value": "rgb(36, 52, 71)"
    }
  },
  {
    "label": "single urgent is not affected",
    "expect": {
      "type": "style",
      "selector": "#plain-urgent",
      "property": "color",
      "value": "rgb(36, 52, 71)"
    }
  }
]
