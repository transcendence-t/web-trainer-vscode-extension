[
  {
    "label": "Accumulate the weight in the object",
    "expect": {
      "type": "function",
      "name": "totalGrams",
      "args": [
        [
          {
            "grams": 80
          },
          {
            "grams": 120
          }
        ]
      ],
      "value": 200
    }
  },
  {
    "label": "supports single record",
    "expect": {
      "type": "function",
      "name": "totalGrams",
      "args": [
        [
          {
            "grams": 12
          }
        ]
      ],
      "value": 12
    }
  },
  {
    "label": "Zero weight is reserved as a valid item",
    "expect": {
      "type": "function",
      "name": "totalGrams",
      "args": [
        [
          {
            "grams": 0
          },
          {
            "grams": 7
          },
          {
            "grams": 5
          }
        ]
      ],
      "value": 12
    }
  },
  {
    "label": "The empty list totals zero",
    "expect": {
      "type": "function",
      "name": "totalGrams",
      "args": [
        []
      ],
      "value": 0
    }
  }
]
