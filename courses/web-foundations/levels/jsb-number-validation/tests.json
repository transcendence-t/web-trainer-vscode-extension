[
  {
    "label": "left and right spaces will not affect valid decimals",
    "expect": {
      "type": "function",
      "name": "readAmount",
      "args": [
        " -2.75 "
      ],
      "value": -2.75
    }
  },
  {
    "label": "Reserved zero",
    "expect": {
      "type": "function",
      "name": "readAmount",
      "args": [
        "0"
      ],
      "value": 0
    }
  },
  {
    "label": "Blank is invalid",
    "expect": {
      "type": "function",
      "name": "readAmount",
      "args": [
        " \t "
      ],
      "value": null
    }
  },
  {
    "label": "rejects strings that are preceded only by numbers",
    "expect": {
      "type": "function",
      "name": "readAmount",
      "args": [
        "18kg"
      ],
      "value": null
    }
  },
  {
    "label": "Infinity is invalid",
    "expect": {
      "type": "function",
      "name": "readAmount",
      "args": [
        "Infinity"
      ],
      "value": null
    }
  }
]
