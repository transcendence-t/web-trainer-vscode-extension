[
  {
    "label": "button background is green",
    "expect": {
      "type": "style",
      "selector": ".signup",
      "property": "background-color",
      "value": "rgb(18, 90, 70)"
    }
  },
  {
    "label": "button text is white",
    "expect": {
      "type": "style",
      "selector": ".signup",
      "property": "color",
      "value": "rgb(255, 255, 255)"
    }
  },
  {
    "label": "Padding changes with direction",
    "expect": {
      "type": "style",
      "selector": ".signup",
      "property": "padding",
      "value": "8px 16px"
    }
  },
  {
    "label": "button has capsule rounded corners",
    "expect": {
      "type": "style",
      "selector": ".signup",
      "property": "border-radius",
      "value": "999px"
    }
  }
]
