[
  {
    "label": "Two boxes updated according to their respective quantities",
    "expect": {
      "type": "function",
      "name": "runBoxes",
      "args": [
        4,
        8,
        3,
        1
      ],
      "value": [
        9,
        9
      ]
    }
  },
  {
    "label": "is stored in the first box twice",
    "expect": {
      "type": "function",
      "name": "runBoxes",
      "args": [
        0,
        12,
        6,
        0
      ],
      "value": [
        8,
        12
      ]
    }
  },
  {
    "label": "The second box update will not affect the first box",
    "expect": {
      "type": "function",
      "name": "runBoxes",
      "args": [
        10,
        0,
        0,
        5
      ],
      "value": [
        12,
        5
      ]
    }
  }
]
