[
  {
    "label": "The record on display turns green",
    "expect": {
      "type": "style",
      "selector": "#new",
      "property": "color",
      "value": "rgb(18, 90, 70)"
    }
  },
  {
    "label": "archive records retain default color",
    "expect": {
      "type": "style",
      "selector": "#old",
      "property": "color",
      "value": "rgb(36, 52, 71)"
    }
  },
  {
    "label": "normal prompts are not affected",
    "expect": {
      "type": "style",
      "selector": "#plain",
      "property": "color",
      "value": "rgb(36, 52, 71)"
    }
  }
]
