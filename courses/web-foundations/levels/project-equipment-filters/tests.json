[
  {
    "label": "opens for the first time and displays all four items.",
    "expect": {
      "type": "text",
      "selector": "#count",
      "value": "4 items in total"
    }
  },
  {
    "label": "First time in ascending order",
    "expect": {
      "type": "text",
      "selector": "#equipment li:first-child",
      "value": "Tripod Kit · 10 minutes"
    }
  },
  {
    "label": "text search retains three Kits",
    "expect": {
      "type": "count",
      "selector": "#equipment li",
      "value": 3
    },
    "actions": [
      {
        "type": "input",
        "selector": "#query",
        "value": " KIT "
      }
    ]
  },
  {
    "label": "Searching Kit and Photography Studio at the same time only comes up with one item",
    "expect": {
      "type": "text",
      "selector": "#count",
      "value": "1 items in total"
    },
    "actions": [
      {
        "type": "input",
        "selector": "#query",
        "value": "kit"
      },
      {
        "type": "input",
        "selector": "#room",
        "value": "photo"
      }
    ]
  },
  {
    "label": "overlay design room filtering and descending order",
    "expect": {
      "type": "text",
      "selector": "#equipment li:first-child",
      "value": "Laser Kit · 35 minutes"
    },
    "actions": [
      {
        "type": "input",
        "selector": "#query",
        "value": "kit"
      },
      {
        "type": "input",
        "selector": "#room",
        "value": "design"
      },
      {
        "type": "input",
        "selector": "#order",
        "value": "desc"
      }
    ]
  },
  {
    "label": "Empty results clear the list and prompt",
    "expect": {
      "type": "text",
      "selector": "#count",
      "value": "No matching equipment"
    },
    "actions": [
      {
        "type": "input",
        "selector": "#query",
        "value": "Recorder"
      }
    ]
  },
  {
    "label": "Clear search and restore from original data",
    "expect": {
      "type": "count",
      "selector": "#equipment li",
      "value": 4
    },
    "actions": [
      {
        "type": "input",
        "selector": "#query",
        "value": "Recorder"
      },
      {
        "type": "input",
        "selector": "#query",
        "value": ""
      }
    ]
  }
]
