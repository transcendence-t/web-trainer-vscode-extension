[
  {
    "label": "card's parent measurable inline size",
    "expect": {
      "type": "style",
      "selector": ".slot",
      "property": "container-type",
      "value": "inline-size"
    }
  },
  {
    "label": "Narrow columns on the same screen are still vertical",
    "expect": {
      "type": "layout",
      "selector": "#small a",
      "relativeTo": "#small span",
      "relation": "below"
    }
  },
  {
    "label": "Switch the wide column to horizontal on the same screen",
    "expect": {
      "type": "layout",
      "selector": "#large a",
      "relativeTo": "#large span",
      "relation": "right-of"
    }
  },
  {
    "label": "Actual flexible layout for wide column applications",
    "expect": {
      "type": "style",
      "selector": "#large",
      "property": "display",
      "value": "flex"
    }
  }
]
