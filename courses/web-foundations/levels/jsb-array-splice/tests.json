[
  {
    "label": "replaces the middle position",
    "expect": {
      "type": "function",
      "name": "swapDevice",
      "args": [
        [
          "power supply",
          "small lamp",
          "protective gear"
        ],
        1,
        "probe"
      ],
      "value": [
        "power supply",
        "probe",
        "protective gear"
      ]
    }
  },
  {
    "label": "replaces the first item",
    "expect": {
      "type": "function",
      "name": "swapDevice",
      "args": [
        [
          "A",
          "B"
        ],
        0,
        "X"
      ],
      "value": [
        "X",
        "B"
      ]
    }
  },
  {
    "label": "crosses the boundary and does not add",
    "expect": {
      "type": "function",
      "name": "swapDevice",
      "args": [
        [
          "A"
        ],
        1,
        "X"
      ],
      "value": [
        "A"
      ]
    }
  },
  {
    "label": "Negative subscripts are not replaced from the end",
    "expect": {
      "type": "function",
      "name": "swapDevice",
      "args": [
        [
          "A",
          "B"
        ],
        -1,
        "X"
      ],
      "value": [
        "A",
        "B"
      ]
    }
  },
  {
    "label": "empty queue remains empty",
    "expect": {
      "type": "function",
      "name": "swapDevice",
      "args": [
        [],
        0,
        "X"
      ],
      "value": []
    }
  }
]
