[
  {
    "label": "The two input boxes still retain their labels and names.",
    "expect": {
      "type": "count",
      "selector": "label[for=\"email\"], label[for=\"work\"], input[name=\"email\"][required], input[name=\"work\"][required]",
      "value": 4
    }
  },
  {
    "label": "Email rejects input missing @",
    "expect": {
      "type": "exists",
      "selector": "#email:invalid"
    },
    "actions": [
      {
        "type": "input",
        "selector": "#email",
        "value": "student.example.org"
      }
    ]
  },
  {
    "label": "Normal email is valid",
    "expect": {
      "type": "exists",
      "selector": "#email:valid"
    },
    "actions": [
      {
        "type": "input",
        "selector": "#email",
        "value": "student@example.org"
      }
    ]
  },
  {
    "label": "URL rejects site relative address",
    "expect": {
      "type": "exists",
      "selector": "#work:invalid"
    },
    "actions": [
      {
        "type": "input",
        "selector": "#work",
        "value": "/gallery/item"
      }
    ]
  },
  {
    "label": "full URL is valid",
    "expect": {
      "type": "exists",
      "selector": "#work:valid"
    },
    "actions": [
      {
        "type": "input",
        "selector": "#work",
        "value": "https://example.org/gallery"
      }
    ]
  }
]
