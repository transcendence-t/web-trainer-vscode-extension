[
  {
    "label": "The original price of the printmaking course has strikethroughs.",
    "expect": {
      "type": "style",
      "selector": "article:nth-of-type(1) .old-price",
      "property": "text-decoration-line",
      "value": "line-through"
    }
  },
  {
    "label": "Paper art class original price has strikethrough",
    "expect": {
      "type": "style",
      "selector": "article:nth-of-type(2) .old-price",
      "property": "text-decoration-line",
      "value": "line-through"
    }
  },
  {
    "label": "Printmaking class current price remains as is",
    "expect": {
      "type": "style",
      "selector": "article:nth-of-type(1) .current-price",
      "property": "text-decoration-line",
      "value": "none"
    }
  },
  {
    "label": "paper art class current price remains as is",
    "expect": {
      "type": "style",
      "selector": "article:nth-of-type(2) .current-price",
      "property": "text-decoration-line",
      "value": "none"
    }
  },
  {
    "label": "Printmaking class price The entire line has no decorative lines",
    "expect": {
      "type": "style",
      "selector": "article:nth-of-type(1) > p",
      "property": "text-decoration-line",
      "value": "none"
    }
  },
  {
    "label": "paper art class price whole row without decorative lines",
    "expect": {
      "type": "style",
      "selector": "article:nth-of-type(2) > p",
      "property": "text-decoration-line",
      "value": "none"
    }
  }
