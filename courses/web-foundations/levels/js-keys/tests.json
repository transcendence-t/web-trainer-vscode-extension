[
  {
    "label": "Table cards are not updated temporarily when entering text.",
    "expect": {
      "type": "text",
      "selector": "#table-card",
      "value": "has not been set yet"
    },
    "actions": [
      {
        "type": "input",
        "selector": "#table-name",
        "value": "ceramic table"
      }
    ]
  },
  {
    "label": "Press Enter to display new table cards",
    "expect": {
      "type": "text",
      "selector": "#table-card",
      "value": "ceramic table"
    },
    "actions": [
      {
        "type": "input",
        "selector": "#table-name",
        "value": "ceramic table"
      },
      {
        "type": "key",
        "selector": "#table-name",
        "key": "Enter"
      }
    ]
  },
  {
    "label": "Table cards are not confirmed when pressing Escape",
    "expect": {
      "type": "text",
      "selector": "#table-card",
      "value": "has not been set yet"
    },
    "actions": [
      {
        "type": "input",
        "selector": "#table-name",
        "value": "Printmaking table"
      },
      {
        "type": "key",
        "selector": "#table-name",
        "key": "Escape"
      }
    ]
  },
  {
    "label": "Keep the last confirmed name the next time you press the letter key",
    "expect": {
      "type": "text",
      "selector": "#table-card",
      "value": "carpentry table"
    },
    "actions": [
      {
        "type": "input",
        "selector": "#table-name",
        "value": "carpentry table"
      },
      {
        "type": "key",
        "selector": "#table-name",
        "key": "Enter"
      },
      {
        "type": "input",
        "selector": "#table-name",
        "value": "Printmaking table"
      },
      {
        "type": "key",
        "selector": "#table-name",
        "key": "a"
      }
    ]
  },
  {
    "label": "Press Enter again to update the table cards",
    "expect": {
      "type": "text",
      "selector": "#table-card",
      "value": "Printmaking table"
    },
    "actions": [
      {
        "type": "input",
        "selector": "#table-name",
        "value": "carpentry table"
      },
      {
        "type": "key",
        "selector": "#table-name",
        "key": "Enter"
      },
      {
        "type": "input",
        "selector": "#table-name",
        "value": "Printmaking table"
      },
      {
        "type": "key",
        "selector": "#table-name",
        "key": "Enter"
      }
    ]
  }
]
