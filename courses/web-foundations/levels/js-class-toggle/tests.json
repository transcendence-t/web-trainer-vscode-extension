[
  {
    "label": "Initially the button does not have a collection category",
    "expect": {
      "type": "count",
      "selector": "#save-resource.is-saved",
      "value": 0
    }
  },
  {
    "label": "The button is not pressed at first",
    "expect": {
      "type": "attribute",
      "selector": "#save-resource",
      "name": "aria-pressed",
      "value": "false"
    }
  },
  {
    "label": "Initially the button displays a light background",
    "expect": {
      "type": "style",
      "selector": "#save-resource",
      "property": "background-color",
      "value": "rgb(226, 241, 235)"
    }
  },
  {
    "label": "Click to add favorites for the first time",
    "expect": {
      "type": "exists",
      "selector": "#save-resource.is-saved"
    },
    "actions": [
      {
        "type": "click",
        "selector": "#save-resource"
      }
    ]
  },
  {
    "label": "After collection, the button status is recorded as pressed.",
    "expect": {
      "type": "attribute",
      "selector": "#save-resource",
      "name": "aria-pressed",
      "value": "true"
    },
    "actions": [
      {
        "type": "click",
        "selector": "#save-resource"
      }
    ]
  },
  {
    "label": "The button background changes to dark green after collection",
    "expect": {
      "type": "style",
      "selector": "#save-resource",
      "property": "background-color",
      "value": "rgb(18, 90, 70)"
    },
    "actions": [
      {
        "type": "click",
        "selector": "#save-resource"
      }
    ]
  },
  {
    "label": "Click for the second time to remove the collection category",
    "expect": {
      "type": "count",
      "selector": "#save-resource.is-saved",
      "value": 0
    },
    "actions": [
      {
        "type": "click",
        "selector": "#save-resource"
      },
      {
        "type": "click",
        "selector": "#save-resource"
      }
    ]
  },
  {
    "label": "Return to unpressed state after canceling collection",
    "expect": {
      "type": "attribute",
      "selector": "#save-resource",
      "name": "aria-pressed",
      "value": "false"
    },
    "actions": [
      {
        "type": "click",
        "selector": "#save-resource"
      },
      {
        "type": "click",
        "selector": "#save-resource"
      }
    ]
  },
  {
    "label": "Restore light background after canceling collection",
    "expect": {
      "type": "style",
      "selector": "#save-resource",
      "property": "background-color",
      "value": "rgb(226, 241, 235)"
    },
    "actions": [
      {
        "type": "click",
        "selector": "#save-resource"
      },
      {
        "type": "click",
        "selector": "#save-resource"
      }
    ]
  }
]
