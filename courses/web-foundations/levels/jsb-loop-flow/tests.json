[
  {
    "label": "Stop after encountering the first over-limit item",
    "expect": {
      "type": "function",
      "name": "fillCrate",
      "args": [
        [
          4,
          5,
          1
        ],
        8
      ],
      "value": 4
    }
  },
  {
    "label": "skips negative numbers and allows exactly full",
    "expect": {
      "type": "function",
      "name": "fillCrate",
      "args": [
        [
          -1,
          2,
          -5,
          4
        ],
        6
      ],
      "value": 6
    }
  },
  {
    "label": "If the first item cannot be installed, it will end immediately.",
    "expect": {
      "type": "function",
      "name": "fillCrate",
      "args": [
        [
          10,
          1
        ],
        5
      ],
      "value": 0
    }
  },
  {
    "label": "The total amount of empty lists is zero",
    "expect": {
      "type": "function",
      "name": "fillCrate",
      "args": [
        [],
        12
      ],
      "value": 0
    }
  }
]
