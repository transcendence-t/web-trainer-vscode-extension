[
  {
    "label": "session group has legend title",
    "expect": {
      "type": "text",
      "selector": "form fieldset > legend:first-child",
      "value": "arrival time"
    }
  },
  {
    "label": "group",
    "expect": {
      "type": "count",
      "selector": "form fieldset:has(> legend) input[type=\"radio\"][name=\"slot\"]",
      "value": 2
    }
  },
  {
    "label": "The last clicked afternoon session was selected",
    "expect": {
      "type": "exists",
      "selector": "form fieldset input[type=\"radio\"][value=\"afternoon\"]:checked"
    },
    "actions": [
      {
        "type": "click",
        "selector": "input[value=\"morning\"]"
      },
      {
        "type": "click",
        "selector": "input[value=\"afternoon\"]"
      }
    ]
  },
  {
    "label": "After clicking two time periods one after another, only one item is still selected.",
    "expect": {
      "type": "count",
      "selector": "form fieldset input[type=\"radio\"]:checked",
      "value": 1
    },
    "actions": [
      {
        "type": "click",
        "selector": "input[value=\"morning\"]"
      },
      {
        "type": "click",
        "selector": "input[value=\"afternoon\"]"
      }
    ]
  }
]
