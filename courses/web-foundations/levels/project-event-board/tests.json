[
  {
    "label": "category",
    "expect": {
      "type": "text",
      "selector": "#event-category option[value=\"tour\"]",
      "value": "Tour"
    }
  },
  {
    "label": "originally showed four events",
    "expect": {
      "type": "count",
      "selector": "#event-list > li",
      "value": 4
    }
  },
  {
    "label": "After selecting the workshop, two activities will be displayed",
    "expect": {
      "type": "count",
      "selector": "#event-list > li",
      "value": 2
    },
    "actions": [
      {
        "type": "input",
        "selector": "#event-category",
        "value": "workshop"
      }
    ]
  },
  {
    "label": "After switching to the tour, the workshops were all removed.",
    "expect": {
      "type": "count",
      "selector": "#event-list > li[data-category=\"workshop\"]",
      "value": 0
    },
    "actions": [
      {
        "type": "input",
        "selector": "#event-category",
        "value": "workshop"
      },
      {
        "type": "input",
        "selector": "#event-category",
        "value": "tour"
      }
    ]
  },
  {
    "label": "Show botanical garden activities after switching to tour",
    "expect": {
      "type": "text",
      "selector": "#event-list [data-event-id=\"garden\"] h2",
      "value": "Botanical Garden Guide"
    },
    "actions": [
      {
        "type": "input",
        "selector": "#event-category",
        "value": "workshop"
      },
      {
        "type": "input",
        "selector": "#event-category",
        "value": "tour"
      }
    ]
  },
  {
    "label": "Resume four events after switching back to all",
    "expect": {
      "type": "count",
      "selector": "#event-list > li",
      "value": 4
    },
    "actions": [
      {
        "type": "input",
        "selector": "#event-category",
        "value": "tour"
      },
      {
        "type": "input",
        "selector": "#event-category",
        "value": "all"
      }
    ]
  },
  {
    "label": "Apply dark green background after collection",
    "expect": {
      "type": "style",
      "selector": "#event-list [data-event-id=\"print\"] .favorite-button",
      "property": "background-color",
      "value": "rgb(18, 90, 70)"
    },
    "actions": [
      {
        "type": "click",
        "selector": "#event-list [data-event-id=\"print\"] .favorite-button"
      }
    ]
  },
  {
    "label": "Apply white text after collection",
    "expect": {
      "type": "style",
      "selector": "#event-list [data-event-id=\"print\"] .favorite-button",
      "property": "color",
      "value": "rgb(255, 255, 255)"
    },
    "actions": [
      {
        "type": "click",
        "selector": "#event-list [data-event-id=\"print\"] .favorite-button"
      }
    ]
  },
  {
    "label": "The collection status still exists when switching categories and coming back.",
    "expect": {
      "type": "attribute",
      "selector": "#event-list [data-event-id=\"print\"] .favorite-button",
      "name": "aria-pressed",
      "value": "true"
    },
    "actions": [
      {
        "type": "click",
        "selector": "#event-list [data-event-id=\"print\"] .favorite-button"
      },
      {
        "type": "input",
        "selector": "#event-category",
        "value": "tour"
      },
      {
        "type": "input",
        "selector": "#event-category",
        "value": "workshop"
      }
    ]
  },
  {
    "label": "Write two complete IDs for two collections",
    "expect": {
      "type": "storage",
      "key": "campusEventFavorites",
      "value": "[\"print\",\"sound\"]"
    },
    "actions": [
      {
        "type": "click",
        "selector": "#event-list [data-event-id=\"print\"] .favorite-button"
      },
      {
        "type": "click",
        "selector": "#event-list [data-event-id=\"sound\"] .favorite-button"
      }
    ]
  },
  {
    "label": "Click the same event again to cancel the collection",
    "expect": {
      "type": "storage",
      "key": "campusEventFavorites",
      "value": "[]"
    },
    "actions": [
      {
        "type": "click",
        "selector": "#event-list [data-event-id=\"print\"] .favorite-button"
      },
      {
        "type": "click",
        "selector": "#event-list [data-event-id=\"print\"] .favorite-button"
      }
    ]
  },
  {
    "label": "The button returns to the unselected state after canceling the collection.",
    "expect": {
      "type": "attribute",
      "selector": "#event-list [data-event-id=\"print\"] .favorite-button",
      "name": "aria-pressed",
      "value": "false"
    },
    "actions": [
      {
        "type": "click",
        "selector": "#event-list [data-event-id=\"print\"] .favorite-button"
      },
      {
        "type": "click",
        "selector": "#event-list [data-event-id=\"print\"] .favorite-button"
      }
    ]
  },
  {
    "label": "displays the original collection of activities when opened",
    "expect": {
      "type": "attribute",
      "selector": "#event-list [data-event-id=\"museum\"] .favorite-button",
      "name": "aria-pressed",
      "value": "true"
    },
    "storage": {
      "campusEventFavorites": "[\"museum\",\"print\"]"
    }
  },
  {
    "label": "Keep another event after canceling the old collection",
    "expect": {
      "type": "storage",
      "key": "campusEventFavorites",
      "value": "[\"print\"]"
    },
    "storage": {
      "campusEventFavorites": "[\"museum\",\"print\"]"
    },
    "actions": [
      {
        "type": "input",
        "selector": "#event-category",
        "value": "tour"
      },
      {
        "type": "click",
        "selector": "#event-list [data-event-id=\"museum\"] .favorite-button"
      }
    ]
  }
]
