[
  {
    "label": "has semantic header and table of contents",
    "expect": {
      "type": "exists",
      "selector": "main > header#top + nav#links"
    }
  },
  {
    "label": "narrow screen content is at the bottom of the directory",
    "expect": {
      "type": "layout",
      "selector": "#status",
      "relativeTo": "#links",
      "relation": "below"
    },
    "viewport": 380
  },
  {
    "label": "narrow screen two cards arranged on top and bottom",
    "expect": {
      "type": "layout",
      "selector": "#model",
      "relativeTo": "#wood",
      "relation": "below"
    },
    "viewport": 380
  },
  {
    "label": "widescreen catalog width 160px",
    "expect": {
      "type": "style",
      "selector": "#links",
      "property": "width",
      "value": "160px"
    },
    "viewport": 820
  },
  {
    "label": "widescreen status area is on the right side of the directory",
    "expect": {
      "type": "layout",
      "selector": "#status",
      "relativeTo": "#links",
      "relation": "right-of"
    },
    "viewport": 820
  },
  {
    "label": "widescreen header covers the entire board width",
    "expect": {
      "type": "layout",
      "selector": "#top",
      "relativeTo": ".dashboard",
      "relation": "equal-width"
    },
    "viewport": 820
  },
  {
    "label": "widescreen cards side by side",
    "expect": {
      "type": "layout",
      "selector": "#model",
      "relativeTo": "#wood",
      "relation": "right-of"
    },
    "viewport": 820
  },
  {
    "label": "widescreen card equal width",
    "expect": {
      "type": "layout",
      "selector": "#model",
      "relativeTo": "#wood",
      "relation": "equal-width"
    },
    "viewport": 820
  }
]
