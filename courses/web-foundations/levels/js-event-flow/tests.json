[
  {
    "label": "button click to output in three stages sequence",
    "expect": {
      "type": "text",
      "selector": "#trace",
      "value": "outer layer capture → button → outer layer bubbling"
    },
    "actions": [
      {
        "type": "click",
        "selector": "#tap"
      }
    ]
  },
  {
    "label": "There is no button stage when only clicking on the outer layer",
    "expect": {
      "type": "text",
      "selector": "#trace",
      "value": "outer layer capture → outer layer bubbling"
    },
    "actions": [
      {
        "type": "click",
        "selector": "#pad"
      }
    ]
  },
  {
    "label": "Repeated clicks are recorded independently",
    "expect": {
      "type": "text",
      "selector": "#trace",
      "value": "outer layer capture → button → outer layer bubbling"
    },
    "actions": [
      {
        "type": "click",
        "selector": "#pad"
      },
      {
        "type": "click",
        "selector": "#tap"
      },
      {
        "type": "click",
        "selector": "#tap"
      }
    ]
  }
