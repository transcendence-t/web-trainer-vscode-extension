[
  {
    "label": "can accumulate twice continuously",
    "expect": {
      "type": "text",
      "selector": "#served",
      "value": "2"
    },
    "actions": [
      {
        "type": "click",
        "selector": "#serve"
      },
      {
        "type": "click",
        "selector": "#serve"
      }
    ]
  },
  {
    "label": "ends",
    "expect": {
      "type": "text",
      "selector": "#served",
      "value": "1"
    },
    "actions": [
      {
        "type": "click",
        "selector": "#serve"
      },
      {
        "type": "click",
        "selector": "#stop"
      },
      {
        "type": "click",
        "selector": "#serve"
      }
    ]
  },
  {
    "label": "can end without picking up the book",
    "expect": {
      "type": "text",
      "selector": "#served",
      "value": "0"
    },
    "actions": [
      {
        "type": "click",
        "selector": "#stop"
      },
      {
        "type": "click",
        "selector": "#serve"
      }
    ]
  }
]
