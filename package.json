{
  "name": "web-trainer",
  "displayName": "Web Trainer",
  "description": "Learn HTML, CSS, and JavaScript offline in VS Code through 240 hands-on lessons.",
  "publisher": "webclassroom",
  "version": "1.3.0",
  "license": "SEE LICENSE IN LICENSE.txt",
  "repository": {
    "type": "git",
    "url": "https://github.com/q634875942/web-trainer-vscode-extension.git"
  },
  "homepage": "https://github.com/q634875942/web-trainer-vscode-extension#readme",
  "bugs": { "url": "https://github.com/q634875942/web-trainer-vscode-extension/issues" },
  "engines": { "vscode": "^1.96.0" },
  "categories": ["Education"],
  "keywords": ["html", "css", "javascript", "education", "offline", "exercises"],
  "main": "./out/extension.js",
  "extensionKind": ["ui"],
  "capabilities": {
    "untrustedWorkspaces": { "supported": true },
    "virtualWorkspaces": { "supported": true }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:edition -- zh-cn && npm run test:edition -- en",
    "test:edition": "node scripts/test-edition.mjs",
    "test:vscode": "node test/vscode.mjs",
    "package": "npm run typecheck && node scripts/package.mjs",
    "vscode:prepublish": "npm run typecheck && npm run build"
  },
  "contributes": {
    "viewsContainers": {
      "activitybar": [{ "id": "webTrainer", "title": "Web Trainer", "icon": "media/activity.svg" }]
    },
    "views": {
      "webTrainer": [{ "id": "webTrainer.courses", "name": "Course Lessons" }]
    },
    "commands": [
      { "command": "webTrainer.start", "category": "Web Trainer", "title": "Start or Resume", "icon": "$(play)" },
      { "command": "webTrainer.check", "category": "Web Trainer", "title": "Check Answer" },
      { "command": "webTrainer.importCourse", "category": "Web Trainer", "title": "Import Course", "icon": "$(folder-opened)" },
      { "command": "webTrainer.exportCourse", "category": "Web Trainer", "title": "Export Course" },
      { "command": "webTrainer.revealFiles", "category": "Web Trainer", "title": "Open Practice Folder" }
    ],
    "menus": {
      "view/title": [
        { "command": "webTrainer.start", "when": "view == webTrainer.courses", "group": "navigation@1" },
        { "command": "webTrainer.importCourse", "when": "view == webTrainer.courses", "group": "navigation@2" },
        { "command": "webTrainer.exportCourse", "when": "view == webTrainer.courses", "group": "2_courses@1" }
      ]
    }
  },
  "devDependencies": {
    "@types/node": "22.19.11",
    "@types/vscode": "1.96.0",
    "@vscode/vsce": "4.1.1",
    "acorn": "8.19.0",
    "acorn-walk": "8.3.5",
    "debounce": "2.2.0",
    "esbuild": "0.28.2",
    "parse5": "8.1.1",
    "playwright-core": "1.65.1",
    "typescript": "5.9.3"
  }
}
