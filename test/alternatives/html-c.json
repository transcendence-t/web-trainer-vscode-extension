{
  "html-article": {
    "index.html": "<!doctype html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n  <title>Neighborhood Briefing</title>\n  <link rel=\"stylesheet\" href=\"style.css\">\n  <script src=\"script.js\" defer></script>\n</head>\n<body>\n<main class=\"sheet\">\n  <h1>Neighborhood Briefing</h1>\n  <article id=\"seed-swap\">\n    <header><h2>Seed Exchange Meeting</h2></header>\n    <p>On Saturday mornings we exchange seasonal seeds at the community garden.</p>\n    <section id=\"bring\">\n      <h3>What should you bring?</h3>\n      <p>Bring a bag of seeds and write the variety on the bag.</p>\n    </section>\n  </article>\n</main>\n</body>\n</html>\n"
  },
  "html-form-validation": {
    "index.html": "<!doctype html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n  <title>Self-service pickup</title>\n  <link rel=\"stylesheet\" href=\"style.css\">\n  <script src=\"script.js\" defer></script>\n</head>\n<body>\n<main class=\"sheet\">\n  <h1>Self-service pickup</h1>\n  <form>\n    <label for=\"pickup-code\">pickup code</label>\n    <input type=\"text\" id=\"pickup-code\" name=\"pickup\" required pattern=\"[A-Z][A-Z]\\d{4}\">\n    <p>pickup code consists of two uppercase English letters and four digits, such as AB0427.</p>\n    <button type=\"submit\">Check</button>\n  </form>\n</main>\n</body>\n</html>\n"
  }
