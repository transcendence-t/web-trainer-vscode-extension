  "html-article": {
    "index.html": "<!doctype html>\n<html lang=\"zh-CN\">\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n  <title>邻里简报</title>\n  <link rel=\"stylesheet\" href=\"style.css\">\n  <script src=\"script.js\" defer></script>\n</head>\n<body>\n<main class=\"sheet\">\n  <h1>邻里简报</h1>\n  <article id=\"seed-swap\">\n    <header><h2>种子交换会</h2></header>\n    <p>周六上午，我们会在社区花园交换当季种子。</p>\n    <section id=\"bring\">\n      <h3>请带上什么</h3>\n      <p>带一袋种子，在袋上写明品种。</p>\n    </section>\n  </article>\n</main>\n</body>\n</html>\n"
  },
  "html-form-validation": {
    "index.html": "<!doctype html>\n<html lang=\"zh-CN\">\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n  <title>自助取件</title>\n  <link rel=\"stylesheet\" href=\"style.css\">\n  <script src=\"script.js\" defer></script>\n</head>\n<body>\n<main class=\"sheet\">\n  <h1>自助取件</h1>\n  <form>\n    <label for=\"pickup-code\">取件码</label>\n    <input type=\"text\" id=\"pickup-code\" name=\"pickup\" required pattern=\"[A-Z][A-Z]\\d{4}\">\n    <p>取件码由两位大写英文字母和四位数字组成，如 AB0427。</p>\n    <button type=\"submit\">核对</button>\n  </form>\n</main>\n</body>\n</html>\n"
  }
