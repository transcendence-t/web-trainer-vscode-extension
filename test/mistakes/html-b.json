{
  "html-definition-list": {
    "name": "Use ordinary paragraphs to write the meaning of the resident bird",
    "files": {
      "index.html": "<!doctype html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n  <title>Glossary of Birding Terms</title>\n  <link rel=\"stylesheet\" href=\"style.css\">\n  <script src=\"script.js\" defer></script>\n</head>\n<body>\n<main class=\"sheet\">\n  <h1>Glossary of Birding Terms</h1>\n  <dl>\n    <dt>wingspan</dt>\n    <dd>The distance between the wing tips on both sides when the wings are unfolded.</dd>\n    <dt>resident bird</dt>\n    <p>A bird that stays in the same area year-round.</p>\n  </dl>\n</main>\n</body>\n</html>\n"
    }
  },
  "html-link": {
    "name": "The href of the anchor link misses the pound sign",
    "files": {
      "index.html": "<!doctype html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n  <title>In-page navigation</title>\n  <link rel=\"stylesheet\" href=\"style.css\">\n  <script src=\"script.js\" defer></script>\n</head>\n<body>\n  <main class=\"sheet\">\n    <h1>Campus training guide</h1>\n    <nav aria-label=\"In-page navigation\">\n      <a href=\"lab\">View training room</a>\n    </nav>\n    <section id=\"lab\">\n      <h2>Web Design Training Room</h2>\n      <p>Here you can practice making and debugging web pages.</p>\n    </section>\n  </main>\n</body>\n</html>\n"
    }
  },
  "html-image": {
    "name": "Write the picture description into the title attribute",
    "files": {
      "index.html": "<!doctype html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n  <title>Image and alt text</title>\n  <link rel=\"stylesheet\" href=\"style.css\">\n  <script src=\"script.js\" defer></script>\n</head>\n<body>\n  <main class=\"sheet\">\n    <h1>Get to know the training building</h1>\n    <figure>\n      <img src=\"data:image/png;base64,\" width=\"144\" height=\"76\" title=\"Schematic diagram of training building\">\n      <figcaption>Web Design Training Room</figcaption>\n    </figure>\n  </main>\n</body>\n</html>\n"
    }
  },
  "html-table": {
    "name": "Write mint and quantity into the same cell",
    "files": {
      "index.html": "<!doctype html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n  <title>Seedling breeding record this week</title>\n  <link rel=\"stylesheet\" href=\"style.css\">\n  <script src=\"script.js\" defer></script>\n</head>\n<body>\n<main class=\"sheet\">\n  <h1>Seedling breeding record this week</h1>\n  <table>\n    <tr>\n      <td>Mint 6 pots</td>\n    </tr>\n    <tr>\n      <td>Basil</td>\n      <td>4 basins</td>\n    </tr>\n  </table>\n</main>\n</body>\n</html>\n"
    }
  },
  "html-table-head": {
    "name": "Mark the row header of the calligraphy and painting room as the column header",
    "files": {
      "index.html": "<!doctype html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n  <title>Community Activity Center</title>\n  <link rel=\"stylesheet\" href=\"style.css\">\n  <script src=\"script.js\" defer></script>\n</head>\n<body>\n<main class=\"sheet\">\n  <h1>Community Activity Center</h1>\n  <table>\n    <caption>Venue opening hours</caption>\n    <thead>\n      <tr><th scope=\"col\">venue</th><th scope=\"col\">opening hours</th></tr>\n    </thead>\n    <tbody>\n      <tr><th scope=\"row\">table tennis room</th><td>09:00–12:00</td></tr>\n      <tr><th scope=\"col\">Painting and Calligraphy Studio</th><td>13:30–17:00</td></tr>\n    </tbody>\n  </table>\n</main>\n</body>\n</html>\n"
    }
  },
  "html-landmarks": {
    "name": "puts the full page footer into main",
    "files": {
      "index.html": "<!doctype html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n  <title>Riverside night run</title>\n  <link rel=\"stylesheet\" href=\"style.css\">\n  <script src=\"script.js\" defer></script>\n</head>\n<body>\n<div class=\"sheet\">\n  <header>\n    <h1>Riverside night run</h1>\n    <nav>\n      <a href=\"#meeting\">View meeting point</a>\n    </nav>\n  </header>\n  <main>\n    <h2 id=\"meeting\">meeting point</h2>\n    <p>Sign in at the east gate of Riverside Park at 19:30 on Friday.</p>\n    <footer>\n      <p>Riverside Running Group Maintenance</p>\n    </footer>\n  </main>\n</div>\n</body>\n</html>\n"
    }
  }
