{
  "html-meta-description": {
    "name": "Write the abstract as keywords",
    "files": {
      "index.html": "<!doctype html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n  <title>Write page metadata for the active page</title>\n  <link rel=\"stylesheet\" href=\"style.css\">\n  <script src=\"script.js\" defer></script>\n  <meta name=\"keywords\" content=\"Check the date, location and visit schedule of the campus open day\">\n</head>\n<body>\n  <main class=\"sheet\">\n    <h1>Write page metadata for the active page</h1>\n    <p>On the open day, you can visit the training room and sign up for a short-term experience.</p>\n  </main>\n</body>\n</html>\n"
    }
  },
  "html-heading-outline": {
    "name": "uses h4 for re-signing and skipping",
    "files": {
      "index.html": "<!doctype html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n  <title>Organize the title hierarchy of the freshman guide</title>\n  <link rel=\"stylesheet\" href=\"style.css\">\n  <script src=\"script.js\" defer></script>\n</head>\n<body>\n  <main class=\"sheet\">\n    <h1>Organize the title hierarchy of the freshman guide</h1>\n    <h2>check-in arrangement</h2>\n    <p>Freshmen please go to the lobby of the teaching building to get your sign-in card.</p>\n    <h4>re-signing</h4>\n    <p>You can apply for a reissue at the service desk in the afternoon.</p>\n    <h2>Card collection arrangement</h2>\n    <p>Go to the west side of the hall with your sign-in card to pick up the information bag.</p>\n  </main>\n</body>\n</html>\n"
    }
  },
  "html-time-abbr": {
    "name": "Use readable dates directly as datetime",
    "files": {
      "index.html": "<!doctype html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n  <title>Mark registration date and professional abbreviation</title>\n  <link rel=\"stylesheet\" href=\"style.css\">\n  <script src=\"script.js\" defer></script>\n</head>\n<body>\n  <main class=\"sheet\">\n    <h1>Mark registration date and professional abbreviation</h1>\n    <p>Registration deadline <time datetime=\"May 18\">May 18</time>, the activity will be demonstrated in the laboratory <abbr title=\"computer-aided design\">CAD</abbr> Technology.</p>\n  </main>\n</body>\n</html>\n"
    }
  },
  "html-quotes": {
    "name": "Write whole paragraphs and in-sentence quotations as ordinary paragraphs",
    "files": {
      "index.html": "<!doctype html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n  <title>Mark long citations, short citations and sources</title>\n  <link rel=\"stylesheet\" href=\"style.css\">\n  <script src=\"script.js\" defer></script>\n</head>\n<body>\n  <main class=\"sheet\">\n    <h1>Mark long citations, short citations and sources</h1>\n    <p>Document findings first, discuss explanations later.</p>\n    <p>from<cite>\"Community Observation Manual\"</cite></p>\n    <p>This week’s topic is<q>Pay attention to the changes around you</q>。</p>\n  </main>\n</body>\n</html>\n"
    }
  },
  "html-nested-lists": {
    "name": "Use an ordered list to express sub-items in no sequence",
    "files": {
      "index.html": "<!doctype html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n  <title>Put sublist into check step</title>\n  <link rel=\"stylesheet\" href=\"style.css\">\n  <script src=\"script.js\" defer></script>\n</head>\n<body>\n  <main class=\"sheet\">\n    <h1>Put sublist into check step</h1>\n    <ol id=\"checklist\">\n      <li>inspection equipment\n        <ol>\n          <li>power cord</li>\n          <li>protective case</li>\n        </ol>\n      </li>\n      <li>Submit record</li>\n    </ol>\n  </main>\n</body>\n</html>\n"
    }
  },
  "html-link-paths": {
    "name": "Missing ../ that returns to the previous directory",
    "files": {
      "index.html": "<!doctype html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n  <title>connects on-site pages, off-site pages and mailboxes</title>\n  <link rel=\"stylesheet\" href=\"style.css\">\n  <script src=\"script.js\" defer></script>\n</head>\n<body>\n  <main class=\"sheet\">\n    <h1>connects on-site pages, off-site pages and mailboxes</h1>\n    <ul>\n      <li><a id=\"rules\" href=\"./guides/loan.html\">borrowing rules</a></li>\n      <li><a id=\"library\" href=\"https://example.org/catalog/\">Collection Services</a></li>\n      <li><a id=\"write\" href=\"mailto:desk@example.org\">Send consultation email</a></li>\n    </ul>\n  </main>\n</body>\n</html>\n"
    }
  },
  "html-skip-link": {
    "name": "Point the link to the title in the navigation",
    "files": {
      "index.html": "<!doctype html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n  <title>Let keyboard users skip repetitive navigation</title>\n  <link rel=\"stylesheet\" href=\"style.css\">\n  <script src=\"script.js\" defer></script>\n</head>\n<body>\n  <a id=\"skip\" href=\"#hours\">Skip to main content</a>\n  <header>\n    <nav aria-label=\"Campus Services\"><a href=\"#hours\">opening hours</a> <a href=\"#rules\">borrowing rules</a></nav>\n  </header>\n  <main class=\"sheet\" id=\"main-content\" tabindex=\"-1\">\n    <h1 id=\"hours\">opening hours</h1>\n    <p>Open on weekdays.</p>\n    <h2 id=\"rules\">borrowing rules</h2>\n  </main>\n</body>\n</html>\n"
    }
  },
  "html-aside": {
    "name": "Mark the supplementary section only as a normal section",
    "files": {
      "index.html": "<!doctype html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n  <title>marked article</title>\n  <link rel=\"stylesheet\" href=\"style.css\">\n  <script src=\"script.js\" defer></script>\n</head>\n<body>\n  <main class=\"sheet\">\n    <h1>marked article</h1>\n    <article>\n      <h2>paper bridge</h2>\n      <p>Folding cardboard can change the way force is received.</p>\n      <section id=\"extension\">\n        <h3>Further reading</h3>\n        <p>Try to compare straight beams and arched structures.</p>\n      </section>\n    </article>\n  </main>\n</body>\n</html>\n"
    }
  },
  "html-image-sizing": {
    "name": "Fill in the file name for the decorative image that will be read aloud",
    "files": {
      "index.html": "<!doctype html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n  <title>Reserve space for pictures and process decorative pictures</title>\n  <link rel=\"stylesheet\" href=\"style.css\">\n  <script src=\"script.js\" defer></script>\n</head>\n<body>\n  <main class=\"sheet\">\n    <h1>Reserve space for pictures and process decorative pictures</h1>\n    <p><img id=\"decoration\" alt=\"marker.png\" width=\"24\" height=\"20\" src=\"data:image/png;base64,\"> Get the route map</p>\n    <figure>\n      <img id=\"building\" width=\"144\" height=\"76\" src=\"data:image/png;base64,\" alt=\"Front view of the training building\">\n      <figcaption>Schematic diagram of training building</figcaption>\n    </figure>\n  </main>\n</body>\n</html>\n"
    }
  },
  "html-responsive-picture": {
    "name": "Using max-width causes the small screen to see the panorama instead",
    "files": {
      "index.html": "<!doctype html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n  <title>chooses different compositions for wide and narrow screens</title>\n  <link rel=\"stylesheet\" href=\"style.css\">\n  <script src=\"script.js\" defer></script>\n</head>\n<body>\n  <main class=\"sheet\">\n    <h1>chooses different compositions for wide and narrow screens</h1>\n    <figure>\n      <picture>\n        <source media=\"(max-width: 600px)\" srcset=\"data:image/png;base64,\">\n        <img src=\"data:image/png;base64,\" alt=\"Campus trails and entrances\">\n      </picture>\n      <figcaption>trail entrance indication</figcaption>\n    </figure>\n  </main>\n</body>\n</html>\n"
    }
  },
  "html-audio-controls": {
    "name": "mistakenly thought that autoplay and controls would display the player",
    "files": {
      "index.html": "<!doctype html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n  <title>allows readers to manually play the prompt sound</title>\n  <link rel=\"stylesheet\" href=\"style.css\">\n  <script src=\"script.js\" defer></script>\n</head>\n<body>\n  <main class=\"sheet\">\n    <h1>allows readers to manually play the prompt sound</h1>\n    <p>Listen to the check-in prompt.</p>\n    <audio id=\"arrival\" autoplay preload=\"metadata\" aria-describedby=\"transcript\">\n      <source src=\"data:audio/wav;base64,\" type=\"audio/wav\">\n    </audio>\n    <p id=\"transcript\">Sound description: A short beep indicates that the check-in has been recorded.</p>\n  </main>\n</body>\n</html>\n"
    }
  },
  "html-table-spans": {
    "name": "retains the empty th below rowspan",
    "files": {
      "index.html": "<!doctype html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n  <title>allows the two layers of headers to be correctly aligned</title>\n  <link rel=\"stylesheet\" href=\"style.css\">\n  <script src=\"script.js\" defer></script>\n</head>\n<body>\n  <main class=\"sheet\">\n    <h1>allows the two layers of headers to be correctly aligned</h1>\n    <table>\n      <caption>Weekend venue schedule</caption>\n      <thead>\n        <tr><th scope=\"col\" rowspan=\"2\">Venue</th><th colspan=\"2\">Saturday and Sunday</th></tr>\n        <tr><th></th><th scope=\"col\">Saturday</th><th scope=\"col\">Sunday</th></tr>\n      </thead>\n      <tbody>\n        <tr><th scope=\"row\">Wood Workshop</th><td>Morning</td><td>Afternoon</td></tr>\n      </tbody>\n    </table>\n  </main>\n</body>\n</html>\n"
    }
  },
  "html-table-footer": {
    "name": "added the table footer but also repeated the summary in the details",
    "files": {
      "index.html": "<!doctype html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n  <title>Put the total into the table footer</title>\n  <link rel=\"stylesheet\" href=\"style.css\">\n  <script src=\"script.js\" defer></script>\n</head>\n<body>\n  <main class=\"sheet\">\n    <h1>Put the total into the table footer</h1>\n    <table>\n      <caption>Repair material receipt record</caption>\n      <thead><tr><th scope=\"col\">material</th><th scope=\"col\">quantity</th></tr></thead>\n      <tbody>\n        <tr><th scope=\"row\">canvas</th><td>4</td></tr>\n        <tr><th scope=\"row\">webbing</th><td>6</td></tr>\n      <tr><th scope=\"row\">Total</th><td>10</td></tr></tbody>\n      <tfoot>\n        <tr><th scope=\"row\">Total</th><td>10</td></tr>\n      </tfoot>\n    </table>\n  </main>\n</body>\n</html>\n"
    }
  },
  "html-video-captions": {
    "name": "Mislabeled subtitles used for screen display as metadata",
    "files": {
      "index.html": "<!doctype html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n  <title>Turn on playback controls and subtitles for demo videos</title>\n  <link rel=\"stylesheet\" href=\"style.css\">\n  <script src=\"script.js\" defer></script>\n</head>\n<body>\n  <main class=\"sheet\">\n    <h1>Turn on playback controls and subtitles for demo videos</h1>\n    <video id=\"demo\" width=\"192\" height=\"108\" controls preload=\"metadata\" crossorigin=\"anonymous\">\n      <source src=\"data:video/webm;base64,\" type=\"video/webm\">\n      <track kind=\"metadata\" srclang=\"en\" label=\"English\" default src=\"data:text/vtt;charset=utf-8,WEBVTT%0A%0A00%3A00%3A00.250%20--%3E%2000%3A00%3A01.200%0A%5BShort%20beep%2C%20indicator%20light%20on%5D%0A\">\n      If the browser cannot play the video, read the description below.\n    </video>\n    <p>operation is successful, the device emits a short beep and the indicator light turns green.</p>\n  </main>\n</body>\n</html>\n"
    }
  },
  "html-form-input-types": {
    "name": "Both fields use email type",
    "files": {
      "index.html": "<!doctype html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n  <title>Let the browser check the email and URL format</title>\n  <link rel=\"stylesheet\" href=\"style.css\">\n  <script src=\"script.js\" defer></script>\n</head>\n<body>\n  <main class=\"sheet\">\n    <h1>Let the browser check the email and URL format</h1>\n    <form>\n      <p><label for=\"email\">Contact email</label><br><input id=\"email\" type=\"email\" name=\"email\" required></p>\n      <p><label for=\"work\">work website</label><br><input id=\"work\" type=\"email\" name=\"work\" required></p>\n      <button>Submit</button>\n    </form>\n  </main>\n</body>\n</html>\n"
    }
  },
  "html-number-limits": {
    "name": "only limits the range and forgets the even step size",
    "files": {
      "index.html": "<!doctype html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n  <title>Limit the range and step size of the number of print copies</title>\n  <link rel=\"stylesheet\" href=\"style.css\">\n  <script src=\"script.js\" defer></script>\n</head>\n<body>\n  <main class=\"sheet\">\n    <h1>Limit the range and step size of the number of print copies</h1>\n    <label for=\"copies\">Number of copies to print</label>\n    <input id=\"copies\" name=\"copies\" type=\"number\" min=\"2\" max=\"20\" required>\n  </main>\n</body>\n</html>\n"
    }
  },
  "html-date-limits": {
    "name": "only limits the earliest date",
    "files": {
      "index.html": "<!doctype html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n  <title>Limit the date to the open week</title>\n  <link rel=\"stylesheet\" href=\"style.css\">\n  <script src=\"script.js\" defer></script>\n</head>\n<body>\n  <main class=\"sheet\">\n    <h1>Limit the date to the open week</h1>\n    <label for=\"visit-date\">Estimated visit date</label>\n    <input id=\"visit-date\" name=\"visit-date\" type=\"date\" min=\"2027-06-10\" required>\n    <p>Tours open June 10th through June 14th.</p>\n  </main>\n</body>\n</html>\n"
    }
  },
  "html-autocomplete": {
    "name": "Mark the login password as a new password",
    "files": {
      "index.html": "<!doctype html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n  <title>Declare autofill purpose for login form</title>\n  <link rel=\"stylesheet\" href=\"style.css\">\n  <script src=\"script.js\" defer></script>\n</head>\n<body>\n  <main class=\"sheet\">\n    <h1>Declare autofill purpose for login form</h1>\n    <form>\n      <p><label for=\"account\">account email</label><br><input id=\"account\" name=\"account\" type=\"email\" autocomplete=\"username\"></p>\n      <p><label for=\"password\">current password</label><br><input id=\"password\" name=\"password\" type=\"password\" autocomplete=\"new-password\"></p>\n      <button>Login</button>\n    </form>\n  </main>\n</body>\n</html>\n"
    }
  },
  "html-checkbox-group": {
    "name": "The second option is repeated reading",
    "files": {
      "index.html": "<!doctype html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n  <title>allows visitors to check multiple activities</title>\n  <link rel=\"stylesheet\" href=\"style.css\">\n  <script src=\"script.js\" defer></script>\n</head>\n<body>\n  <main class=\"sheet\">\n    <h1>allows visitors to check multiple activities</h1>\n    <fieldset>\n      <legend>What activities can you participate in?</legend>\n      <label><input id=\"reading\" type=\"checkbox\" name=\"activity\" value=\"reading\"> Read in total</label>\n      <label><input id=\"repair\" type=\"checkbox\" name=\"activity\" value=\"reading\"> Repair Workshop</label>\n    </fieldset>\n  </main>\n</body>\n</html>\n"
    }
  },
  "html-datalist": {
    "name": "Created candidate list, but list points to another ID",
    "files": {
      "index.html": "<!doctype html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n  <title>provides editable suggestions for text input</title>\n  <link rel=\"stylesheet\" href=\"style.css\">\n  <script src=\"script.js\" defer></script>\n</head>\n<body>\n  <main class=\"sheet\">\n    <h1>provides editable suggestions for text input</h1>\n    <label for=\"building-input\">teaching building</label>\n    <input id=\"building-input\" name=\"building\" type=\"text\" list=\"buildings\">\n    <p>You can select the recommended teaching building or enter other locations manually.</p>\n    <datalist id=\"building-options\">\n      <option value=\"Duxing Building\"></option>\n      <option value=\"Mingde Building\"></option>\n      <option value=\"Qiuzhi Building\"></option>\n    </datalist>\n  </main>\n</body>\n</html>\n"
    }
  },
  "html-textarea-description": {
    "name": "Write the description paragraph into aria-label, covering the field name",
    "files": {
      "index.html": "<!doctype html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n  <title>Add length limits and filling tips to multi-line descriptions</title>\n  <link rel=\"stylesheet\" href=\"style.css\">\n  <script src=\"script.js\" defer></script>\n</head>\n<body>\n  <main class=\"sheet\">\n    <h1>Add length limits and filling tips to multi-line descriptions</h1>\n    <form>\n      <label for=\"reason\">Application Instructions</label>\n      <p id=\"reason-guide\">Describe the purpose of borrowing, no more than 120 words.</p>\n      <textarea id=\"reason\" name=\"reason\" rows=\"4\" maxlength=\"120\" aria-label=\"Describe the purpose of borrowing, no more than 120 words.\" required></textarea>\n      <button type=\"submit\">Submit</button>\n    </form>\n  </main>\n</body>\n</html>\n"
    }
  },
  "html-form-get": {
    "name": "mistakenly wrote the q required by the server as the control ID query",
    "files": {
      "index.html": "<!doctype html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n  <title>Configure the request address for the search form</title>\n  <link rel=\"stylesheet\" href=\"style.css\">\n  <script src=\"script.js\" defer></script>\n</head>\n<body>\n  <main class=\"sheet\">\n    <h1>Configure the request address for the search form</h1>\n    <form id=\"catalog-search\" action=\"/catalog\" method=\"get\">\n      <label for=\"query\">collection keyword</label>\n      <input id=\"query\" type=\"search\" name=\"query\">\n      <button type=\"submit\">Query</button>\n    </form>\n  </main>\n</body>\n</html>\n"
    }
  },
  "html-readonly-disabled": {
    "name": "also sets the number that must be submitted to disabled",
    "files": {
      "index.html": "<!doctype html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n  <title>Protect assigned numbers and disabled fields</title>\n  <link rel=\"stylesheet\" href=\"style.css\">\n  <script src=\"script.js\" defer></script>\n</head>\n<body>\n  <main class=\"sheet\">\n    <h1>Protect assigned numbers and disabled fields</h1>\n    <form>\n      <label for=\"record-id\">file number</label>\n      <input id=\"record-id\" name=\"recordId\" value=\"A-031\" disabled>\n      <label for=\"future\">Off-campus remarks</label>\n      <input id=\"future\" name=\"future\" disabled>\n      <button type=\"submit\">Submit</button>\n    </form>\n  </main>\n</body>\n</html>\n"
    }
  },
  "html-button-types": {
    "name": "uses ordinary button type and cannot trigger form reset.",
    "files": {
      "index.html": "<!doctype html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n  <title>Set the restore button to form reset</title>\n  <link rel=\"stylesheet\" href=\"style.css\">\n  <script src=\"script.js\" defer></script>\n</head>\n<body>\n  <main class=\"sheet\">\n    <h1>Set the restore button to form reset</h1>\n    <form>\n      <label for=\"alias\">Exhibition name</label>\n      <input id=\"alias\" name=\"alias\" value=\"Model A\">\n      <button id=\"send\" type=\"submit\">Save</button>\n      <button id=\"restore\" type=\"button\">restore initial name</button>\n    </form>\n  </main>\n</body>\n</html>\n"
    }
  },
  "html-progress-meter": {
    "name": "also writes the fixed range as progress",
    "files": {
      "index.html": "<!doctype html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n  <title>distinguishes current progress and capacity readings</title>\n  <link rel=\"stylesheet\" href=\"style.css\">\n  <script src=\"script.js\" defer></script>\n</head>\n<body>\n  <main class=\"sheet\">\n    <h1>distinguishes current progress and capacity readings</h1>\n    <label for=\"upload\">upload progress</label> <progress id=\"upload\" value=\"6\" max=\"10\">6 / 10</progress>\n    <br>\n    <label for=\"capacity\">storage usage</label> <progress id=\"capacity\" min=\"0\" max=\"100\" value=\"65\">65 / 100</progress>\n  </main>\n</body>\n</html>\n"
    }
  }
