{
  "html-article": {
    "name": "Place the explanatory section outside the article",
    "files": {
      "index.html": "<!doctype html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n  <title>Neighborhood Briefing</title>\n  <link rel=\"stylesheet\" href=\"style.css\">\n  <script src=\"script.js\" defer></script>\n</head>\n<body>\n<main class=\"sheet\">\n  <h1>Neighborhood Briefing</h1>\n  <article id=\"seed-swap\">\n    <h2>Seed Exchange Meeting</h2>\n    <p>On Saturday mornings we exchange seasonal seeds at the community garden.</p>\n  </article>\n  <section id=\"bring\">\n      <h3>What should you bring?</h3>\n      <p>Bring a bag of seeds and write the variety on the bag.</p>\n  </section>\n</main>\n</body>\n</html>\n"
    }
  },
  "html-code": {
    "name": "Only using inline code causes indentation and folding",
    "files": {
      "index.html": "<!doctype html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n  <title>display code example</title>\n  <link rel=\"stylesheet\" href=\"style.css\">\n  <script src=\"script.js\" defer></script>\n</head>\n<body>\n<main class=\"sheet\">\n  <h1>display code example</h1>\n  <div id=\"sample\">\n    <code>if (count &lt; 3) {\n  console.log(count);\n}</code>\n  </div>\n</main>\n</body>\n</html>\n"
    }
  },
  "html-form": {
    "name": "Use field names to connect labels, but the label cannot reach the text box.",
    "files": {
      "index.html": "<!doctype html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n  <title>registration form</title>\n  <link rel=\"stylesheet\" href=\"style.css\">\n  <script src=\"script.js\" defer></script>\n</head>\n<body>\n  <main class=\"sheet\">\n    <h1>practical training registration</h1>\n    <form>\n      <label for=\"student\">Name</label>\n      <input type=\"text\" id=\"student-name\" name=\"student\" required>\n      <button type=\"submit\">Submit registration</button>\n    </form>\n  </main>\n</body>\n</html>\n"
    }
  },
  "html-form-choice": {
    "name": "used a different name for the afternoon session",
    "files": {
      "index.html": "<!doctype html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n  <title>Woodworking workshop sign-in</title>\n  <link rel=\"stylesheet\" href=\"style.css\">\n  <script src=\"script.js\" defer></script>\n</head>\n<body>\n<main class=\"sheet\">\n  <h1>Woodworking workshop sign-in</h1>\n  <form>\n    <fieldset>\n      <legend>arrival time</legend>\n      <label><input type=\"radio\" name=\"slot\" value=\"morning\">Morning (09:00)</label>\n      <label><input type=\"radio\" name=\"afternoon\" value=\"afternoon\">Afternoon (14:00)</label>\n    </fieldset>\n  </form>\n</main>\n</body>\n</html>\n"
    }
  },
  "html-form-select": {
    "name": "omission of writing selected causes the carpentry bench to be displayed by default",
    "files": {
      "index.html": "<!doctype html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n  <title>Maintenance Corner Appointment</title>\n  <link rel=\"stylesheet\" href=\"style.css\">\n  <script src=\"script.js\" defer></script>\n</head>\n<body>\n<main class=\"sheet\">\n  <h1>Maintenance Corner Appointment</h1>\n  <form>\n    <label for=\"bench\">maintenance station</label>\n    <select id=\"bench\" name=\"bench\">\n      <option value=\"wood\">woodworking bench</option>\n      <option value=\"electronics\">electronic station</option>\n      <option value=\"bike\">bicycle platform</option>\n    </select>\n  </form>\n</main>\n</body>\n</html>\n"
    }
  },
  "html-form-validation": {
    "name": "Write a four-digit number that accepts three to four digits",
    "files": {
      "index.html": "<!doctype html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n  <title>Self-service pickup</title>\n  <link rel=\"stylesheet\" href=\"style.css\">\n  <script src=\"script.js\" defer></script>\n</head>\n<body>\n<main class=\"sheet\">\n  <h1>Self-service pickup</h1>\n  <form>\n    <label for=\"pickup-code\">pickup code</label>\n    <input type=\"text\" id=\"pickup-code\" name=\"pickup\" required pattern=\"[A-Z]{2}[0-9]{3,4}\">\n    <p>pickup code consists of two uppercase English letters and four digits, such as AB0427.</p>\n    <button type=\"submit\">Check</button>\n  </form>\n</main>\n</body>\n</html>\n"
    }
  },
  "html-details": {
    "name": "Using open=\"false\" causes the collapsed item to be initially expanded",
    "files": {
      "index.html": "<!doctype html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n  <title>Reading Room Q&A</title>\n  <link rel=\"stylesheet\" href=\"style.css\">\n  <script src=\"script.js\" defer></script>\n</head>\n<body>\n<main class=\"sheet\">\n  <h1>Reading Room Q&A</h1>\n  <details id=\"renew\" open=\"false\">\n    <summary>How to extend the loan?</summary>\n    <p>Go to the service desk to renew once before expiration.</p>\n  </details>\n</main>\n</body>\n</html>\n"
    }
  }
}
