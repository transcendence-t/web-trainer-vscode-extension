{
  "html-document": {
    "name": "Write title into the text",
    "files": {
      "index.html": "<!doctype html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"utf-8\">\n  <link rel=\"stylesheet\" href=\"style.css\">\n</head>\n<body>\n  <main class=\"sheet\">\n    <title>Community Book Corner</title>\n    <p>Open Saturday afternoon.</p>\n  </main>\n</body>\n</html>"
    }
  },
  "html-heading": {
    "name": "Write the introductory paragraph before the main title",
    "files": {
      "index.html": "<!doctype html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n  <title>Title and Paragraph</title>\n  <link rel=\"stylesheet\" href=\"style.css\">\n  <script src=\"script.js\" defer></script>\n</head>\n<body>\n  <main class=\"sheet\">\n    <p>I am learning web design.</p>\n    <h1>My first webpage</h1>\n  </main>\n</body>\n</html>\n"
    }
  },
  "html-emphasis": {
    "name": "only uses b and i to change the glyph",
    "files": {
      "index.html": "<!doctype html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n  <title>Equipment Inspection Instructions</title>\n  <link rel=\"stylesheet\" href=\"style.css\">\n  <script src=\"script.js\" defer></script>\n</head>\n<body>\n<main class=\"sheet\">\n  <h1>Equipment Inspection Instructions</h1>\n  <p id=\"power-note\">Before repairing, be sure to<b>cut off the power</b>。</p>\n  <p id=\"cover-note\">Please download from<i>front</i>Open the cover.</p>\n</main>\n</body>\n</html>\n"
    }
  },
  "html-line-break": {
    "name": "Put the line break after the room number",
    "files": {
      "index.html": "<!doctype html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n  <title>Design agency contact address</title>\n  <link rel=\"stylesheet\" href=\"style.css\">\n  <script src=\"script.js\" defer></script>\n</head>\n<body>\n<main class=\"sheet\">\n  <h1>Design agency contact address</h1>\n  <address id=\"club-address\">\n    <span>No. 16 Daxue Road</span>\n    <span>Training Building</span><br>\n  </address>\n</main>\n</body>\n</html>\n"
    }
  },
  "html-entities": {
    "name": "escapes tags, copyright character references are still parsed",
    "files": {
      "index.html": "<!doctype html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n  <title>Copyright code quick check</title>\n  <link rel=\"stylesheet\" href=\"style.css\">\n  <script src=\"script.js\" defer></script>\n</head>\n<body>\n<main class=\"sheet\">\n  <h1>Copyright code quick check</h1>\n  <p>Copyright code for footer <code id=\"copyright-code\">&lt;p&gt;&copy;&lt;/p&gt;</code></p>\n</main>\n</body>\n</html>\n"
    }
  },
  "html-list": {
    "name": "combines mouse and monitor into one",
    "files": {
      "index.html": "<!doctype html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n  <title>three equipment lists</title>\n  <link rel=\"stylesheet\" href=\"style.css\">\n  <script src=\"script.js\" defer></script>\n</head>\n<body>\n  <main class=\"sheet\">\n    <h1>training room equipment</h1>\n    <ul id=\"equipment\">\n      <li>keyboard</li>\n      <li>mouse, monitor</li>\n    </ul>\n  </main>\n</body>\n</html>\n"
    }
  },
  "html-ordered-list": {
    "name": "Lock the bike before parking it",
    "files": {
      "index.html": "<!doctype html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n  <title>Shared bicycle return</title>\n  <link rel=\"stylesheet\" href=\"style.css\">\n  <script src=\"script.js\" defer></script>\n</head>\n<body>\n<main class=\"sheet\">\n  <h1>Shared bicycle return</h1>\n  <ol>\n    <li>Find the return point</li>\n    <li>Lock the car and confirm the return</li>\n    <li>Park the bicycle into the empty space</li>\n  </ol>\n</main>\n</body>\n</html>\n"
    }
  }
}
