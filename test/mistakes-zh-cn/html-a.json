{
  "html-document": {
    "name": "把 title 写进正文",
    "files": {
      "index.html": "<!doctype html>\n<html lang=\"zh-CN\">\n<head>\n  <meta charset=\"utf-8\">\n  <link rel=\"stylesheet\" href=\"style.css\">\n</head>\n<body>\n  <main class=\"sheet\">\n    <title>社区图书角</title>\n    <p>周六下午开放。</p>\n  </main>\n</body>\n</html>"
    }
  },
  "html-heading": {
    "name": "把介绍段落写在主标题前面",
    "files": {
      "index.html": "<!doctype html>\n<html lang=\"zh-CN\">\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n  <title>标题与段落</title>\n  <link rel=\"stylesheet\" href=\"style.css\">\n  <script src=\"script.js\" defer></script>\n</head>\n<body>\n  <main class=\"sheet\">\n    <p>我正在学习网页设计。</p>\n    <h1>我的第一张网页</h1>\n  </main>\n</body>\n</html>\n"
    }
  },
  "html-emphasis": {
    "name": "只用 b 和 i 改变字形",
    "files": {
      "index.html": "<!doctype html>\n<html lang=\"zh-CN\">\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n  <title>设备检查须知</title>\n  <link rel=\"stylesheet\" href=\"style.css\">\n  <script src=\"script.js\" defer></script>\n</head>\n<body>\n<main class=\"sheet\">\n  <h1>设备检查须知</h1>\n  <p id=\"power-note\">维修前务必<b>切断电源</b>。</p>\n  <p id=\"cover-note\">请从<i>正面</i>打开盖板。</p>\n</main>\n</body>\n</html>\n"
    }
  },
  "html-line-break": {
    "name": "把换行放在房间号后面",
    "files": {
      "index.html": "<!doctype html>\n<html lang=\"zh-CN\">\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n  <title>设计社联系地址</title>\n  <link rel=\"stylesheet\" href=\"style.css\">\n  <script src=\"script.js\" defer></script>\n</head>\n<body>\n<main class=\"sheet\">\n  <h1>设计社联系地址</h1>\n  <address id=\"club-address\">\n    <span>大学路 16 号</span>\n    <span>实训楼 B 座 204 室</span><br>\n  </address>\n</main>\n</body>\n</html>\n"
    }
  },
  "html-entities": {
    "name": "转义了标签，版权字符引用仍被解析",
    "files": {
      "index.html": "<!doctype html>\n<html lang=\"zh-CN\">\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n  <title>版权代码速查</title>\n  <link rel=\"stylesheet\" href=\"style.css\">\n  <script src=\"script.js\" defer></script>\n</head>\n<body>\n<main class=\"sheet\">\n  <h1>版权代码速查</h1>\n  <p>页脚的版权代码 <code id=\"copyright-code\">&lt;p&gt;&copy;&lt;/p&gt;</code></p>\n</main>\n</body>\n</html>\n"
    }
  },
  "html-list": {
    "name": "把鼠标和显示器合成一项",
    "files": {
      "index.html": "<!doctype html>\n<html lang=\"zh-CN\">\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n  <title>三项设备清单</title>\n  <link rel=\"stylesheet\" href=\"style.css\">\n  <script src=\"script.js\" defer></script>\n</head>\n<body>\n  <main class=\"sheet\">\n    <h1>实训室设备</h1>\n    <ul id=\"equipment\">\n      <li>键盘</li>\n      <li>鼠标、显示器</li>\n    </ul>\n  </main>\n</body>\n</html>\n"
    }
  },
  "html-ordered-list": {
    "name": "停好单车之前就锁车",
    "files": {
      "index.html": "<!doctype html>\n<html lang=\"zh-CN\">\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n  <title>共享单车归还</title>\n  <link rel=\"stylesheet\" href=\"style.css\">\n  <script src=\"script.js\" defer></script>\n</head>\n<body>\n<main class=\"sheet\">\n  <h1>共享单车归还</h1>\n  <ol>\n    <li>找到还车点</li>\n    <li>锁车并确认归还</li>\n    <li>把单车停进空位</li>\n  </ol>\n</main>\n</body>\n</html>\n"
    }
  }
}
