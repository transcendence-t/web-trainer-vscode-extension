      "index.html": "<!doctype html>\n<html lang=\"zh-CN\">\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n  <title>把恢复按钮设为表单重置</title>\n  <link rel=\"stylesheet\" href=\"style.css\">\n  <script src=\"script.js\" defer></script>\n</head>\n<body>\n  <main class=\"sheet\">\n    <h1>把恢复按钮设为表单重置</h1>\n    <form>\n      <label for=\"alias\">展签名称</label>\n      <input id=\"alias\" name=\"alias\" value=\"模型 A\">\n      <button id=\"send\" type=\"submit\">保存</button>\n      <button id=\"restore\" type=\"button\">恢复初始名称</button>\n    </form>\n  </main>\n</body>\n</html>\n"
    }
  },
  "html-progress-meter": {
    "name": "把固定量程也写成 progress",
    "files": {
      "index.html": "<!doctype html>\n<html lang=\"zh-CN\">\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n  <title>区分当前进度与容量读数</title>\n  <link rel=\"stylesheet\" href=\"style.css\">\n  <script src=\"script.js\" defer></script>\n</head>\n<body>\n  <main class=\"sheet\">\n    <h1>区分当前进度与容量读数</h1>\n    <label for=\"upload\">上传进度</label> <progress id=\"upload\" value=\"6\" max=\"10\">6 / 10</progress>\n    <br>\n    <label for=\"capacity\">存储使用量</label> <progress id=\"capacity\" min=\"0\" max=\"100\" value=\"65\">65 / 100</progress>\n  </main>\n</body>\n</html>\n"
    }
  }
